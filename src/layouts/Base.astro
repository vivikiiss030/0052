---
import '../styles/global.css';

const { title, description = 'Tarot readings with Vicky', wide = false, bare = false, sheen = false, lang = 'en', nofoot = false, alt = '/' } = Astro.props;
// alt：这一页在两种语言下的路径（不带 /zh 前缀），用来写 hreflang
const altZh = alt === '/' ? '/zh/' : `/zh${alt}`;
const site = 'The Open Space';
const pageTitle = title ?? `${site} · 自留地`;
const path = Astro.url.pathname;

// 和首页那一排用同一套名字 —— 里页和首页不该是两个网站
const nav = [
  { href: '/volumes/', cjk: '如梦似幻' },
  { href: '/essays/', cjk: '头脑的温水' },
  { href: '/poems/', cjk: '情诗' },
  { href: '/about/', cjk: '我由什么组成' },
];
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-Hans' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="alternate" hreflang="en" href={alt} />
    <link rel="alternate" hreflang="zh-Hans" href={altZh} />

    <!-- 从首页点塔罗牌进来时，内容页要接着那个「满屏丝缎」的画面往下走（见 Page.astro） -->
    <script is:inline>
      try {
        if (sessionStorage.getItem('portal')) {
          document.documentElement.classList.add('portal-enter');
          sessionStorage.removeItem('portal');
        }
      } catch (e) {}
    </script>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#efeae1" />

    <!-- 分享预览：链接发到 IG / WhatsApp / iMessage 等时显示的小卡片。
         图是首页首屏截的（public/og.jpg，1200×630）。
         网址写在 astro.config.mjs 的 site 里 —— 以后换网址，改那一处就行 -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="The Open Space 自留地" />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_GB'} />
    <meta property="og:url" content={new URL(path, Astro.site)} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/og.jpg', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The Open Space 自留地 — tarot with Vicky" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL('/og.jpg', Astro.site)} />

  </head>

  <body>
    {
      !bare && (
        <header class="wrap site-head">
          <a href="/" class="mark" aria-label="00:52 首页">
            00:52
          </a>
          <nav aria-label="主导航">
            {nav.map((item) => (
              <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                {item.cjk}
              </a>
            ))}
          </nav>
        </header>
      )
    }

    {sheen && <canvas id="glint" aria-hidden="true" />}
    {sheen && <div id="wand" aria-hidden="true"><img src="/wand.png" alt="" width="28" /></div>}

    <main class={wide ? '' : 'wrap'}>
      <slot />
    </main>

    {!nofoot && (
    <footer class="wrap site-foot">
      <hr class="rule" />
      <div class="foot-row">
        <span class="label">The Open Space &nbsp;/&nbsp; 自留地</span>
        <span class="label">Vicky &nbsp;/&nbsp; 2026</span>
      </div>
    </footer>
    )}

    <script>
      // 星屑。桌面端是魔杖式的拖尾：鼠标走过的路上密密地落下两种东西 ——
      // 细碎的尘（多、小、暗），和四角星芒（少、大、亮）。
      // 它们都继承一点鼠标当时的速度，然后减速、微微下沉、亮起来再灭掉。
      //
      // 手机上没有鼠标，也就没有「走过的路」。那儿换一种活法：
      // 拼贴元素自己会时不时闪一下，点一下屏幕也会炸开一小簇。
      // 这样「亮闪闪」这件事在两端是同一件事，只是触发方式不同。
      //
      // 星星画在一张离屏小图上预先渲染好，每帧只是把它贴过来，
      // 所以几百颗同时在也不卡 —— 如果每颗都现画渐变，手机会喘不过气。
      // ── 鼠标换成一根塔罗权杖（只在有鼠标的设备上）──
      // 权杖的尖（顶端那颗木疙瘩）就是指针的位置；点一下，权杖往下一点，
      // 同时从尖上撒出几片小叶子（叶子是从同一张权杖牌上剪下来的）。
      {
        const wand = document.getElementById('wand');
        const hasMouse = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
        const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (wand && hasMouse) {
          document.documentElement.classList.add('has-wand');
          const TIP_X = 14.8, TIP_Y = 9.5;   // 权杖尖在图里的位置（显示尺寸 28px 宽）
          let shown = false;
          addEventListener('pointermove', (e) => {
            if (e.pointerType !== 'mouse') return;
            wand.style.transform = `translate(${e.clientX - TIP_X}px, ${e.clientY - TIP_Y}px)`;
            if (!shown) { wand.classList.add('is-on'); shown = true; }
          }, { passive: true });
          document.addEventListener('pointerleave', () => { wand.classList.remove('is-on'); shown = false; });
          addEventListener('blur', () => { wand.classList.remove('is-on'); shown = false; });
          addEventListener('pointerdown', (e) => {
            if (e.pointerType !== 'mouse') return;
            wand.classList.remove('is-tap'); void wand.offsetWidth; wand.classList.add('is-tap');
          });
          addEventListener('pointerup', () => setTimeout(() => wand.classList.remove('is-tap'), 140));
        }
        // 叶子：鼠标点、手指点都会撒
        if (!calm) {
          addEventListener('pointerdown', (e) => {
            for (let i = 0; i < 5; i++) {
              const leaf = document.createElement('img');
              leaf.src = '/leaf.png';
              leaf.className = 'wand-leaf';
              leaf.alt = '';
              leaf.style.left = `${e.clientX}px`;
              leaf.style.top = `${e.clientY}px`;
              document.body.appendChild(leaf);
              const a = -Math.PI / 2 + (Math.random() - 0.5) * Math.PI * 1.3;
              const d = 26 + Math.random() * 34;
              const r0 = Math.random() * 360, r1 = r0 + (Math.random() - 0.5) * 220;
              const sc = 0.55 + Math.random() * 0.4;
              leaf.animate([
                { transform: `translate(-50%, -50%) rotate(${r0}deg) scale(${sc * 0.4})`, opacity: 0 },
                { transform: `translate(calc(-50% + ${Math.cos(a) * d * 0.7}px), calc(-50% + ${Math.sin(a) * d * 0.7}px)) rotate(${(r0 + r1) / 2}deg) scale(${sc})`, opacity: 1, offset: 0.35 },
                { transform: `translate(calc(-50% + ${Math.cos(a) * d}px), calc(-50% + ${Math.sin(a) * d + 26}px)) rotate(${r1}deg) scale(${sc * 0.8})`, opacity: 0 },
              ], { duration: 700 + Math.random() * 300, easing: 'cubic-bezier(0.2, 0.7, 0.3, 1)' }).onfinish = () => leaf.remove();
            }
          }, { passive: true });
        }
      }

      const canvas = document.getElementById('glint');
      const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (canvas && !still) {
        const ctx = canvas.getContext('2d');
        let w = 0;
        let h = 0;

        const resize = () => {
          w = window.innerWidth;
          h = window.innerHeight;
          const dpr = Math.min(window.devicePixelRatio || 1, 2);
          canvas.width = Math.floor(w * dpr);
          canvas.height = Math.floor(h * dpr);
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        };
        resize();
        window.addEventListener('resize', resize);

        // ── 预渲染的两枚图章 ────────────────────────────
        const S = 96;

        const makeStar = (r1, g1, b1) => {
          const c = document.createElement('canvas');
          c.width = c.height = S;
          const g = c.getContext('2d');
          g.translate(S / 2, S / 2);
          const R = S / 2 - 2;

          const halo = g.createRadialGradient(0, 0, 0, 0, 0, R);
          halo.addColorStop(0, `rgba(${r1}, ${g1}, ${b1}, 0.55)`);
          halo.addColorStop(0.32, `rgba(${r1}, ${g1}, ${b1}, 0.14)`);
          halo.addColorStop(1, `rgba(${r1}, ${g1}, ${b1}, 0)`);
          g.fillStyle = halo;
          g.beginPath();
          g.arc(0, 0, R, 0, Math.PI * 2);
          g.fill();

          // 四角芒：贝塞尔的控制点放在中心，曲线就往中间收，收出尖
          const spike = (len, aspect) => {
            g.beginPath();
            g.moveTo(0, -len);
            g.quadraticCurveTo(0, 0, len * aspect, 0);
            g.quadraticCurveTo(0, 0, 0, len);
            g.quadraticCurveTo(0, 0, -len * aspect, 0);
            g.quadraticCurveTo(0, 0, 0, -len);
            g.closePath();
            g.fill();
          };

          const core = g.createRadialGradient(0, 0, 0, 0, 0, R);
          core.addColorStop(0, 'rgba(255, 255, 253, 1)');
          core.addColorStop(0.3, `rgba(${r1}, ${g1}, ${b1}, 0.92)`);
          core.addColorStop(1, `rgba(${r1}, ${g1}, ${b1}, 0)`);
          g.fillStyle = core;
          spike(R, 0.1);
          g.rotate(Math.PI / 4);
          g.globalAlpha = 0.5;
          spike(R * 0.52, 0.13);
          return c;
        };

        const makeDust = (r1, g1, b1) => {
          const c = document.createElement('canvas');
          c.width = c.height = 32;
          const g = c.getContext('2d');
          const grd = g.createRadialGradient(16, 16, 0, 16, 16, 15);
          grd.addColorStop(0, `rgba(255, 255, 252, 1)`);
          grd.addColorStop(0.35, `rgba(${r1}, ${g1}, ${b1}, 0.7)`);
          grd.addColorStop(1, `rgba(${r1}, ${g1}, ${b1}, 0)`);
          g.fillStyle = grd;
          g.beginPath();
          g.arc(16, 16, 15, 0, Math.PI * 2);
          g.fill();
          return c;
        };

        // 冷（近白）和暖（香槟金）各一套，随机取，画面才不会是一个颜色
        const STAR_COOL = makeStar(255, 250, 240);
        const STAR_WARM = makeStar(255, 226, 168);
        const DUST_COOL = makeDust(255, 248, 236);
        const DUST_WARM = makeDust(255, 224, 170);

        // ── 状态 ────────────────────────────────────────
        let mx = -999, my = -999;
        let gx = -999, gy = -999;   // 光点，稍微滞后，拖尾就是从这个滞后来的
        let moved = false;
        let idle = 999;
        let acc = 0;                // 走了多远（用来定间隔）
        let accStar = 0;
        let accPush = 0;

        const bits = [];
        const MAX_BITS = 560;

        const spawn = (x, y, vx, vy, star) => {
          if (bits.length >= MAX_BITS) bits.shift();
          const warm = Math.random() < 0.55;
          bits.push({
            x, y, vx, vy,
            star,
            warm,
            r: star ? 4.2 + Math.random() * 5.4 : 1.7 + Math.random() * 2.3,
            t: 0,
            span: star ? 0.13 + Math.random() * 0.12 : 0.1 + Math.random() * 0.1,
            rot: Math.random() * Math.PI,
            spin: (Math.random() - 0.5) * 1.6,
          });
        };

        if (fine) {
          window.addEventListener(
            'pointermove',
            (e) => {
              mx = e.clientX;
              my = e.clientY;
              if (!moved) { gx = mx; gy = my; moved = true; }
              idle = 0;
            },
            { passive: true }
          );
          window.addEventListener('pointerleave', () => { idle = 999; }, { passive: true });
        }

        // 点一下 / 戳一下，炸开一小簇（触屏上这是主要的互动）
        window.addEventListener(
          'pointerdown',
          (e) => {
            for (let i = 0; i < 16; i++) {
              const a = Math.random() * Math.PI * 2;
              const v = 40 + Math.random() * 190;
              spawn(e.clientX, e.clientY, Math.cos(a) * v, Math.sin(a) * v, i < 5);
            }
          },
          { passive: true }
        );

        // 鼠标拖尾整页都有（下拉页上也有）。
        // 只有手机上「拼贴自己闪一下」这件事跟着第一屏走：滑过第一屏就不再闪，
        // 不然星星会从绿色面板后面的拼贴位置冒出来。
        const heroEl = document.querySelector('.hero');
        const vis = 1;
        let heroVis = 1;
        const zone = () => {
          const H = heroEl ? heroEl.offsetHeight : h;
          const a0 = H * 0.3;
          const a1 = H * 0.7;
          const y = window.scrollY;
          heroVis = y <= a0 ? 1 : y >= a1 ? 0 : 1 - (y - a0) / (a1 - a0);
        };
        zone();
        window.addEventListener('scroll', zone, { passive: true });

        // ── 手机端的自发闪光 ────────────────────────────
        // 随机挑一个还在画面上的拼贴元素，在它身上点一颗星。
        const pieces = [...document.querySelectorAll('.stage .el, .stage .mark')];
        let sparkIn = 0.9;

        const ambient = () => {
          const live = pieces.filter((el) => {
            const r = el.getBoundingClientRect();
            return r.width > 8 && r.bottom > 0 && r.top < h * 0.92;
          });
          if (!live.length) return;
          const el = live[(Math.random() * live.length) | 0];
          const r = el.getBoundingClientRect();
          // 落在这个元素的范围里，偏边缘一点 —— 像边上反了一下光
          const ex = r.left + r.width * (0.12 + Math.random() * 0.76);
          const ey = r.top + r.height * (0.12 + Math.random() * 0.76);
          spawn(ex, ey, (Math.random() - 0.5) * 12, -6 - Math.random() * 10, true);
          if (Math.random() < 0.6) {
            spawn(ex + (Math.random() - 0.5) * 26, ey + (Math.random() - 0.5) * 26,
              (Math.random() - 0.5) * 16, -4, false);
          }
        };

        let last = performance.now();

        const frame = (now) => {
          const dt = Math.min((now - last) / 1000, 0.05);
          last = now;
          zone();
          ctx.clearRect(0, 0, w, h);

          // 已经离开第一屏、且屏幕上一颗都不剩：什么都不用画
          if (vis <= 0.002 && bits.length === 0) { requestAnimationFrame(frame); return; }

          if (!fine && heroVis > 0.05) {
            sparkIn -= dt;
            if (sparkIn <= 0) {
              sparkIn = 0.5 + Math.random() * 0.8;   // 大约每半秒到一秒三闪一下
              ambient();
            }
          }

          if (moved) {
            const px = gx, py = gy;
            const k = 1 - Math.pow(0.00001, dt);   // 光点几乎贴着鼠标走，尾巴短而快
            gx += (mx - gx) * k;
            gy += (my - gy) * k;

            const dx = gx - px, dy = gy - py;
            const step = Math.hypot(dx, dy);
            const speed = step / Math.max(dt, 0.001);
            idle += dt;

            // 正在淡出的时候只让旧的演完，不再落新的
            if (idle < 0.22 && vis > 0.05) {
              const ux = step > 0.01 ? dx / step : 0;
              const uy = step > 0.01 ? dy / step : 0;
              const carry = Math.min(speed, 950) * 0.05;  // 继承一点鼠标的速度（越小尾巴越收）

              // 关键：星屑不是全都落在「鼠标现在这一点」，而是**沿着这一帧走过的
              // 那一小段路均匀铺开**。不然鼠标快的时候每帧一簇，尾巴会变成一串珠子；
              // 铺开之后才是一条连续的细线。
              const DUST = 2.2;   // 每 2.2px 一颗碎尘
              const STAR = 9;     // 每 9px 一颗星芒

              let need = DUST - acc;
              while (need <= step) {
                const f = need / step;
                const ex = px + dx * f;
                const ey = py + dy * f;
                const sp = (Math.random() - 0.5) * 24;
                spawn(
                  ex + (Math.random() - 0.5) * 10,
                  ey + (Math.random() - 0.5) * 10,
                  ux * carry * (0.3 + Math.random() * 0.7) - uy * sp,
                  uy * carry * (0.3 + Math.random() * 0.7) + ux * sp,
                  false
                );
                need += DUST;
              }
              acc = step - (need - DUST);

              need = STAR - accStar;
              while (need <= step) {
                const f = need / step;
                const ex = px + dx * f;
                const ey = py + dy * f;
                const sp = (Math.random() - 0.5) * 18;
                spawn(
                  ex + (Math.random() - 0.5) * 13,
                  ey + (Math.random() - 0.5) * 13,
                  ux * carry * 0.5 - uy * sp,
                  uy * carry * 0.5 + ux * sp,
                  true
                );
                need += STAR;
              }
              accStar = step - (need - STAR);

              // 拼贴元素还是会被鼠标经过时轻轻带一下（首页在听这个事件）
              accPush += step;
              while (accPush > 30) {
                accPush -= 30;
                window.dispatchEvent(
                  new CustomEvent('sheen:ripple', {
                    detail: { x: gx, y: gy, reach: 52, life: 1.0 },
                  })
                );
              }
            }
          }

          // ── 画 ────────────────────────────────────────
          for (let i = bits.length - 1; i >= 0; i--) {
            const b = bits[i];
            b.t += dt;
            const p = b.t / b.span;
            if (p >= 1) { bits.splice(i, 1); continue; }

            b.x += b.vx * dt;
            b.y += b.vy * dt + (b.star ? 7 : 13) * dt;   // 一点点重力，像星屑在沉
            b.vx *= Math.pow(0.055, dt);
            b.vy *= Math.pow(0.055, dt);
            b.rot += b.spin * dt;

            // 先涨后落：亮得快，灭得慢
            const pulse = Math.sin(Math.PI * Math.pow(p, 0.7));
            const a = Math.pow(pulse, b.star ? 1.2 : 1.5) * (b.star ? 0.72 : 0.5) * vis;
            if (a < 0.01) continue;

            const img = b.star
              ? (b.warm ? STAR_WARM : STAR_COOL)
              : (b.warm ? DUST_WARM : DUST_COOL);
            const size = b.r * (b.star ? 1.6 + pulse * 1.6 : 2.3);

            ctx.globalAlpha = a;
            if (b.star) {
              ctx.save();
              ctx.translate(b.x, b.y);
              ctx.rotate(b.rot);
              ctx.drawImage(img, -size, -size, size * 2, size * 2);
              ctx.restore();
            } else {
              ctx.drawImage(img, b.x - size, b.y - size, size * 2, size * 2);
            }
          }
          ctx.globalAlpha = 1;

          requestAnimationFrame(frame);
        };
        requestAnimationFrame(frame);
      }
    </script>

    <style>
      #glint {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: 40;
        pointer-events: none;
        opacity: 1;
      }



      @media (prefers-reduced-motion: reduce) {
        #glint { display: none; }
      }

      /* 权杖鼠标：系统指针藏起来，换成这根权杖 */
      :global(html.has-wand), :global(html.has-wand *) { cursor: none !important; }
      #wand {
        position: fixed;
        left: 0;
        top: 0;
        z-index: 10000;
        width: 28px;
        pointer-events: none;
        opacity: 0;
        will-change: transform;
        transition: opacity 0.2s;
      }
      #wand.is-on { opacity: 1; }
      #wand img {
        display: block;
        width: 28px;
        height: auto;
        transform-origin: 14.8px 9.5px;
        transform: rotate(-34deg);
        filter: drop-shadow(1px 2px 1.5px rgba(60, 30, 20, 0.35));
        transition: transform 0.18s cubic-bezier(0.3, 1.6, 0.5, 1);
      }
      /* 点一下：权杖往前点一下 */
      #wand.is-tap img { transform: rotate(-14deg) scale(0.92); transition-duration: 0.08s; }
      :global(.wand-leaf) {
        position: fixed;
        z-index: 9999;
        width: 14px;
        height: auto;
        pointer-events: none;
      }

      .site-head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 24px;
        padding-top: 28px;
        padding-bottom: 28px;
      }

      .mark {
        font-family: var(--display);
        font-size: 22px;
        font-weight: 400;
        letter-spacing: 0.02em;
      }

      .site-head nav {
        display: flex;
        gap: 32px;
      }

      .site-head nav a {
        font-family: var(--cjk);
        font-size: clamp(13px, 1.05vw, 15px);
        letter-spacing: 0.14em;
        color: var(--ink-soft);
        padding-block: 12px;
      }

      .site-head nav a:hover,
      .site-head nav a[aria-current='page'] {
        color: var(--ink);
      }

      .site-foot {
        position: relative;
        z-index: 5;
        background: var(--ground);
        margin-top: 64px;
        padding-bottom: 72px;
      }

      .foot-link {
        border-bottom: 1px solid transparent;
        padding-bottom: 3px;
        transition: color 0.3s, border-color 0.3s;
      }

      .foot-link:hover {
        color: var(--accent);
        border-bottom-color: var(--accent);
      }

      /* 左下角固定着日月徽章（约 130px 宽），页脚的字从它右边开始，不被压住 */
      .foot-row {
        display: flex;
        justify-content: space-between;
        padding-top: 20px;
        padding-left: max(0px, calc(150px - var(--gutter)));
      }

      @media (max-width: 720px) {
        /* 手机上两行都靠右叠起来，徽章占左下角，互不打扰 */
        .site-foot {
          margin-top: 24px;
          padding-bottom: calc(40px + env(safe-area-inset-bottom, 0px));
        }
        .foot-row {
