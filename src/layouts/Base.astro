---
import '../styles/global.css';

const { title, description = '影像与文字的存档', wide = false, bare = false, sheen = false } = Astro.props;
const site = '00:52';
const pageTitle = title ? `${title} — ${site}` : `${site} · night istill young`;
const path = Astro.url.pathname;

const nav = [
  { href: '/volumes/', cjk: '辑', en: 'Volumes' },
  { href: '/essays/', cjk: '文', en: 'Essays' },
  { href: '/poems/', cjk: '诗', en: 'Poems' },
  { href: '/about/', cjk: '我', en: 'About' },
];
---

<!doctype html>
<html lang="zh-Hans">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="alternate" type="application/rss+xml" title={site} href="/rss.xml" />
  </head>

  <body>
    {
      !bare && (
        <header class="wrap site-head">
          <a href="/" class="mark" aria-label="00:52 首页">
            00:52
          </a>
          <nav aria-label="主导航">
            {nav.map((item) => (
              <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                <span class="cjk">{item.cjk}</span>
                <span class="en">{item.en}</span>
              </a>
            ))}
          </nav>
        </header>
      )
    }

    {sheen && <canvas id="glint" aria-hidden="true" />}

    <main class={wide ? '' : 'wrap'}>
      <slot />
    </main>

    <footer class="wrap site-foot">
      <hr class="rule" />
      <div class="foot-row">
        <a href="/0052/" class="label foot-link">night istill young</a>
        <span class="label">V. &nbsp;/&nbsp; 2026</span>
      </div>
    </footer>

    <script>
      // 鼠标拖尾：魔杖式的星屑。鼠标走过的路上密密地落下两种东西 ——
      // 细碎的尘（多、小、暗），和四角星芒（少、大、亮）。
      // 它们都继承一点鼠标当时的速度，然后减速、微微下沉、亮起来再灭掉。
      //
      // 星星画在一张离屏小图上预先渲染好，每帧只是把它贴过来，
      // 所以几百颗同时在也不卡 —— 如果每颗都现画渐变，手机会喘不过气。
      const canvas = document.getElementById('glint');
      const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (canvas && fine && !still) {
        const ctx = canvas.getContext('2d');
        let w = 0;
        let h = 0;

        const resize = () => {
          w = window.innerWidth;
          h = window.innerHeight;
          const dpr = Math.min(window.devicePixelRatio || 1, 2);
          canvas.width = Math.floor(w * dpr);
          canvas.height = Math.floor(h * dpr);
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        };
        resize();
        window.addEventListener('resize', resize);

        // ── 预渲染的两枚图章 ────────────────────────────
        const S = 96;

        const makeStar = (r1, g1, b1) => {
          const c = document.createElement('canvas');
          c.width = c.height = S;
          const g = c.getContext('2d');
          g.translate(S / 2, S / 2);
          const R = S / 2 - 2;

          const halo = g.createRadialGradient(0, 0, 0, 0, 0, R);
          halo.addColorStop(0, `rgba(${r1}, ${g1}, ${b1}, 0.55)`);
          halo.addColorStop(0.32, `rgba(${r1}, ${g1}, ${b1}, 0.14)`);
          halo.addColorStop(1, `rgba(${r1}, ${g1}, ${b1}, 0)`);
          g.fillStyle = halo;
          g.beginPath();
          g.arc(0, 0, R, 0, Math.PI * 2);
          g.fill();

          // 四角芒：贝塞尔的控制点放在中心，曲线就往中间收，收出尖
          const spike = (len, aspect) => {
            g.beginPath();
            g.moveTo(0, -len);
            g.quadraticCurveTo(0, 0, len * aspect, 0);
            g.quadraticCurveTo(0, 0, 0, len);
            g.quadraticCurveTo(0, 0, -len * aspect, 0);
            g.quadraticCurveTo(0, 0, 0, -len);
            g.closePath();
            g.fill();
          };

          const core = g.createRadialGradient(0, 0, 0, 0, 0, R);
          core.addColorStop(0, 'rgba(255, 255, 253, 1)');
          core.addColorStop(0.3, `rgba(${r1}, ${g1}, ${b1}, 0.92)`);
          core.addColorStop(1, `rgba(${r1}, ${g1}, ${b1}, 0)`);
          g.fillStyle = core;
          spike(R, 0.1);
          g.rotate(Math.PI / 4);
          g.globalAlpha = 0.5;
          spike(R * 0.52, 0.13);
          return c;
        };

        const makeDust = (r1, g1, b1) => {
          const c = document.createElement('canvas');
          c.width = c.height = 32;
          const g = c.getContext('2d');
          const grd = g.createRadialGradient(16, 16, 0, 16, 16, 15);
          grd.addColorStop(0, `rgba(255, 255, 252, 1)`);
          grd.addColorStop(0.35, `rgba(${r1}, ${g1}, ${b1}, 0.7)`);
          grd.addColorStop(1, `rgba(${r1}, ${g1}, ${b1}, 0)`);
          g.fillStyle = grd;
          g.beginPath();
          g.arc(16, 16, 15, 0, Math.PI * 2);
          g.fill();
          return c;
        };

        // 冷（近白）和暖（香槟金）各一套，随机取，画面才不会是一个颜色
        const STAR_COOL = makeStar(255, 250, 240);
        const STAR_WARM = makeStar(255, 226, 168);
        const DUST_COOL = makeDust(255, 248, 236);
        const DUST_WARM = makeDust(255, 224, 170);

        // ── 状态 ────────────────────────────────────────
        let mx = -999, my = -999;
        let gx = -999, gy = -999;   // 光点，稍微滞后，拖尾就是从这个滞后来的
        let moved = false;
        let idle = 999;
        let acc = 0;                // 走了多远（用来定间隔）
        let accStar = 0;
        let accPush = 0;

        const bits = [];
        const MAX_BITS = 320;

        const spawn = (x, y, vx, vy, star) => {
          if (bits.length >= MAX_BITS) bits.shift();
          const warm = Math.random() < 0.55;
          bits.push({
            x, y, vx, vy,
            star,
            warm,
            r: star ? 7 + Math.random() * 13 : 1.6 + Math.random() * 3.2,
            t: 0,
            span: star ? 0.95 + Math.random() * 0.8 : 0.72 + Math.random() * 0.7,
            rot: Math.random() * Math.PI,
            spin: (Math.random() - 0.5) * 1.6,
          });
        };

        window.addEventListener(
          'pointermove',
          (e) => {
            mx = e.clientX;
            my = e.clientY;
            if (!moved) { gx = mx; gy = my; moved = true; }
            idle = 0;
          },
          { passive: true }
        );
        window.addEventListener('pointerleave', () => { idle = 999; }, { passive: true });

        // 点一下，炸开一小簇
        window.addEventListener(
          'pointerdown',
          (e) => {
            for (let i = 0; i < 16; i++) {
              const a = Math.random() * Math.PI * 2;
              const v = 40 + Math.random() * 190;
              spawn(e.clientX, e.clientY, Math.cos(a) * v, Math.sin(a) * v, i < 5);
            }
          },
          { passive: true }
        );

        // 只在第一屏里有拖尾：滑下去之后淡出，滑回来再回来
        const heroEl = document.querySelector('.hero');
        let inHero = true;
        const checkZone = () => {
          const limit = heroEl ? heroEl.offsetHeight - 120 : h;
          const now = window.scrollY < limit;
          if (now !== inHero) {
            inHero = now;
            canvas.style.opacity = now ? '1' : '0';
          }
        };
        checkZone();
        window.addEventListener('scroll', checkZone, { passive: true });

        let last = performance.now();

        const frame = (now) => {
          const dt = Math.min((now - last) / 1000, 0.05);
          last = now;
          ctx.clearRect(0, 0, w, h);

          if (!inHero) { bits.length = 0; requestAnimationFrame(frame); return; }

          if (moved) {
            const px = gx, py = gy;
            const k = 1 - Math.pow(0.004, dt);
            gx += (mx - gx) * k;
            gy += (my - gy) * k;

            const dx = gx - px, dy = gy - py;
            const step = Math.hypot(dx, dy);
            const speed = step / Math.max(dt, 0.001);
            idle += dt;

            if (idle < 0.5) {
              acc += step;
              accStar += step;
              accPush += step;

              const ux = step > 0.01 ? dx / step : 0;
              const uy = step > 0.01 ? dy / step : 0;
              const carry = Math.min(speed, 950) * 0.16;   // 继承一点鼠标的速度

              // 细碎的尘：每 5px 一颗，慢下来的时候也还在掉
              while (acc > 5) {
                acc -= 5;
                const sp = (Math.random() - 0.5) * 46;
                spawn(
                  gx + (Math.random() - 0.5) * 16,
                  gy + (Math.random() - 0.5) * 16,
                  ux * carry * (0.3 + Math.random() * 0.7) - uy * sp,
                  uy * carry * (0.3 + Math.random() * 0.7) + ux * sp,
                  false
                );
              }

              // 星芒：每 17px 一颗
              while (accStar > 17) {
                accStar -= 17;
                const sp = (Math.random() - 0.5) * 34;
                spawn(
                  gx + (Math.random() - 0.5) * 22,
                  gy + (Math.random() - 0.5) * 22,
                  ux * carry * 0.5 - uy * sp,
                  uy * carry * 0.5 + ux * sp,
                  true
                );
              }

              // 拼贴元素还是会被鼠标经过时轻轻带一下（首页在听这个事件）
              while (accPush > 30) {
                accPush -= 30;
                window.dispatchEvent(
                  new CustomEvent('sheen:ripple', {
                    detail: { x: gx, y: gy, reach: 52, life: 1.0 },
                  })
                );
              }
            }
          }

          // ── 画 ────────────────────────────────────────
          for (let i = bits.length - 1; i >= 0; i--) {
            const b = bits[i];
            b.t += dt;
            const p = b.t / b.span;
            if (p >= 1) { bits.splice(i, 1); continue; }

            b.x += b.vx * dt;
            b.y += b.vy * dt + (b.star ? 7 : 13) * dt;   // 一点点重力，像星屑在沉
            b.vx *= Math.pow(0.055, dt);
            b.vy *= Math.pow(0.055, dt);
            b.rot += b.spin * dt;

            // 先涨后落：亮得快，灭得慢
            const pulse = Math.sin(Math.PI * Math.pow(p, 0.7));
            const a = Math.pow(pulse, b.star ? 1.15 : 1.5) * (b.star ? 1 : 0.6);
            if (a < 0.01) continue;

            const img = b.star
              ? (b.warm ? STAR_WARM : STAR_COOL)
              : (b.warm ? DUST_WARM : DUST_COOL);
            const size = b.r * (b.star ? 2 + pulse * 2.4 : 2.2);

            ctx.globalAlpha = a;
            if (b.star) {
              ctx.save();
              ctx.translate(b.x, b.y);
              ctx.rotate(b.rot);
              ctx.drawImage(img, -size, -size, size * 2, size * 2);
              ctx.restore();
            } else {
              ctx.drawImage(img, b.x - size, b.y - size, size * 2, size * 2);
            }
          }
          ctx.globalAlpha = 1;

          requestAnimationFrame(frame);
        };
        requestAnimationFrame(frame);
      }
    </script>

    <style>
      #glint {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: 40;
        pointer-events: none;
        opacity: 1;
        transition: opacity 0.5s ease;
      }



      @media (prefers-reduced-motion: reduce) {
        #glint { display: none; }
      }

      .site-head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 24px;
        padding-top: 28px;
        padding-bottom: 28px;
      }

      .mark {
        font-family: var(--display);
        font-size: 22px;
        font-weight: 400;
        letter-spacing: 0.02em;
      }

      .site-head nav {
        display: flex;
        gap: 32px;
      }

      .site-head nav a {
        display: flex;
        align-items: baseline;
        gap: 8px;
        font-size: 11px;
        letter-spacing: 0.26em;
        text-transform: uppercase;
        color: var(--ink-soft);
        padding-block: 12px;
      }

      .site-head nav a:hover,
      .site-head nav a[aria-current='page'] {
        color: var(--ink);
      }

      .site-head nav .cjk {
        font-family: var(--serif-cjk);
        font-size: 15px;
        letter-spacing: 0.1em;
        text-transform: none;
      }

      .site-foot {
        position: relative;
        z-index: 5;
        background: var(--ground);
        margin-top: 120px;
        padding-bottom: 48px;
      }

      .foot-link {
        border-bottom: 1px solid transparent;
        padding-bottom: 3px;
        transition: color 0.3s, border-color 0.3s;
      }

      .foot-link:hover {
        color: var(--accent);
        border-bottom-color: var(--accent);
      }

      .foot-row {
        display: flex;
        justify-content: space-between;
        padding-top: 20px;
      }

      @media (max-width: 640px) {
        .site-head nav {
          gap: 20px;
        }
        .site-head nav .en {
          display: none;
        }
        .site-head nav .cjk {
          font-size: 17px;
        }
      }
    </style>
  </body>
</html>
