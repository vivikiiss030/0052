---
import '../styles/global.css';

const { title, description = '影像与文字的存档', wide = false, bare = false, sheen = false } = Astro.props;
const site = '00:52';
const pageTitle = title ? `${title} — ${site}` : `${site} · night istill young`;
const path = Astro.url.pathname;

// 和首页那一排用同一套名字 —— 里页和首页不该是两个网站
const nav = [
  { href: '/volumes/', cjk: '如梦似幻' },
  { href: '/essays/', cjk: '头脑的温水' },
  { href: '/poems/', cjk: '情诗' },
  { href: '/about/', cjk: '我由什么组成' },
];
---

<!doctype html>
<html lang="zh-Hans">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="alternate" type="application/rss+xml" title={site} href="/rss.xml" />
  </head>

  <body>
    {
      !bare && (
        <header class="wrap site-head">
          <a href="/" class="mark" aria-label="00:52 首页">
            00:52
          </a>
          <nav aria-label="主导航">
            {nav.map((item) => (
              <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                {item.cjk}
              </a>
            ))}
          </nav>
        </header>
      )
    }

    {sheen && <canvas id="glint" aria-hidden="true" />}

    <main class={wide ? '' : 'wrap'}>
      <slot />
    </main>

    <footer class="wrap site-foot">
      <hr class="rule" />
      <div class="foot-row">
        <a href="/0052/" class="label foot-link">night istill young</a>
        <span class="label">V. &nbsp;/&nbsp; 2026</span>
      </div>
    </footer>

    <script>
      // 星屑。桌面端是魔杖式的拖尾：鼠标走过的路上密密地落下两种东西 ——
      // 细碎的尘（多、小、暗），和四角星芒（少、大、亮）。
      // 它们都继承一点鼠标当时的速度，然后减速、微微下沉、亮起来再灭掉。
      //
      // 手机上没有鼠标，也就没有「走过的路」。那儿换一种活法：
      // 拼贴元素自己会时不时闪一下，点一下屏幕也会炸开一小簇。
      // 这样「亮闪闪」这件事在两端是同一件事，只是触发方式不同。
      //
      // 星星画在一张离屏小图上预先渲染好，每帧只是把它贴过来，
      // 所以几百颗同时在也不卡 —— 如果每颗都现画渐变，手机会喘不过气。
      const canvas = document.getElementById('glint');
      const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (canvas && !still) {
        const ctx = canvas.getContext('2d');
        let w = 0;
        let h = 0;

        const resize = () => {
          w = window.innerWidth;
          h = window.innerHeight;
          const dpr = Math.min(window.devicePixelRatio || 1, 2);
          canvas.width = Math.floor(w * dpr);
          canvas.height = Math.floor(h * dpr);
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        };
        resize();
        window.addEventListener('resize', resize);

        // ── 预渲染的两枚图章 ────────────────────────────
        const S = 96;

        const makeStar = (r1, g1, b1) => {
          const c = document.createElement('canvas');
          c.width = c.height = S;
          const g = c.getContext('2d');
          g.translate(S / 2, S / 2);
          const R = S / 2 - 2;

          const halo = g.createRadialGradient(0, 0, 0, 0, 0, R);
          halo.addColorStop(0, `rgba(${r1}, ${g1}, ${b1}, 0.55)`);
          halo.addColorStop(0.32, `rgba(${r1}, ${g1}, ${b1}, 0.14)`);
          halo.addColorStop(1, `rgba(${r1}, ${g1}, ${b1}, 0)`);
          g.fillStyle = halo;
          g.beginPath();
          g.arc(0, 0, R, 0, Math.PI * 2);
          g.fill();

          // 四角芒：贝塞尔的控制点放在中心，曲线就往中间收，收出尖
          const spike = (len, aspect) => {
            g.beginPath();
            g.moveTo(0, -len);
            g.quadraticCurveTo(0, 0, len * aspect, 0);
            g.quadraticCurveTo(0, 0, 0, len);
            g.quadraticCurveTo(0, 0, -len * aspect, 0);
            g.quadraticCurveTo(0, 0, 0, -len);
            g.closePath();
            g.fill();
          };

          const core = g.createRadialGradient(0, 0, 0, 0, 0, R);
          core.addColorStop(0, 'rgba(255, 255, 253, 1)');
          core.addColorStop(0.3, `rgba(${r1}, ${g1}, ${b1}, 0.92)`);
          core.addColorStop(1, `rgba(${r1}, ${g1}, ${b1}, 0)`);
          g.fillStyle = core;
          spike(R, 0.1);
          g.rotate(Math.PI / 4);
          g.globalAlpha = 0.5;
          spike(R * 0.52, 0.13);
          return c;
        };

        const makeDust = (r1, g1, b1) => {
          const c = document.createElement('canvas');
          c.width = c.height = 32;
          const g = c.getContext('2d');
          const grd = g.createRadialGradient(16, 16, 0, 16, 16, 15);
          grd.addColorStop(0, `rgba(255, 255, 252, 1)`);
          grd.addColorStop(0.35, `rgba(${r1}, ${g1}, ${b1}, 0.7)`);
          grd.addColorStop(1, `rgba(${r1}, ${g1}, ${b1}, 0)`);
          g.fillStyle = grd;
          g.beginPath();
          g.arc(16, 16, 15, 0, Math.PI * 2);
          g.fill();
          return c;
        };

        // 冷（近白）和暖（香槟金）各一套，随机取，画面才不会是一个颜色
        const STAR_COOL = makeStar(255, 250, 240);
        const STAR_WARM = makeStar(255, 226, 168);
        const DUST_COOL = makeDust(255, 248, 236);
        const DUST_WARM = makeDust(255, 224, 170);

        // ── 状态 ────────────────────────────────────────
        let mx = -999, my = -999;
        let gx = -999, gy = -999;   // 光点，稍微滞后，拖尾就是从这个滞后来的
        let moved = false;
        let idle = 999;
        let acc = 0;                // 走了多远（用来定间隔）
        let accStar = 0;
        let accPush = 0;

        const bits = [];
        const MAX_BITS = 560;

        const spawn = (x, y, vx, vy, star) => {
          if (bits.length >= MAX_BITS) bits.shift();
          const warm = Math.random() < 0.55;
          bits.push({
            x, y, vx, vy,
            star,
            warm,
            r: star ? 4.2 + Math.random() * 5.4 : 1.7 + Math.random() * 2.3,
            t: 0,
            span: star ? 0.22 + Math.random() * 0.2 : 0.18 + Math.random() * 0.16,
            rot: Math.random() * Math.PI,
            spin: (Math.random() - 0.5) * 1.6,
          });
        };

        if (fine) {
          window.addEventListener(
            'pointermove',
            (e) => {
              mx = e.clientX;
              my = e.clientY;
              if (!moved) { gx = mx; gy = my; moved = true; }
              idle = 0;
            },
            { passive: true }
          );
          window.addEventListener('pointerleave', () => { idle = 999; }, { passive: true });
        }

        // 点一下 / 戳一下，炸开一小簇（触屏上这是主要的互动）
        window.addEventListener(
          'pointerdown',
          (e) => {
            for (let i = 0; i < 16; i++) {
              const a = Math.random() * Math.PI * 2;
              const v = 40 + Math.random() * 190;
              spawn(e.clientX, e.clientY, Math.cos(a) * v, Math.sin(a) * v, i < 5);
            }
          },
          { passive: true }
        );

        // 只在第一屏里有拖尾。退场不是「到了某一行就关掉」，
        // 而是跟着滚动连续变淡：滑到第一屏一半开始暗，滑到底就没了。
        // 已经落下的星屑不会被抹掉，它们各自过完自己那零点几秒。
        const heroEl = document.querySelector('.hero');
        let vis = 1;
        const zone = () => {
          const H = heroEl ? heroEl.offsetHeight : h;
          const a0 = H * 0.42;
          const a1 = H * 0.96;
          const y = window.scrollY;
          vis = y <= a0 ? 1 : y >= a1 ? 0 : 1 - (y - a0) / (a1 - a0);
        };
        zone();
        window.addEventListener('scroll', zone, { passive: true });

        // ── 手机端的自发闪光 ────────────────────────────
        // 随机挑一个还在画面上的拼贴元素，在它身上点一颗星。
        const pieces = [...document.querySelectorAll('.stage .el, .stage .mark')];
        let sparkIn = 0.9;

        const ambient = () => {
          const live = pieces.filter((el) => {
            const r = el.getBoundingClientRect();
            return r.width > 8 && r.bottom > 0 && r.top < h * 0.92;
          });
          if (!live.length) return;
          const el = live[(Math.random() * live.length) | 0];
          const r = el.getBoundingClientRect();
          // 落在这个元素的范围里，偏边缘一点 —— 像边上反了一下光
          const ex = r.left + r.width * (0.12 + Math.random() * 0.76);
          const ey = r.top + r.height * (0.12 + Math.random() * 0.76);
          spawn(ex, ey, (Math.random() - 0.5) * 12, -6 - Math.random() * 10, true);
          if (Math.random() < 0.6) {
            spawn(ex + (Math.random() - 0.5) * 26, ey + (Math.random() - 0.5) * 26,
              (Math.random() - 0.5) * 16, -4, false);
          }
        };

        let last = performance.now();

        const frame = (now) => {
          const dt = Math.min((now - last) / 1000, 0.05);
          last = now;
          zone();
          ctx.clearRect(0, 0, w, h);

          // 已经离开第一屏、且屏幕上一颗都不剩：什么都不用画
          if (vis <= 0.002 && bits.length === 0) { requestAnimationFrame(frame); return; }

          if (!fine && vis > 0.05) {
            sparkIn -= dt;
            if (sparkIn <= 0) {
              sparkIn = 0.5 + Math.random() * 0.8;   // 大约每半秒到一秒三闪一下
              ambient();
            }
          }

          if (moved) {
            const px = gx, py = gy;
            const k = 1 - Math.pow(0.0008, dt);
            gx += (mx - gx) * k;
            gy += (my - gy) * k;

            const dx = gx - px, dy = gy - py;
            const step = Math.hypot(dx, dy);
            const speed = step / Math.max(dt, 0.001);
            idle += dt;

            // 正在淡出的时候只让旧的演完，不再落新的
            if (idle < 0.5 && vis > 0.05) {
              const ux = step > 0.01 ? dx / step : 0;
              const uy = step > 0.01 ? dy / step : 0;
              const carry = Math.min(speed, 950) * 0.085;  // 继承一点鼠标的速度（越小尾巴越收）

              // 关键：星屑不是全都落在「鼠标现在这一点」，而是**沿着这一帧走过的
              // 那一小段路均匀铺开**。不然鼠标快的时候每帧一簇，尾巴会变成一串珠子；
              // 铺开之后才是一条连续的细线。
              const DUST = 1.5;   // 每 1.5px 一颗碎尘
              const STAR = 6;     // 每 6px 一颗星芒

              let need = DUST - acc;
              while (need <= step) {
                const f = need / step;
                const ex = px + dx * f;
                const ey = py + dy * f;
                const sp = (Math.random() - 0.5) * 24;
                spawn(
                  ex + (Math.random() - 0.5) * 10,
                  ey + (Math.random() - 0.5) * 10,
                  ux * carry * (0.3 + Math.random() * 0.7) - uy * sp,
                  uy * carry * (0.3 + Math.random() * 0.7) + ux * sp,
                  false
                );
                need += DUST;
              }
              acc = step - (need - DUST);

              need = STAR - accStar;
              while (need <= step) {
                const f = need / step;
                const ex = px + dx * f;
                const ey = py + dy * f;
                const sp = (Math.random() - 0.5) * 18;
                spawn(
                  ex + (Math.random() - 0.5) * 13,
                  ey + (Math.random() - 0.5) * 13,
                  ux * carry * 0.5 - uy * sp,
                  uy * carry * 0.5 + ux * sp,
                  true
                );
                need += STAR;
              }
              accStar = step - (need - STAR);

              // 拼贴元素还是会被鼠标经过时轻轻带一下（首页在听这个事件）
              accPush += step;
              while (accPush > 30) {
                accPush -= 30;
                window.dispatchEvent(
                  new CustomEvent('sheen:ripple', {
                    detail: { x: gx, y: gy, reach: 52, life: 1.0 },
                  })
                );
              }
            }
          }

          // ── 画 ────────────────────────────────────────
          for (let i = bits.length - 1; i >= 0; i--) {
            const b = bits[i];
            b.t += dt;
            const p = b.t / b.span;
            if (p >= 1) { bits.splice(i, 1); continue; }

            b.x += b.vx * dt;
            b.y += b.vy * dt + (b.star ? 7 : 13) * dt;   // 一点点重力，像星屑在沉
            b.vx *= Math.pow(0.055, dt);
            b.vy *= Math.pow(0.055, dt);
            b.rot += b.spin * dt;

            // 先涨后落：亮得快，灭得慢
            const pulse = Math.sin(Math.PI * Math.pow(p, 0.7));
            const a = Math.pow(pulse, b.star ? 1.2 : 1.5) * (b.star ? 0.72 : 0.5) * vis;
            if (a < 0.01) continue;

            const img = b.star
              ? (b.warm ? STAR_WARM : STAR_COOL)
              : (b.warm ? DUST_WARM : DUST_COOL);
            const size = b.r * (b.star ? 1.6 + pulse * 1.6 : 2.3);

            ctx.globalAlpha = a;
            if (b.star) {
              ctx.save();
              ctx.translate(b.x, b.y);
              ctx.rotate(b.rot);
              ctx.drawImage(img, -size, -size, size * 2, size * 2);
              ctx.restore();
            } else {
              ctx.drawImage(img, b.x - size, b.y - size, size * 2, size * 2);
            }
          }
          ctx.globalAlpha = 1;

          requestAnimationFrame(frame);
        };
        requestAnimationFrame(frame);
      }
    </script>

    <style>
      #glint {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: 40;
        pointer-events: none;
        opacity: 1;
      }



      @media (prefers-reduced-motion: reduce) {
        #glint { display: none; }
      }

      .site-head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 24px;
        padding-top: 28px;
        padding-bottom: 28px;
      }

      .mark {
        font-family: var(--display);
        font-size: 22px;
        font-weight: 400;
        letter-spacing: 0.02em;
      }

      .site-head nav {
        display: flex;
        gap: 32px;
      }

      .site-head nav a {
        font-family: var(--serif-cjk);
        font-size: clamp(13px, 1.05vw, 15px);
        letter-spacing: 0.14em;
        color: var(--ink-soft);
        padding-block: 12px;
      }

      .site-head nav a:hover,
      .site-head nav a[aria-current='page'] {
        color: var(--ink);
      }

      .site-foot {
        position: relative;
        z-index: 5;
        background: var(--ground);
        margin-top: 120px;
        padding-bottom: 48px;
      }

      .foot-link {
        border-bottom: 1px solid transparent;
        padding-bottom: 3px;
        transition: color 0.3s, border-color 0.3s;
      }

      .foot-link:hover {
        color: var(--accent);
        border-bottom-color: var(--accent);
      }

      .foot-row {
        display: flex;
        justify-content: space-between;
        padding-top: 20px;
      }

      @media (max-width: 720px) {
        .site-head {
          flex-direction: column;
          align-items: flex-start;
          gap: 10px;
          padding-bottom: 20px;
        }
        .site-head nav {
          gap: 16px;
          flex-wrap: wrap;
        }
        .site-head nav a { font-size: 13px; padding-block: 4px; }
      }
    </style>
  </body>
</html>
