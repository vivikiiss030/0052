---
import '../styles/global.css';

const { title, description = '影像与文字的存档', wide = false, bare = false, sheen = false } = Astro.props;
const site = '00:52';
const pageTitle = title ? `${title} — ${site}` : `${site} · night istill young`;
const path = Astro.url.pathname;

const nav = [
  { href: '/volumes/', cjk: '辑', en: 'Volumes' },
  { href: '/essays/', cjk: '文', en: 'Essays' },
  { href: '/poems/', cjk: '诗', en: 'Poems' },
  { href: '/about/', cjk: '我', en: 'About' },
];
---

<!doctype html>
<html lang="zh-Hans">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="alternate" type="application/rss+xml" title={site} href="/rss.xml" />
  </head>

  <body>
    {
      !bare && (
        <header class="wrap site-head">
          <a href="/" class="mark" aria-label="00:52 首页">
            00:52
          </a>
          <nav aria-label="主导航">
            {nav.map((item) => (
              <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                <span class="cjk">{item.cjk}</span>
                <span class="en">{item.en}</span>
              </a>
            ))}
          </nav>
        </header>
      )
    }

    {sheen && <canvas id="sheen" aria-hidden="true" />}

    <main class={wide ? '' : 'wrap'}>
      <slot />
    </main>

    <footer class="wrap site-foot">
      <hr class="rule" />
      <div class="foot-row">
        <a href="/0052/" class="label foot-link">night istill young</a>
        <span class="label">V. &nbsp;/&nbsp; 2026</span>
      </div>
    </footer>

    <script>
      // 鼠标拖尾：水面涟漪。鼠标每走一段就落下一圈，圈往外扩、变淡、变细。
      // 混合模式是 soft-light —— 只改亮度、不盖住文字，
      // 所以在首页的丝缎上和在里页的米色纸上都成立。
      //
      // 每落下一圈，都会往 window 上发一个 sheen:ripple 事件；
      // 首页的拼贴元素监听这个事件，涟漪扩到谁，谁就被推一下（见 index.astro）。
      const canvas = document.getElementById('sheen');
      const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (canvas && fine && !still) {
        const ctx = canvas.getContext('2d');
        let w = 0;
        let h = 0;

        const resize = () => {
          w = window.innerWidth;
          h = window.innerHeight;
          const dpr = Math.min(window.devicePixelRatio || 1, 2);
          canvas.width = Math.floor(w * dpr);
          canvas.height = Math.floor(h * dpr);
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        };
        resize();
        window.addEventListener('resize', resize);

        let mx = -999, my = -999;   // 鼠标真实位置
        let gx = -999, gy = -999;   // 光点位置，稍微滞后一点
        let lx = -999, ly = -999;   // 上一圈落下的地方
        let moved = false;
        let idle = 999;

        const rings = [];
        const MAX_RINGS = 16;
        const STEP = 30;            // 走多远落一圈
        const LIFE = 1.15;          // 一圈活多久（秒）

        const drop = (x, y, power) => {
          if (rings.length >= MAX_RINGS) rings.shift();
          const reach = 54 + power * 34;
          rings.push({ x, y, t: 0, reach });
          // 告诉页面上的东西：这里落了一圈
          window.dispatchEvent(
            new CustomEvent('sheen:ripple', { detail: { x, y, reach, life: LIFE } })
          );
        };

        window.addEventListener(
          'pointermove',
          (e) => {
            mx = e.clientX;
            my = e.clientY;
            if (!moved) { gx = lx = mx; gy = ly = my; moved = true; }
            idle = 0;
          },
          { passive: true }
        );
        window.addEventListener('pointerleave', () => { idle = 999; }, { passive: true });

        // 点一下，落一圈大的
        window.addEventListener(
          'pointerdown',
          (e) => { drop(e.clientX, e.clientY, 1.6); },
          { passive: true }
        );

        // 只在第一屏里有涟漪：滑下去之后淡出，滑回来再回来
        const heroEl = document.querySelector('.hero');
        let inHero = true;
        const checkZone = () => {
          const limit = heroEl ? heroEl.offsetHeight - 120 : h;
          const now = window.scrollY < limit;
          if (now !== inHero) {
            inHero = now;
            canvas.style.opacity = now ? '1' : '0';
          }
        };
        checkZone();
        window.addEventListener('scroll', checkZone, { passive: true });

        let last = performance.now();

        const frame = (now) => {
          const dt = Math.min((now - last) / 1000, 0.05);
          last = now;
          ctx.clearRect(0, 0, w, h);

          if (!inHero) { rings.length = 0; requestAnimationFrame(frame); return; }

          if (moved) {
            const px = gx, py = gy;
            const k = 1 - Math.pow(0.004, dt);
            gx += (mx - gx) * k;
            gy += (my - gy) * k;
            const speed = Math.hypot(gx - px, gy - py) / Math.max(dt, 0.001);

            idle += dt;

            // 走够一段距离就落一圈 —— 走得快，圈就大一点
            const d = Math.hypot(gx - lx, gy - ly);
            if (d > STEP) {
              lx = gx; ly = gy;
              drop(gx, gy, Math.min(speed / 700, 1));
            }

            // 光点：涟漪的出处
            const wake = Math.max(0, 1 - idle / 0.9);
            if (wake > 0.01) {
              const a = 0.11 * wake;
              const r = 50;
              const g = ctx.createRadialGradient(gx, gy, 0, gx, gy, r);
              g.addColorStop(0, `rgba(255, 244, 230, ${a})`);
              g.addColorStop(1, 'rgba(255, 238, 220, 0)');
              ctx.globalCompositeOperation = 'lighter';
              ctx.fillStyle = g;
              ctx.beginPath();
              ctx.arc(gx, gy, r, 0, Math.PI * 2);
              ctx.fill();
              ctx.globalCompositeOperation = 'source-over';
            }
          }

          ctx.globalCompositeOperation = 'lighter';
          for (let i = rings.length - 1; i >= 0; i--) {
            const ring = rings[i];
            ring.t += dt;
            const p = ring.t / LIFE;
            if (p >= 1) { rings.splice(i, 1); continue; }

            // 往外扩：一开始快，后来慢下来，像水面
            const grow = 1 - Math.pow(1 - p, 2.4);
            const r = 8 + ring.reach * grow;
            const fade = Math.pow(1 - p, 1.5);

            // 真实的水波是一道亮的脊 + 紧跟着一道暗的谷。
            // 只画亮的会像光圈，两道一起画才像水。
            ctx.globalCompositeOperation = 'source-over';
            ctx.strokeStyle = `rgba(92, 62, 52, ${0.19 * fade})`;
            ctx.lineWidth = 1 + 2.6 * fade;
            ctx.beginPath();
            ctx.arc(ring.x, ring.y, r * 0.9, 0, Math.PI * 2);
            ctx.stroke();

            ctx.globalCompositeOperation = 'lighter';
            ctx.strokeStyle = `rgba(255, 250, 242, ${0.62 * fade})`;
            ctx.lineWidth = 1 + 2.2 * fade;
            ctx.beginPath();
            ctx.arc(ring.x, ring.y, r, 0, Math.PI * 2);
            ctx.stroke();

            // 再跟一圈更小更淡的次波
            if (r > 20) {
              ctx.strokeStyle = `rgba(255, 246, 236, ${0.21 * fade})`;
              ctx.lineWidth = 1 + 3 * fade;
              ctx.beginPath();
              ctx.arc(ring.x, ring.y, r * 0.58, 0, Math.PI * 2);
              ctx.stroke();
            }
          }
          ctx.globalCompositeOperation = 'source-over';

          requestAnimationFrame(frame);
        };
        requestAnimationFrame(frame);
      }
    </script>

    <style>
      #sheen {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: 40;
        pointer-events: none;
        mix-blend-mode: soft-light;
        opacity: 1;
        transition: opacity 0.5s ease;
      }

      @media (prefers-reduced-motion: reduce) {
        #sheen { display: none; }
      }

      .site-head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 24px;
        padding-top: 28px;
        padding-bottom: 28px;
      }

      .mark {
        font-family: var(--display);
        font-size: 22px;
        font-weight: 400;
        letter-spacing: 0.02em;
      }

      .site-head nav {
        display: flex;
        gap: 32px;
      }

      .site-head nav a {
        display: flex;
        align-items: baseline;
        gap: 8px;
        font-size: 11px;
        letter-spacing: 0.26em;
        text-transform: uppercase;
        color: var(--ink-soft);
        padding-block: 12px;
      }

      .site-head nav a:hover,
      .site-head nav a[aria-current='page'] {
        color: var(--ink);
      }

      .site-head nav .cjk {
        font-family: var(--serif-cjk);
        font-size: 15px;
        letter-spacing: 0.1em;
        text-transform: none;
      }

      .site-foot {
        position: relative;
        z-index: 5;
        background: var(--ground);
        margin-top: 120px;
        padding-bottom: 48px;
      }

      .foot-link {
        border-bottom: 1px solid transparent;
        padding-bottom: 3px;
        transition: color 0.3s, border-color 0.3s;
      }

      .foot-link:hover {
        color: var(--accent);
        border-bottom-color: var(--accent);
      }

      .foot-row {
        display: flex;
        justify-content: space-between;
        padding-top: 20px;
      }

      @media (max-width: 640px) {
        .site-head nav {
          gap: 20px;
        }
        .site-head nav .en {
          display: none;
        }
        .site-head nav .cjk {
          font-size: 17px;
        }
      }
    </style>
  </body>
</html>
