---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';

import moon from '../../assets/collage/moon.png';
import letterCandle from '../../assets/collage/letter-candle.png';
import goldCorner from '../../assets/collage/gold-corner.png';

// 页边上散落的一层。全部绝对定位、用百分比，所以文章越多页面越长，
// 它们也跟着摊开，不会挤在一起
import star8 from '../../assets/collage/star8.png';
import moth2 from '../../assets/collage/moth2.png';
import mothLantern from '../../assets/collage/moth-lantern.png';
import moonInk from '../../assets/collage/moon-ink.png';
import moonEngraved from '../../assets/collage/moon-engraved.png';
import wings from '../../assets/collage/wings.png';
import starCry from '../../assets/collage/star-cry.png';
import heartEye from '../../assets/collage/heart-eye.png';
import medallion from '../../assets/collage/medallion.png';
import cloudEngraved from '../../assets/collage/cloud-engraved.png';
import key from '../../assets/collage/key.png';
import blade from '../../assets/collage/blade.png';
import ladybug from '../../assets/collage/ladybug.png';
import rosary from '../../assets/collage/rosary.png';
import sunLine from '../../assets/collage/sun-line.png';

const scatter = [
  { src: cloudEngraved, k: 'c1', alt: '' },
  { src: star8, k: 'c2', alt: '' },
  { src: moonInk, k: 'c3', alt: '' },
  { src: key, k: 'c4', alt: '' },
  { src: wings, k: 'c5', alt: '' },
  { src: mothLantern, k: 'c6', alt: '' },
  { src: starCry, k: 'c7', alt: '' },
  { src: rosary, k: 'c8', alt: '' },
  { src: blade, k: 'c9', alt: '' },
  { src: heartEye, k: 'c10', alt: '' },
  { src: ladybug, k: 'c11', alt: '' },
  { src: moonEngraved, k: 'c12', alt: '' },
  { src: medallion, k: 'c13', alt: '' },
  { src: moth2, k: 'c14', alt: '' },
  { src: sunLine, k: 'c15', alt: '' },
];

// 没有日期，按原稿里的先后排（n），最后写的排在最前
const essays = (await getCollection('essays', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.n - a.data.n
);

const nn = (n) => String(n).padStart(2, '0');

// 这一段就是「头脑的温水到底是什么意思」。想改直接改这儿。
const intro = {
  cjk: '头脑的温水',
  en: 'good for your brains',
  lead: '不是文章，是想通了的事，和还没想通但先记下来的事。',
  body: '这里没有日期。它们不按时间排队，也不等着被追更 —— 你碰巧打开哪一篇，哪一篇就是最新的。',
};
---

<Base title={intro.cjk} description={intro.lead} wide>
  <div class="page">
    <div class="scatter" aria-hidden="true">
      {scatter.map((o) => (
        <Image src={o.src} alt="" format="webp" quality={80} class={`s ${o.k}`} loading="lazy" />
      ))}
    </div>

    <!-- 报头 -->
    <header class="masthead wrap">
      <div class="mast-main">
        <h1>{intro.cjk}</h1>
        <p class="en">{intro.en}</p>
      </div>
      <Image src={moon} alt="" format="webp" quality={80} class="mast-mark" loading="eager" />
    </header>

    <hr class="rule wrap thick" />

    <div class="standfirst wrap">
      <p class="lead">{intro.lead}</p>
      <p class="note">{intro.body}</p>
      <p class="count label">共 {essays.length} 篇</p>
    </div>

    <hr class="rule wrap" />

    <!-- 目录 -->
    <ol class="toc wrap">
      {
        essays.map((e, i) => (
          <li class={i === 0 ? 'lead-item' : ''}>
            <a href={`/essays/${e.id}/`}>
              <span class="n">{nn(e.data.n)}</span>
              <span class="t">
                <h2>{e.data.title}</h2>
                {e.data.summary && <p class="s">{e.data.summary}</p>}
              </span>
              <span class="go">→</span>
            </a>
          </li>
        ))
      }
    </ol>

    {essays.length === 0 && <p class="empty wrap">还没有文章。</p>}

    <div class="tail wrap">
      <Image src={letterCandle} alt="" format="webp" quality={80} class="t-letter" loading="lazy" />
      <Image src={goldCorner} alt="" format="webp" quality={80} class="t-gold" loading="lazy" />
    </div>
  </div>
</Base>

<style>
  .page { position: relative; padding-top: 12px; overflow: hidden; }

  /* ── 页边散落的一层 ──────────────────────────
     压在内容下面（z-index 0），只在两侧的空白里出现，
     不碰正文。尺寸、角度、浓淡都各不相同 —— 
     一模一样地排开，加再多也还是单调。 */
  .scatter {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .scatter .s { position: absolute; height: auto; }

  .c1  { top: 6%;  left: -2%;  width: 84px;  opacity: 0.42; transform: rotate(-8deg); }
  .c2  { top: 13%; right: 2%;  width: 54px;  opacity: 0.72; transform: rotate(12deg); }
  .c3  { top: 21%; left: 0.5%; width: 46px;  opacity: 0.6;  transform: rotate(-16deg); }
  .c4  { top: 27%; right: 8%;  width: 38px;  opacity: 0.66; transform: rotate(24deg); }
  .c5  { top: 34%; left: 2%;   width: 52px;  opacity: 0.6;  transform: rotate(-22deg); }
  .c6  { top: 40%; right: 3%;  width: 50px;  opacity: 0.75; transform: rotate(9deg); }
  .c7  { top: 47%; left: 1%;   width: 44px;  opacity: 0.7;  transform: rotate(14deg); }
  .c8  { top: 53%; right: 6%;  width: 66px;  opacity: 0.5;  transform: rotate(-10deg); }
  .c9  { top: 60%; left: 2.5%; width: 26px;  opacity: 0.62; transform: rotate(6deg); }
  .c10 { top: 66%; right: 2%;  width: 48px;  opacity: 0.68; transform: rotate(-14deg); }
  .c11 { top: 73%; left: 1.5%; width: 24px;  opacity: 0.8;  transform: rotate(28deg); }
  .c12 { top: 78%; right: 9%;  width: 42px;  opacity: 0.55; transform: rotate(18deg); }
  .c13 { top: 85%; left: 0%;   width: 46px;  opacity: 0.6;  transform: rotate(-6deg); }
  .c14 { top: 90%; right: 4%;  width: 32px;  opacity: 0.7;  transform: rotate(-20deg); }
  .c15 { top: 95%; left: 3%;   width: 50px;  opacity: 0.5;  transform: rotate(10deg); }

  .masthead, .standfirst, .toc, .tail, .page > .rule { position: relative; z-index: 1; }

  /* ── 报头：大字 + 一枚金月牙压在右边 ────────── */
  .masthead {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    padding-top: 26px;
    padding-bottom: 18px;
  }

  .mast-main h1 {
    margin: 0;
    font-family: var(--serif-cjk);
    font-size: clamp(40px, 8.4vw, 104px);
    font-weight: 400;
    letter-spacing: 0.12em;
    line-height: 1.05;
    color: var(--ink);
  }

  .mast-main .en {
    margin: 14px 0 0;
    font-family: var(--display);
    font-style: italic;
    font-size: clamp(16px, 2vw, 24px);
    letter-spacing: 0.02em;
    color: var(--accent);
  }

  .mast-mark {
    width: clamp(56px, 8vw, 116px);
    height: auto;
    transform: rotate(-14deg);
    filter: drop-shadow(0 8px 18px rgba(118, 94, 90, 0.2));
    flex: 0 0 auto;
  }

  .thick { border-top-width: 2px; }

  /* ── 引言：三栏，像杂志的 standfirst ────────── */
  .standfirst {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1.1fr) auto;
    gap: clamp(20px, 4vw, 64px);
    align-items: start;
    padding-block: 26px;
  }

  .lead {
    margin: 0;
    font-family: var(--serif-cjk);
    font-size: clamp(17px, 1.6vw, 21px);
    font-weight: 400;
    line-height: 1.85;
    letter-spacing: 0.04em;
    color: var(--ink);
  }

  .note {
    margin: 0;
    font-family: var(--serif-cjk);
    font-size: 14px;
    font-weight: 300;
    line-height: 2;
    letter-spacing: 0.04em;
    color: var(--ink-soft);
  }

  .count { margin: 0; white-space: nowrap; }

  /* ── 目录 ─────────────────────────────────── */
  .toc {
    list-style: none;
    margin: 0;
    padding-top: 6px;
    padding-bottom: 40px;
  }

  .toc li { border-bottom: 1px solid var(--rule); }

  .toc a {
    display: grid;
    grid-template-columns: clamp(58px, 7vw, 104px) minmax(0, 1fr) 36px;
    gap: clamp(16px, 3vw, 44px);
    align-items: baseline;
    padding-block: clamp(22px, 2.6vw, 34px);
  }

  .n {
    font-family: var(--display);
    font-size: clamp(26px, 3.6vw, 46px);
    line-height: 1;
    color: var(--rule);
    transition: color 0.35s;
  }

  .toc h2 {
    margin: 0;
    font-family: var(--serif-cjk);
    font-size: clamp(19px, 1.9vw, 26px);
    font-weight: 400;
    letter-spacing: 0.06em;
    line-height: 1.5;
    transition: color 0.35s;
  }

  .s {
    margin: 10px 0 0;
    max-width: 44em;
    font-family: var(--serif-cjk);
    font-size: 14px;
    font-weight: 300;
    line-height: 1.95;
    letter-spacing: 0.03em;
    color: var(--ink-soft);
  }

  .go {
    justify-self: end;
    font-size: 15px;
    color: var(--rule);
    opacity: 0;
    transform: translateX(-8px);
    transition: opacity 0.35s, transform 0.35s, color 0.35s;
  }

  .toc a:hover .n { color: var(--accent); }
  .toc a:hover h2 { color: var(--accent); }
  .toc a:hover .go { opacity: 1; transform: none; color: var(--accent); }

  /* 第一条更重一些 —— 目录也该有主次 */
  .lead-item h2 { font-size: clamp(23px, 2.7vw, 36px); }
  .lead-item .n { color: var(--accent); }

  /* ── 页尾散落的三枚小元素 ──────────────────── */
  /* 页尾：一封手写的信压着蜡烛和书，从右边切出画面。
     这一页从头到尾都是字，末尾需要一件有重量的东西把它按住 */
  .tail {
    position: relative;
    height: clamp(180px, 22vw, 300px);
    overflow: hidden;
  }

  .tail img { position: absolute; height: auto; }

  .t-letter {
    width: clamp(220px, 30vw, 430px);
    right: -4%;
    top: -10px;
    transform: rotate(-4deg);
    opacity: 0.92;
    filter: drop-shadow(0 14px 30px rgba(118, 94, 90, 0.16));
  }

  /* 左下角压一块烫金花饰，和右边那封信形成一对 */
  .t-gold {
    width: clamp(90px, 13vw, 200px);
    left: -4%;
    bottom: -30px;
    transform: rotate(-6deg);
    opacity: 0.62;
  }

  .empty {
    font-family: var(--serif-cjk);
    color: var(--ink-soft);
  }

  @media (max-width: 860px) {
    .standfirst {
      grid-template-columns: 1fr;
      gap: 14px;
    }
    .toc a {
      grid-template-columns: 42px minmax(0, 1fr);
      gap: 14px;
    }
    .go { display: none; }
    .tail { height: 150px; }
    /* 手机上两侧没有空白可言，散落那层会压到字 —— 只留几件小的 */
    .c1, .c3, .c5, .c7, .c9, .c11, .c13, .c15, .c8 { display: none; }
    .scatter .s { opacity: 0.4; }
  }
</style>
