---
import { Image, Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';

import satin from '../assets/collage/satin.jpg';
import caladium from '../assets/collage/caladium.png';
import paleflower from '../assets/collage/paleflower.png';
import paleflower2 from '../assets/collage/paleflower2.png';
import uranus from '../assets/collage/uranus.png';
import nautilus from '../assets/collage/nautilus.png';
import star from '../assets/collage/star.png';
import moon from '../assets/collage/moon.png';
import moon2 from '../assets/collage/moon2.png';
import blueflower from '../assets/collage/blueflower.png';
import nightflower from '../assets/collage/nightflower.png';
import dagger from '../assets/collage/dagger.png';
import lilypad from '../assets/collage/lilypad.png';
import lilypad2 from '../assets/collage/lilypad2.png';
import lotus from '../assets/collage/lotus.png';
import begonia from '../assets/collage/begonia.png';
import starfish from '../assets/collage/starfish.png';
import orchid from '../assets/collage/orchid.png';
import cherub from '../assets/collage/cherub.png';
import planet from '../assets/collage/planet.png';
import moonlet from '../assets/collage/moonlet.png';
import nautilus2 from '../assets/collage/nautilus2.png';
import butterflyGreen from '../assets/collage/butterfly-green.png';

// 首屏的拼贴元素。位置在下面的 CSS 里，这里只定义层次：
// depth 决定视差幅度（越「近」动得越多），ph 是漂浮的相位差
const pieces = [

  { k: 'caladium', src: caladium, alt: '粉脉彩叶芋', d: 1.0, ph: 0.0 },
  { k: 'paleflower2', src: paleflower2, alt: '淡蓝色花', d: 0.35, ph: 1.7 },
  { k: 'paleflower', src: paleflower, alt: '浅蓝色花', d: 0.55, ph: 0.4 },
  { k: 'uranus', src: uranus, alt: '天王星', d: 0.3, ph: 2.9 },
  { k: 'nautilus2', src: nautilus2, alt: '鹦鹉螺壳', d: 0.3, ph: 1.1 },
  { k: 'star', src: star, alt: '金色星芒', d: 0.85, ph: 2.2 },
  { k: 'moon', src: moon, alt: '金色月牙', d: 0.7, ph: 0.8 },
  { k: 'blueflower', src: blueflower, alt: '蓝色花', d: 0.55, ph: 3.4 },
  { k: 'nightflower', src: nightflower, alt: '深蓝色花', d: 0.5, ph: 1.5 },
  { k: 'nautilus', src: nautilus, alt: '鹦鹉螺壳', d: 0.4, ph: 2.6 },
  { k: 'dagger', src: dagger, alt: '匕首', d: 0.95, ph: 0.3 },
  { k: 'lilypad', src: lilypad, alt: '荷叶', d: 0.8, ph: 1.9 },
  { k: 'lilypad2', src: lilypad2, alt: '荷叶', d: 0.6, ph: 3.1 },
  { k: 'lotus', src: lotus, alt: '粉色睡莲', d: 1.0, ph: 0.6 },
  { k: 'begonia', src: begonia, alt: '螺旋秋海棠叶', d: 0.6, ph: 2.4 },
  { k: 'starfish', src: starfish, alt: '海星', d: 0.6, ph: 1.3 },
  { k: 'orchid', src: orchid, alt: '绿色兰花', d: 0.5, ph: 0.9 },
  { k: 'cherub', src: cherub, alt: '金色小天使', d: 0.9, ph: 2.0 },
  { k: 'planet', src: planet, alt: '蓝色星球', d: 0.3, ph: 3.6 },
  { k: 'moon2', src: moon2, alt: '金色月牙', d: 0.35, ph: 1.2 },
  { k: 'moonlet', src: moonlet, alt: '月亮', d: 0.25, ph: 2.8 },
  { k: 'butterflyGreen', src: butterflyGreen, alt: '绿色凤蝶', d: 0.75, ph: 2.3 },
];

// ── 全站文案都在这里 ───────────────────────────────────────────
// 改字不用碰别的地方。〔方括号〕里的是待填，填完连括号一起删。
const site = {
  cjk: '自留地',
  latin: 'The Open Space',
  tagline: 'Tarot readings · online · in English & 中文',
  by: 'with Vicky',
  instagram: '〔your_handle〕',
};

const nav = [
  { href: '#name', label: 'The name' },
  { href: '#how', label: 'How I read' },
  { href: '#readings', label: 'Readings' },
  { href: '#book', label: 'Book' },
];

const nameStory = {
  id: 'name',
  kicker: 'The name',
  title: '自留地',
  body: [
    'In Chinese, 自留地 is the small private plot a household was allowed to keep for itself, back when all the other land was farmed in common. Nobody set a quota for it. Nothing grown on it had to be handed in.',
    'That is what I want an hour with me to be. Not a forecast you then have to live up to — a piece of ground that is yours, where you are allowed to say the thing you have not said out loud yet.',
  ],
};

const how = {
  id: 'how',
  kicker: 'How I read',
  title: 'I don’t read fate. I read where you are standing.',
  body: [
    'The cards are very good at showing the shape of a situation: what you are actually afraid of, what you have been calling love, what you have already decided and are only waiting for permission to do.',
    'They are much worse at telling you what will happen, and I won’t pretend otherwise. So a reading with me is a conversation with a deck on the table. You will not get “he comes back on the fourteenth.” You will get a clearer view of what you want, what it would cost, and how much of it is actually in your hands — which is usually more than people expect.',
  ],
};

// 时长和价格填这里
const readings = [
  {
    n: '01',
    name: 'One question',
    len: '〔30 min〕',
    price: '〔price〕',
    note: 'One thing you keep circling. We look at it properly, and then we stop.',
  },
  {
    n: '02',
    name: 'Full reading',
    len: '〔60 min〕',
    price: '〔price〕',
    note: 'Where you are, what is moving and what is not. Room for more than one thread.',
  },
  {
    n: '03',
    name: '〔third option — delete this block if you only offer two〕',
    len: '〔length〕',
    price: '〔price〕',
    note: '〔one line〕',
  },
];

const readingsNote =
  'Online, over 〔video / voice / written〕. In English or Chinese — whichever you think in.';

// 攒够了再放。不满三条就先把这一节整个删掉，空着比没有更差
const says = [
  { quote: '〔a few lines someone wrote you after a reading〕', who: '〔R., London〕' },
  { quote: '〔another one〕', who: '〔who〕' },
  { quote: '〔another one〕', who: '〔who〕' },
];

// 感悟：短。一两句就够 —— 这不是文章，是你在解读里说过、
// 对方当场记下来的那种话
const notes = [
  { t: '〔a short thought〕', b: '〔one or two sentences.〕' },
  { t: '〔another〕', b: '〔…〕' },
  { t: '〔another〕', b: '〔…〕' },
];

const book = {
  id: 'book',
  kicker: 'Book',
  title: 'Readings are booked through Instagram.',
  body:
    'Send me a message and tell me roughly what is going on — no need to make it tidy. We will find a time.',
};
---

<Base bare wide sheen title={`${site.latin} ${site.cjk}`} description={site.tagline}>
  <section class="hero">
    <Picture
      src={satin}
      formats={['avif', 'webp']}
      widths={[800, 1400, 2000]}
      sizes="100vw"
      alt=""
      loading="eager"
      class="ground"
    />

    <div class="stage">
      <div class="mark-wrap">
        <h1 class="mark">
          {site.cjk}<span class="mark-latin">{site.latin}</span>
        </h1>
      </div>
      {
        pieces.map((p, i) => (
          <Image
            src={p.src}
            alt={p.alt}
            format="webp"
            quality={80}
            class={`el ${p.k}`}
            loading="eager"
            data-d={p.d}
            data-ph={p.ph}
            style={`--i:${i}`}
          />
        ))
      }
    </div>

    <div class="topbar">
      <span class="brand label">{site.latin}</span>
      <nav aria-label="Sections">
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
    </div>

    <div class="bottombar">
      <p class="tagline">{site.tagline}</p>
      <span class="label sig">{site.by}</span>
    </div>
  </section>

  <div class="below">
    <!-- 名字的来历 -->
    <section class="wrap block" id={nameStory.id}>
      <p class="kicker label">{nameStory.kicker}</p>
      <hr class="rule" />
      <div class="two">
        <h2 class="cjk-title">{nameStory.title}</h2>
        <div class="prose-en">
          {nameStory.body.map((t) => (
            <p>{t}</p>
          ))}
        </div>
      </div>
    </section>

    <!-- 怎么读牌 -->
    <section class="wrap block" id={how.id}>
      <p class="kicker label">{how.kicker}</p>
      <hr class="rule" />
      <div class="two">
        <h2 class="stance">{how.title}</h2>
        <div class="prose-en">
          {how.body.map((t) => (
            <p>{t}</p>
          ))}
        </div>
      </div>
    </section>

    <!-- 项目与价格 -->
    <section class="wrap block" id="readings">
      <p class="kicker label">Readings</p>
      <hr class="rule" />
      <ul class="menu">
        {readings.map((r) => (
          <li>
            <span class="rn">{r.n}</span>
            <span class="rbody">
              <h3>{r.name}</h3>
              <p class="rnote">{r.note}</p>
            </span>
            <span class="rmeta">
              <span class="rlen label">{r.len}</span>
              <span class="rprice">{r.price}</span>
            </span>
          </li>
        ))}
      </ul>
      <p class="menu-note">{readingsNote}</p>
    </section>

    <!-- 反馈 -->
    <section class="wrap block" id="says">
      <p class="kicker label">What people say</p>
      <hr class="rule" />
      <ul class="says">
        {says.map((s) => (
          <li>
            <blockquote>{s.quote}</blockquote>
            <p class="who label">{s.who}</p>
          </li>
        ))}
      </ul>
    </section>

    <!-- 感悟 -->
    <section class="wrap block" id="notes">
      <p class="kicker label">Notes</p>
      <hr class="rule" />
      <ul class="notes">
        {notes.map((o) => (
          <li>
            <h3>{o.t}</h3>
            <p>{o.b}</p>
          </li>
        ))}
      </ul>
    </section>

    <!-- 预约 -->
    <section class="wrap block book" id={book.id}>
      <p class="kicker label">{book.kicker}</p>
      <hr class="rule" />
      <h2 class="stance">{book.title}</h2>
      <p class="prose-en">{book.body}</p>
      <a class="cta" href={`https://instagram.com/${site.instagram}`} rel="me noopener">
        <span>Message me on Instagram</span>
        <span class="handle">@{site.instagram}</span>
      </a>
    </section>
  </div>
</Base>

<script>
  // 丝缎的动感：滚动视差 + 极慢的漂浮。
  // 两者都只改 transform，合成一个 rAF 循环，不触发重排。
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const stage = document.querySelector('.stage');
  const mark = document.querySelector('.mark');
  const markWrap = document.querySelector('.mark-wrap');
  const ground = document.querySelector('.ground');

  if (stage && !reduce) {
    const els = [...stage.querySelectorAll('.el')].map((el) => ({
      el,
      d: parseFloat(el.dataset.d || '0.5'),
      ph: parseFloat(el.dataset.ph || '0'),
      // 被涟漪推开之后的偏移、速度、以及一点点转动和缩放
      ox: 0, oy: 0, vx: 0, vy: 0, rw: 0, rv: 0, pop: 0, cool: 0,
      cx: 0, cy: 0, hw: 0,
    }));

    // 元素在屏幕上的中心。第一屏是 sticky 的，钉住的时候它的顶就是屏幕的顶，
    // 所以用 offsetLeft/offsetTop 就够了，不用每帧去问浏览器要位置（那会很卡）。
    const measure = () => {
      for (const o of els) {
        o.cx = o.el.offsetLeft + o.el.offsetWidth / 2;
        o.cy = o.el.offsetTop + o.el.offsetHeight / 2;
        o.hw = Math.max(o.el.offsetWidth, o.el.offsetHeight) * 0.5;
      }
    };
    measure();
    window.addEventListener('resize', measure);
    window.addEventListener('load', measure);

    // ── 涟漪碰到元素 ─────────────────────────────────
    // Base.astro 里每落下一圈涟漪就发一个事件。这里记下来，
    // 每帧算这一圈现在扩到多大，扩到谁身上，就把谁往外推一下。
    const waves = [];

    window.addEventListener('sheen:ripple', (e) => {
      const { x, y, reach, life } = e.detail;
      if (waves.length > 14) waves.shift();
      waves.push({ x, y, reach, life, t: 0, hit: new Set() });
    });

    let sy = 0;
    let ticking = false;
    const onScroll = () => {
      sy = window.scrollY;
      if (!ticking) { ticking = true; requestAnimationFrame(() => { ticking = false; }); }
    };
    window.addEventListener('scroll', onScroll, { passive: true });

    const hero = document.querySelector('.hero');

    let prev = performance.now();

    const loop = (now) => {
      const t = now * 0.001;
      const dt = Math.min((now - prev) / 1000, 0.05);
      prev = now;
      // 第一屏滚出视野之后就不再计算
      const heroH = hero ? hero.offsetHeight : window.innerHeight;
      const active = sy < heroH + 240;
      if (active) {
        // 第一屏被钉住，用「滚过了多少」当进度，位移才不会飞出去
        const prog = Math.min(sy / heroH, 1);
        // 缓入缓出，让退后的过程不是线性的，更像呼气
        const ease = prog * prog * (3 - 2 * prog);

        // 先让每一圈涟漪长大，看它这一帧扫过了谁
        const heroTop = hero ? Math.max(0, heroH - sy) : 0;   // 第一屏还剩多少在屏幕上
        for (let i = waves.length - 1; i >= 0; i--) {
          const wv = waves[i];
          wv.t += dt;
          const wp = wv.t / wv.life;
          if (wp >= 1) { waves.splice(i, 1); continue; }
          const wr = 8 + wv.reach * (1 - Math.pow(1 - wp, 2.4));
          const strength = Math.pow(1 - wp, 1.4);
          if (strength < 0.08) continue;

          for (let j = 0; j < els.length; j++) {
            const o = els[j];
            if (wv.hit.has(j) || o.cool > 0) continue;   // 刚被碰过就先歇一下，免得一串圈把它顶飞
            // 元素中心在屏幕上的位置：sticky 的时候等于 offset，滚出去之后跟着上移
            const ex = o.cx;
            const ey = o.cy - (heroH - heroTop);
            const dx = ex - wv.x;
            const dy = ey - wv.y;
            const dist = Math.hypot(dx, dy) || 0.001;
            // 圈边扫到元素的轮廓范围内，就算「碰到」
            if (Math.abs(dist - wr) > o.hw * 0.72 + 26) continue;
            wv.hit.add(j);
            o.cool = 0.36;
            const push = (36 + 26 * o.d) * strength;
            o.vx += (dx / dist) * push;
            o.vy += (dy / dist) * push;
            o.rv += (dx > 0 ? 1 : -1) * 11 * strength * o.d;
            o.pop = Math.max(o.pop, 0.018 * strength);
          }
        }

        for (const o of els) {
          if (o.cool > 0) o.cool -= dt;
          // 漂浮：周期约 20 秒，幅度 8–24px
          const amp = 8 + o.d * 16;
          const fx = Math.sin(t * 0.3 + o.ph) * amp;
          const fy = Math.cos(t * 0.23 + o.ph) * amp * 0.75;
          // 视差：越「近」的元素随滚动上移越多
          const py = -prog * 220 * o.d;
          const px = Math.sin(o.ph) * prog * 26 * o.d;

          // 被推开之后往回弹：弹簧 + 阻尼，晃两下就停
          o.vx += (-o.ox * 26 - o.vx * 7.4) * dt;
          o.vy += (-o.oy * 26 - o.vy * 7.4) * dt;
          o.ox += o.vx * dt;
          o.oy += o.vy * dt;
          o.rv += (-o.rw * 20 - o.rv * 6.2) * dt;
          o.rw += o.rv * dt;
          o.pop *= Math.pow(0.3, dt);

          o.el.style.setProperty('--tx', (fx + px + o.ox).toFixed(2) + 'px');
          o.el.style.setProperty('--ty', (fy + py + o.oy).toFixed(2) + 'px');
          o.el.style.setProperty('--rw', o.rw.toFixed(2) + 'deg');
          // 一起往后退一点，越近的退得越多；被碰到的瞬间还会鼓一下
          o.el.style.setProperty('--sc', (1 - ease * 0.09 * o.d + o.pop).toFixed(4));
        }

        if (markWrap) {
          // 呼吸：周期约 10 秒，幅度 1.7% —— 静止时数字自己也在起伏
          const breath = Math.sin(t * 0.62) * 0.017;
          markWrap.style.setProperty('--msc', (1 - ease * 0.24 + breath).toFixed(4));
          // 透明度也跟着呼吸走一点，起伏才看得见而不只是「大小在变」
          markWrap.style.setProperty('--mop', (1 - ease * 0.72 + (breath - 0.017) * 1.6).toFixed(3));
        }
        if (mark) {
          // 除了随滚动上移，再叠一层 5px 的缓慢浮动
          const mb = Math.sin(t * 0.62 + 1.1) * 5;
          mark.style.setProperty('--mty', (-prog * 70 + mb).toFixed(2) + 'px');
        }

        if (ground) {
          // 丝缎随滚动推近，并叠一层周期约 31 秒、幅度 1.3% 的极慢呼吸。
          // 底数 1.022 是为了让呼吸缩到最小时仍然 > 1，不会露出边。
          const gb = Math.sin(t * 0.2) * 0.013;
          ground.style.setProperty('--gsc', (1.022 + ease * 0.11 + gb).toFixed(4));
        }
      }
      requestAnimationFrame(loop);
    };
    requestAnimationFrame(loop);
  }

  // 下方区块进入视口时浮起
  const blocks = document.querySelectorAll('.block');
  if (blocks.length) {
    if (reduce || !('IntersectionObserver' in window)) {
      blocks.forEach((b) => b.classList.add('in'));
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
          });
        },
        { rootMargin: '0px 0px -12% 0px' }
      );
      blocks.forEach((b) => io.observe(b));
    }
  }
</script>

<style>
  /* ── 第一屏：丝缎为地的拼贴 ───────────────── */
  .hero {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
    background: #eadad4;
  }

  .ground {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(var(--gsc, 1));
    transform-origin: 50% 50%;
    will-change: transform;
  }

  .stage {
    position: absolute;
    inset: 0;
  }

  .mark-wrap {
    position: absolute;
    inset: 0;
    z-index: 2;
    transform: scale(var(--msc, 1));
    transform-origin: 50% 46%;
    opacity: var(--mop, 1);
    will-change: transform, opacity;
  }

  .mark {
    position: absolute;
    left: 0;
    right: 0;
    top: 33%;
    margin: 0;
    display: block;
    text-align: center;
    font-family: var(--serif-cjk);
    font-size: clamp(64px, 13.5vw, 186px);
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0.06em;
    color: #665049;
    z-index: 2;
    transform: translate3d(0, var(--mty, 0px), 0);
    will-change: transform;
    scale: 1;
    transition: color 0.55s ease, scale 0.55s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  /* 中文名字下面那行拉丁文 —— 外国人看不懂上面三个字，
     这一行得紧跟着，不能让人多想一秒 */
  .mark-latin {
    display: block;
    margin-top: clamp(14px, 1.8vw, 26px);
    font-family: var(--display);
    font-size: clamp(13px, 1.5vw, 21px);
    letter-spacing: 0.42em;
    text-indent: 0.42em;
    text-transform: uppercase;
    color: #7c6058;
  }

  .mark:focus-visible { outline: 1px solid var(--accent); outline-offset: 14px; }

  /* 数字下面那行小字：桌面端不需要 —— 鼠标移上去会变色变大，已经说清楚了。
     触屏没有 hover，这个入口就完全没人知道，所以在手机上让它
     进来之后轻声说一句再消失：淡入、停三秒、淡出，之后画面回到干净。 */
  .mark-hint {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2.4em;
    font-family: var(--serif-cjk);
    font-size: 12px;
    font-weight: 300;
    letter-spacing: 0.3em;
    line-height: 1;
    color: #8a7370;
    opacity: 0;
    pointer-events: none;
  }

  @media (hover: none) and (prefers-reduced-motion: no-preference) {
    .mark-hint {
      animation: whisper 6.4s cubic-bezier(0.4, 0, 0.2, 1) 1.6s forwards;
    }
  }

  @keyframes whisper {
    0% { opacity: 0; transform: translateY(7px); }
    14% { opacity: 1; transform: none; }
    62% { opacity: 1; transform: none; }
    100% { opacity: 0; transform: translateY(-5px); }
  }

  /* 所有拼贴元素共用：真实投影，跟着裁剪的轮廓走 */
  .el {
    position: absolute;
    height: auto;
    filter: drop-shadow(0 1.4vmin 2.4vmin rgba(118, 94, 90, 0.26));
    transform: translate3d(var(--tx, 0px), var(--ty, 0px), 0)
      rotate(calc(var(--rot, 0deg) + var(--rw, 0deg))) scale(var(--sc, 1));
    will-change: transform;
