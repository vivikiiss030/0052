---
import { getCollection } from 'astro:content';
import { Image, Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';

import satin from '../assets/collage/satin.jpg';
import caladium from '../assets/collage/caladium.png';
import paleflower from '../assets/collage/paleflower.png';
import paleflower2 from '../assets/collage/paleflower2.png';
import uranus from '../assets/collage/uranus.png';
import nautilus from '../assets/collage/nautilus.png';
import star from '../assets/collage/star.png';
import moon from '../assets/collage/moon.png';
import moon2 from '../assets/collage/moon2.png';
import blueflower from '../assets/collage/blueflower.png';
import nightflower from '../assets/collage/nightflower.png';
import dagger from '../assets/collage/dagger.png';
import lilypad from '../assets/collage/lilypad.png';
import lilypad2 from '../assets/collage/lilypad2.png';
import lotus from '../assets/collage/lotus.png';
import begonia from '../assets/collage/begonia.png';
import starfish from '../assets/collage/starfish.png';
import orchid from '../assets/collage/orchid.png';
import cherub from '../assets/collage/cherub.png';
import planet from '../assets/collage/planet.png';
import moonlet from '../assets/collage/moonlet.png';
import butterflyEye from '../assets/collage/butterfly-eye.png';
import butterflyGold from '../assets/collage/butterfly-gold.png';
import butterflyGreen from '../assets/collage/butterfly-green.png';
import butterflyNight from '../assets/collage/butterfly-night.png';

// 拼贴元素：位置是相对第一屏的百分比，尺寸用 vw，所以整幅构图
// 会随窗口等比缩放，而不是散架。手机上另有一套（见下方 media query）。
// depth 决定视差幅度（越"近"动得越多），ph 是漂浮的相位差
const pieces = [
  { k: 'caladium', src: caladium, alt: '粉脉彩叶芋', d: 1.0, ph: 0.0 },
  { k: 'paleflower2', src: paleflower2, alt: '淡蓝色花', d: 0.35, ph: 1.7 },
  { k: 'paleflower', src: paleflower, alt: '浅蓝色花', d: 0.55, ph: 0.4 },
  { k: 'uranus', src: uranus, alt: '天王星', d: 0.3, ph: 2.9 },
  { k: 'butterflyEye', src: butterflyEye, alt: '孔雀蛱蝶', d: 0.45, ph: 1.1 },
  { k: 'star', src: star, alt: '金色星芒', d: 0.85, ph: 2.2 },
  { k: 'moon', src: moon, alt: '金色月牙', d: 0.7, ph: 0.8 },
  { k: 'blueflower', src: blueflower, alt: '蓝色花', d: 0.55, ph: 3.4 },
  { k: 'nightflower', src: nightflower, alt: '深蓝色花', d: 0.5, ph: 1.5 },
  { k: 'nautilus', src: nautilus, alt: '鹦鹉螺壳', d: 0.4, ph: 2.6 },
  { k: 'dagger', src: dagger, alt: '匕首', d: 0.95, ph: 0.3 },
  { k: 'lilypad', src: lilypad, alt: '荷叶', d: 0.8, ph: 1.9 },
  { k: 'lilypad2', src: lilypad2, alt: '荷叶', d: 0.6, ph: 3.1 },
  { k: 'lotus', src: lotus, alt: '粉色睡莲', d: 1.0, ph: 0.6 },
  { k: 'begonia', src: begonia, alt: '螺旋秋海棠叶', d: 0.6, ph: 2.4 },
  { k: 'starfish', src: starfish, alt: '海星', d: 0.6, ph: 1.3 },
  { k: 'orchid', src: orchid, alt: '绿色兰花', d: 0.5, ph: 0.9 },
  { k: 'cherub', src: cherub, alt: '金色小天使', d: 0.9, ph: 2.0 },
  { k: 'planet', src: planet, alt: '蓝色星球', d: 0.3, ph: 3.6 },
  { k: 'moon2', src: moon2, alt: '金色月牙', d: 0.35, ph: 1.2 },
  { k: 'moonlet', src: moonlet, alt: '月亮', d: 0.25, ph: 2.8 },
  { k: 'butterflyGold', src: butterflyGold, alt: '金色蝴蝶', d: 0.4, ph: 0.5 },
  { k: 'butterflyGreen', src: butterflyGreen, alt: '绿色凤蝶', d: 0.75, ph: 2.3 },
  { k: 'butterflyNight', src: butterflyNight, alt: '深蓝金纹蝴蝶', d: 0.5, ph: 1.6 },
];

// 八个感觉是 moodboard，不是分区。已经有东西落地的做成链接，
// 其余先留白 —— 等它们各自长出内容或设计元素再接上。
const feelings = [
  { cjk: '琥珀' },
  { cjk: '玻璃' },
  { cjk: '烟雾' },
  { cjk: '丝缎' },
  { cjk: '纯净水', href: '/volumes/chun-jing-shui/' },
  { cjk: '暮色' },
  { cjk: '刀' },
  { cjk: '暗夜', href: '/volumes/an-ye/' },
];

const covers = import.meta.glob('/src/assets/volumes/**/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG}');

const volumes = (await getCollection('volumes', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const essays = (await getCollection('essays', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);

const latest = volumes[0];
let latestCover = null;
if (latest && latest.data.photos.length) {
  const key = `/src/assets/volumes/${latest.id}/${latest.data.photos[0].file}`;
  if (covers[key]) latestCover = (await covers[key]()).default;
}

const fmt = (d) => `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}`;
---

<Base bare wide title={null}>
  <section class="hero">
    <Picture
      src={satin}
      formats={['avif', 'webp']}
      widths={[800, 1400, 2000]}
      sizes="100vw"
      alt=""
      loading="eager"
      class="ground"
    />

    <div class="stage">
      <div class="mark-wrap">
        <a href="/0052/" class="mark" aria-label="00:52 —— 这个网站从哪来">
          00:52<span class="mark-hint">关于这里 →</span>
        </a>
      </div>
      {
        pieces.map((p, i) => (
          <Image
            src={p.src}
            alt={p.alt}
            format="webp"
            quality={80}
            class={`el ${p.k}`}
            loading="eager"
            data-d={p.d}
            data-ph={p.ph}
            style={`--i:${i}`}
          />
        ))
      }
    </div>

    <div class="topbar">
      <span class="spacer"></span>
      <nav aria-label="主导航">
        <a href="/volumes/">如梦似幻</a>
        <a href="/essays/">头脑的温水</a>
        <a href="/about/">我由什么组成</a>
      </nav>
    </div>

    <div class="bottombar">
      <p class="feelings">
        {feelings.map((f) => (f.href ? <a href={f.href}>{f.cjk}</a> : <span>{f.cjk}</span>))}
      </p>
      <span class="label sig">V. &nbsp;/&nbsp; 2026</span>
    </div>
  </section>

  <div class="below">
  {
    latest && (
      <section class="wrap block">
        <div class="block-head">
          <span class="label">最新一辑 / Latest volume</span>
          <span class="label">{fmt(latest.data.date)}</span>
        </div>
        <hr class="rule" />
        <a href={`/volumes/${latest.id}/`} class="latest">
          {latestCover && (
            <Picture
              src={latestCover}
              formats={['avif', 'webp']}
              widths={[480, 960, 1440]}
              sizes="(max-width: 780px) 100vw, 62vw"
              alt={latest.data.photos[0].alt}
              loading="lazy"
            />
          )}
          <div class="latest-meta">
            <h2>{latest.data.title}</h2>
            {latest.data.place && <p class="place">{latest.data.place}</p>}
            <p class="count label">{latest.data.photos.length} 张</p>
          </div>
        </a>
      </section>
    )
  }

  {
    essays.length > 0 && (
      <section class="wrap block">
        <div class="block-head">
          <span class="label">近期文字 / Recent essays</span>
          <a href="/essays/" class="label more">
            全部 →
          </a>
        </div>
        <hr class="rule" />
        <ul class="essay-list">
          {essays.map((e) => (
            <li>
              <a href={`/essays/${e.id}/`}>
                <time class="label" datetime={e.data.date.toISOString()}>
                  {fmt(e.data.date)}
                </time>
                <h3>{e.data.title}</h3>
                {e.data.summary && <p class="summary">{e.data.summary}</p>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
  </div>
</Base>

<script>
  // 丝缎的动感：滚动视差 + 极慢的漂浮。
  // 两者都只改 transform，合成一个 rAF 循环，不触发重排。
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const stage = document.querySelector('.stage');
  const mark = document.querySelector('.mark');
  const markWrap = document.querySelector('.mark-wrap');
  const ground = document.querySelector('.ground');

  if (stage && !reduce) {
    const els = [...stage.querySelectorAll('.el')].map((el) => ({
      el,
      d: parseFloat(el.dataset.d || '0.5'),
      ph: parseFloat(el.dataset.ph || '0'),
    }));

    let sy = 0;
    let ticking = false;
    const onScroll = () => {
      sy = window.scrollY;
      if (!ticking) { ticking = true; requestAnimationFrame(() => { ticking = false; }); }
    };
    window.addEventListener('scroll', onScroll, { passive: true });

    const hero = document.querySelector('.hero');

    const loop = (now) => {
      const t = now * 0.001;
      // 第一屏滚出视野之后就不再计算
      const heroH = hero ? hero.offsetHeight : window.innerHeight;
      const active = sy < heroH + 240;
      if (active) {
        // 第一屏被钉住，用「滚过了多少」当进度，位移才不会飞出去
        const prog = Math.min(sy / heroH, 1);
        // 缓入缓出，让退后的过程不是线性的，更像呼气
        const ease = prog * prog * (3 - 2 * prog);

        for (const o of els) {
          // 漂浮：周期约 20 秒，幅度 8–24px
          const amp = 8 + o.d * 16;
          const fx = Math.sin(t * 0.3 + o.ph) * amp;
          const fy = Math.cos(t * 0.23 + o.ph) * amp * 0.75;
          // 视差：越「近」的元素随滚动上移越多
          const py = -prog * 220 * o.d;
          const px = Math.sin(o.ph) * prog * 26 * o.d;
          o.el.style.setProperty('--tx', (fx + px).toFixed(2) + 'px');
          o.el.style.setProperty('--ty', (fy + py).toFixed(2) + 'px');
          // 一起往后退一点，越近的退得越多
          o.el.style.setProperty('--sc', (1 - ease * 0.09 * o.d).toFixed(4));
        }

        if (markWrap) {
          // 呼吸：周期约 10 秒，幅度 1.7% —— 静止时数字自己也在起伏
          const breath = Math.sin(t * 0.62) * 0.017;
          markWrap.style.setProperty('--msc', (1 - ease * 0.24 + breath).toFixed(4));
          // 透明度也跟着呼吸走一点，起伏才看得见而不只是「大小在变」
          markWrap.style.setProperty('--mop', (1 - ease * 0.72 + (breath - 0.017) * 1.6).toFixed(3));
        }
        if (mark) {
          // 除了随滚动上移，再叠一层 5px 的缓慢浮动
          const mb = Math.sin(t * 0.62 + 1.1) * 5;
          mark.style.setProperty('--mty', (-prog * 70 + mb).toFixed(2) + 'px');
        }

        if (ground) {
          // 丝缎随滚动推近，并叠一层周期约 31 秒、幅度 1.3% 的极慢呼吸。
          // 底数 1.022 是为了让呼吸缩到最小时仍然 > 1，不会露出边。
          const gb = Math.sin(t * 0.2) * 0.013;
          ground.style.setProperty('--gsc', (1.022 + ease * 0.11 + gb).toFixed(4));
        }
      }
      requestAnimationFrame(loop);
    };
    requestAnimationFrame(loop);
  }

  // 下方区块进入视口时浮起
  const blocks = document.querySelectorAll('.block');
  if (blocks.length) {
    if (reduce || !('IntersectionObserver' in window)) {
      blocks.forEach((b) => b.classList.add('in'));
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
          });
        },
        { rootMargin: '0px 0px -12% 0px' }
      );
      blocks.forEach((b) => io.observe(b));
    }
  }
</script>

<style>
  /* ── 第一屏：丝缎为地的拼贴 ───────────────── */
  .hero {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
    background: #eadad4;
  }

  .ground {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(var(--gsc, 1));
    transform-origin: 50% 50%;
    will-change: transform;
  }

  .stage {
    position: absolute;
    inset: 0;
  }

  .mark-wrap {
    position: absolute;
    inset: 0;
    z-index: 2;
    transform: scale(var(--msc, 1));
    transform-origin: 50% 46%;
    opacity: var(--mop, 1);
    will-change: transform, opacity;
  }

  .mark {
    position: absolute;
    left: 0;
    right: 0;
    top: 33%;
    margin: 0;
    display: block;
    text-align: center;
    font-family: var(--display);
    font-size: clamp(88px, 17vw, 250px);
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0.005em;
    color: #665049;
    z-index: 2;
    transform: translate3d(0, var(--mty, 0px), 0);
    will-change: transform;
    transition: color 0.5s ease;
  }

  .mark:hover { color: #7d6055; }

  /* 数字底下的一行小字：平时不在，鼠标靠近才浮出来 ——
     不想让它变成一个「按钮」，只想让人知道这里可以按 */
  .mark-hint {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2.2em;
    font-family: var(--serif-cjk);
    font-size: 13px;
    font-weight: 300;
    letter-spacing: 0.3em;
    line-height: 1;
    color: #8a7370;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.5s ease, transform 0.5s cubic-bezier(0.22, 0.61, 0.36, 1);
    pointer-events: none;
  }

  .mark:hover .mark-hint,
  .mark:focus-visible .mark-hint {
    opacity: 1;
    transform: none;
  }

  .mark:focus-visible { outline: 1px solid var(--accent); outline-offset: 14px; }

  /* 所有拼贴元素共用：真实投影，跟着裁剪的轮廓走 */
  .el {
    position: absolute;
    height: auto;
    filter: drop-shadow(0 1.4vmin 2.4vmin rgba(118, 94, 90, 0.26));
    transform: translate3d(var(--tx, 0px), var(--ty, 0px), 0) rotate(var(--rot, 0deg))
      scale(var(--sc, 1));
    will-change: transform;
  }

  /* 进场：轻轻浮上来，错开时间 */
  @media (prefers-reduced-motion: no-preference) {
    .el,
    .mark {
      opacity: 0;
      animation: rise 1.1s cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
      animation-delay: calc(var(--i, 0) * 45ms);
    }
  }

  @keyframes rise {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  /* 右上一堆，切出画面 */
  .caladium { top: 6%; right: -4%; width: 29.6vmin; --rot: 13deg; z-index: 4; }
  .paleflower2 { top: 17%; left: 19%; width: 9.3vmin; --rot: 12deg; z-index: 3; }
  .paleflower { top: 18%; right: 11%; width: 12.8vmin; --rot: -8deg; z-index: 5; }
  .uranus { top: 27%; right: 6%; width: 7.4vmin; z-index: 4; }
  .butterflyEye { top: 34%; right: 1%; width: 13.6vmin; --rot: -14deg; z-index: 4; }

  /* 左上，月牙搭在第一个 0 的肩上 */
  .star { top: 10%; left: 14%; width: 12.2vmin; --rot: -10deg; z-index: 3; }
  .moon { top: 24%; left: 25%; width: 14.4vmin; --rot: -19deg; z-index: 5; }
  .blueflower { top: 33%; left: 12%; width: 9.9vmin; --rot: 16deg; z-index: 4; }
  .nightflower { top: 45%; left: 4%; width: 8.0vmin; --rot: -14deg; z-index: 3; }

  /* 鹦鹉螺嵌进 5 里 */
  .nautilus { top: 58%; left: 52%; width: 8.0vmin; --rot: 18deg; z-index: 6; }

  /* 左下，压住数字下缘的一堆 */
  .dagger { top: 3%; left: 41.7%; width: 26.4vmin; --rot: 69deg; z-index: 5; }
  .lilypad { top: 60%; left: 19%; width: 20.0vmin; --rot: 9deg; z-index: 4; }
  .lotus { top: 52%; left: 7%; width: 28.0vmin; --rot: -6deg; z-index: 5; }
  .lilypad2 { top: 70%; left: 84%; width: 13.8vmin; --rot: -11deg; z-index: 3; }
  .starfish { top: 70%; left: 2%; width: 12.0vmin; --rot: 20deg; z-index: 4; }
  .begonia { top: 75%; left: 28%; width: 13.6vmin; --rot: -16deg; z-index: 3; }

  /* 右下，小天使守着 2 */
  .cherub { top: 53%; left: 71%; width: 20.0vmin; --rot: -13deg; z-index: 5; }
  .planet { top: 63%; left: 87%; width: 6.4vmin; z-index: 4; }
  .moon2 { top: 43%; left: 86%; width: 7.4vmin; --rot: 26deg; z-index: 3; }
  .orchid { top: 76%; left: 60%; width: 10.4vmin; --rot: 10deg; z-index: 4; }
  .moonlet { top: 84%; left: 66%; width: 4.8vmin; z-index: 3; }

  /* 蝴蝶：停在几处留白上，方向各不相同，像刚落下 */
  .butterflyGold { top: 71%; left: 91%; width: 9.2vmin; --rot: 14deg; z-index: 4; }
  .butterflyGreen { top: 72%; left: 40%; width: 13.2vmin; --rot: -9deg; z-index: 5; }
  .butterflyNight { top: 6%; left: 31%; width: 9.0vmin; --rot: 19deg; z-index: 4; }

  /* 上下两条 */
  .topbar,
  .bottombar {
    position: absolute;
    left: clamp(20px, 3.4vw, 48px);
    right: clamp(20px, 3.4vw, 48px);
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    z-index: 8;
  }

  .topbar { top: 30px; }
  .bottombar { bottom: 40px; align-items: flex-end; }

  .topbar nav {
    display: flex;
    gap: clamp(16px, 2.4vw, 34px);
    font-family: var(--serif-cjk);
    font-size: clamp(13px, 1.05vw, 15px);
    letter-spacing: 0.14em;
    color: #5e4b47;
  }

  .topbar nav a:hover { color: var(--accent); }

  .feelings {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: clamp(12px, 1.8vw, 26px);
    font-family: var(--serif-cjk);
    font-size: clamp(12px, 0.98vw, 14px);
    font-weight: 300;
    letter-spacing: 0.2em;
    color: #8a7370;
  }

  .feelings a {
    border-bottom: 1px solid transparent;
    padding-bottom: 3px;
    transition: color 0.3s, border-color 0.3s;
  }

  .feelings a:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  .feelings span { opacity: 0.55; }

  .sig { color: #9c8983; }

  /* 下方区块：进入视口时浮起 */
  .block {
    opacity: 0;
    transform: translateY(26px);
    transition: opacity 0.9s cubic-bezier(0.22, 0.61, 0.36, 1),
      transform 0.9s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .block.in { opacity: 1; transform: none; }

  @media (prefers-reduced-motion: reduce) {
    .block { opacity: 1; transform: none; transition: none; }
  }

  /* ── 手机：只留八个元素，重新摆位 ───────────── */
  @media (max-width: 780px) {
    .mark { top: 33%; font-size: 23vw; }

    .el { filter: drop-shadow(0 3vw 5vw rgba(118, 94, 90, 0.24)); }

    .paleflower2, .paleflower, .nightflower, .star,
    .lilypad2, .begonia, .orchid, .moon2,
    .moonlet, .planet, .butterflyGold {
      display: none;
    }

    .butterflyEye { top: 38%; right: -6%; width: 26vw; }
    .butterflyGreen { top: 78%; left: 6%; width: 26vw; }
    .butterflyNight { top: 8%; left: 8%; width: 20vw; }

    .caladium { top: 4%; right: -24%; width: 44vw; }
    .moon { top: 30%; left: 2%; width: 25vw; }
    .blueflower { top: 47%; left: 5%; width: 21vw; }
    .uranus { top: 49%; right: 6%; width: 13vw; }
    .nautilus { top: 51%; left: 57%; width: 16vw; }
    .dagger { top: 16%; left: 35%; width: 32vw; }
    .lilypad { top: 70%; left: 34%; width: 30vw; }
    .lotus { top: 63%; left: -10%; width: 57vw; }
    .cherub { top: 68%; left: 55%; width: 38vw; }

    .topbar { top: 22px; flex-direction: column; align-items: flex-start; gap: 6px; }
    .bottombar { bottom: 26px; flex-direction: column; align-items: flex-start; gap: 10px; }
    .feelings { font-size: 13px; gap: 12px 16px; }
  }

  /* ── 第一屏之下：一块从下方升起、盖住第一屏的面板 ── */
  .below {
    position: relative;
    z-index: 5;
    background: var(--ground);
