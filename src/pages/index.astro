---
import { getCollection } from 'astro:content';
import { Image, Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';

import satin from '../assets/collage/satin.jpg';
import caladium from '../assets/collage/caladium.png';
import paleflower from '../assets/collage/paleflower.png';
import paleflower2 from '../assets/collage/paleflower2.png';
import uranus from '../assets/collage/uranus.png';
import nautilus from '../assets/collage/nautilus.png';
import nautilus2 from '../assets/collage/nautilus2.png';
import nautilus3 from '../assets/collage/nautilus3.png';
import star from '../assets/collage/star.png';
import moon from '../assets/collage/moon.png';
import moon2 from '../assets/collage/moon2.png';
import blueflower from '../assets/collage/blueflower.png';
import nightflower from '../assets/collage/nightflower.png';
import dagger from '../assets/collage/dagger.png';
import lilypad from '../assets/collage/lilypad.png';
import lilypad2 from '../assets/collage/lilypad2.png';
import lotus from '../assets/collage/lotus.png';
import begonia from '../assets/collage/begonia.png';
import starfish from '../assets/collage/starfish.png';
import orchid from '../assets/collage/orchid.png';
import cherub from '../assets/collage/cherub.png';
import planet from '../assets/collage/planet.png';
import moonlet from '../assets/collage/moonlet.png';

// 拼贴元素：位置是相对第一屏的百分比，尺寸用 vw，所以整幅构图
// 会随窗口等比缩放，而不是散架。手机上另有一套（见下方 media query）。
const pieces = [
  { k: 'caladium', src: caladium, alt: '粉脉彩叶芋' },
  { k: 'paleflower2', src: paleflower2, alt: '淡蓝色花' },
  { k: 'paleflower', src: paleflower, alt: '浅蓝色花' },
  { k: 'uranus', src: uranus, alt: '天王星' },
  { k: 'nautilus2', src: nautilus2, alt: '鹦鹉螺壳' },
  { k: 'star', src: star, alt: '金色星芒' },
  { k: 'moon', src: moon, alt: '金色月牙' },
  { k: 'blueflower', src: blueflower, alt: '蓝色花' },
  { k: 'nightflower', src: nightflower, alt: '深蓝色花' },
  { k: 'nautilus', src: nautilus, alt: '鹦鹉螺壳' },
  { k: 'dagger', src: dagger, alt: '匕首' },
  { k: 'lilypad', src: lilypad, alt: '荷叶' },
  { k: 'lilypad2', src: lilypad2, alt: '荷叶' },
  { k: 'lotus', src: lotus, alt: '粉色睡莲' },
  { k: 'begonia', src: begonia, alt: '螺旋秋海棠叶' },
  { k: 'starfish', src: starfish, alt: '海星' },
  { k: 'orchid', src: orchid, alt: '绿色兰花' },
  { k: 'cherub', src: cherub, alt: '金色小天使' },
  { k: 'planet', src: planet, alt: '蓝色星球' },
  { k: 'moon2', src: moon2, alt: '金色月牙' },
  { k: 'moonlet', src: moonlet, alt: '月亮' },
  { k: 'nautilus3', src: nautilus3, alt: '鹦鹉螺壳' },
];

const feelings = [
  { id: 'amber', cjk: '琥珀' },
  { id: 'glass', cjk: '玻璃' },
  { id: 'smoke', cjk: '烟雾' },
  { id: 'satin', cjk: '丝缎' },
  { id: 'water', cjk: '纯净水' },
  { id: 'dusk', cjk: '暮色' },
  { id: 'blade', cjk: '刀' },
  { id: 'night', cjk: '暗夜' },
];

const covers = import.meta.glob('/src/assets/volumes/**/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG}');

const volumes = (await getCollection('volumes', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const essays = (await getCollection('essays', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);

const latest = volumes[0];
let latestCover = null;
if (latest && latest.data.photos.length) {
  const key = `/src/assets/volumes/${latest.id}/${latest.data.photos[0].file}`;
  if (covers[key]) latestCover = (await covers[key]()).default;
}

const fmt = (d) => `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}`;
---

<Base bare title={null}>
  <section class="hero">
    <Picture
      src={satin}
      formats={['avif', 'webp']}
      widths={[800, 1400, 2000]}
      sizes="100vw"
      alt=""
      loading="eager"
      class="ground"
    />

    <div class="stage">
      <p class="mark">00:52</p>
      {
        pieces.map((p) => (
          <Image src={p.src} alt={p.alt} format="webp" quality={80} class={`el ${p.k}`} loading="eager" />
        ))
      }
    </div>

    <div class="topbar">
      <span class="label">night istill young</span>
      <nav aria-label="主导航">
        <a href="/volumes/">幻影</a>
        <a href="/essays/">头脑的温水</a>
        <a href="/about/">我由什么组成</a>
      </nav>
    </div>

    <div class="bottombar">
      <p class="feelings">{feelings.map((f) => <span>{f.cjk}</span>)}</p>
      <span class="label sig">V. &nbsp;/&nbsp; 2026</span>
    </div>
  </section>

  {
    latest && (
      <section class="wrap block">
        <div class="block-head">
          <span class="label">最新一辑 / Latest volume</span>
          <span class="label">{fmt(latest.data.date)}</span>
        </div>
        <hr class="rule" />
        <a href={`/volumes/${latest.id}/`} class="latest">
          {latestCover && (
            <Picture
              src={latestCover}
              formats={['avif', 'webp']}
              widths={[480, 960, 1440]}
              sizes="(max-width: 780px) 100vw, 62vw"
              alt={latest.data.photos[0].alt}
              loading="lazy"
            />
          )}
          <div class="latest-meta">
            <h2>{latest.data.title}</h2>
            {latest.data.place && <p class="place">{latest.data.place}</p>}
            <p class="count label">{latest.data.photos.length} 张</p>
          </div>
        </a>
      </section>
    )
  }

  {
    essays.length > 0 && (
      <section class="wrap block">
        <div class="block-head">
          <span class="label">近期文字 / Recent essays</span>
          <a href="/essays/" class="label more">
            全部 →
          </a>
        </div>
        <hr class="rule" />
        <ul class="essay-list">
          {essays.map((e) => (
            <li>
              <a href={`/essays/${e.id}/`}>
                <time class="label" datetime={e.data.date.toISOString()}>
                  {fmt(e.data.date)}
                </time>
                <h3>{e.data.title}</h3>
                {e.data.summary && <p class="summary">{e.data.summary}</p>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>

<style>
  /* ── 第一屏：丝缎为地的拼贴 ───────────────── */
  .hero {
    position: relative;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
    background: #eadad4;
  }

  .ground {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .stage {
    position: absolute;
    inset: 0;
  }

  .mark {
    position: absolute;
    left: 0;
    right: 0;
    top: 33%;
    margin: 0;
    text-align: center;
    font-family: var(--display);
    font-size: clamp(88px, 17vw, 250px);
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0.005em;
    color: #665049;
    z-index: 2;
  }

  /* 所有拼贴元素共用：真实投影，跟着裁剪的轮廓走 */
  .el {
    position: absolute;
    height: auto;
    filter: drop-shadow(0 1.4vw 2.4vw rgba(118, 94, 90, 0.26));
  }

  /* 右上一堆，切出画面 */
  .caladium { top: 6%; right: -4%; width: 29.6vmin; transform: rotate(13deg); z-index: 4; }
  .paleflower2 { top: 17%; left: 19%; width: 9.3vmin; transform: rotate(12deg); z-index: 3; }
  .paleflower { top: 18%; right: 11%; width: 12.8vmin; transform: rotate(-8deg); z-index: 5; }
  .uranus { top: 27%; right: 6%; width: 7.4vmin; z-index: 4; }
  .nautilus2 { top: 39%; right: 3%; width: 5.6vmin; transform: rotate(-24deg); z-index: 4; }

  /* 左上，月牙搭在第一个 0 的肩上 */
  .star { top: 5%; left: 8%; width: 12.2vmin; transform: rotate(-10deg); z-index: 3; }
  .moon { top: 24%; left: 25%; width: 14.4vmin; transform: rotate(-19deg); z-index: 5; }
  .blueflower { top: 33%; left: 12%; width: 9.9vmin; transform: rotate(16deg); z-index: 4; }
  .nightflower { top: 45%; left: 4%; width: 8.0vmin; transform: rotate(-14deg); z-index: 3; }

  /* 鹦鹉螺嵌进 5 里 */
  .nautilus { top: 58%; left: 52%; width: 8.0vmin; transform: rotate(18deg); z-index: 6; }

  /* 左下，压住数字下缘的一堆 */
  .dagger { top: 3%; left: 41.7%; width: 26.4vmin; transform: rotate(69deg); z-index: 5; }
  .lilypad { top: 60%; left: 19%; width: 20.0vmin; transform: rotate(9deg); z-index: 4; }
  .lotus { top: 52%; left: 7%; width: 28.0vmin; transform: rotate(-6deg); z-index: 5; }
  .lilypad2 { top: 70%; left: 84%; width: 13.8vmin; transform: rotate(-11deg); z-index: 3; }
  .starfish { top: 78%; left: 2%; width: 12.0vmin; transform: rotate(20deg); z-index: 4; }
  .begonia { top: 75%; left: 28%; width: 13.6vmin; transform: rotate(-16deg); z-index: 3; }

  /* 右下，小天使守着 2 */
  .cherub { top: 53%; left: 71%; width: 20.0vmin; transform: rotate(-13deg); z-index: 5; }
  .planet { top: 63%; left: 87%; width: 6.4vmin; z-index: 4; }
  .moon2 { top: 43%; left: 86%; width: 7.4vmin; transform: rotate(26deg); z-index: 3; }
  .orchid { top: 76%; left: 60%; width: 10.4vmin; transform: rotate(10deg); z-index: 4; }
  .nautilus3 { top: 82%; left: 93%; width: 5.1vmin; transform: rotate(8deg); z-index: 3; }
  .moonlet { top: 88%; left: 69%; width: 4.8vmin; z-index: 3; }

  /* 上下两条 */
  .topbar,
  .bottombar {
    position: absolute;
    left: clamp(20px, 3.4vw, 48px);
    right: clamp(20px, 3.4vw, 48px);
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    z-index: 8;
  }

  .topbar { top: 30px; }
  .bottombar { bottom: 40px; align-items: flex-end; }

  .topbar nav {
    display: flex;
    gap: clamp(16px, 2.4vw, 34px);
    font-family: var(--serif-cjk);
    font-size: clamp(13px, 1.05vw, 15px);
    letter-spacing: 0.14em;
    color: #5e4b47;
  }

  .topbar nav a:hover { color: var(--accent); }

  .feelings {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: clamp(12px, 1.8vw, 26px);
    font-family: var(--serif-cjk);
    font-size: clamp(12px, 0.98vw, 14px);
    font-weight: 300;
    letter-spacing: 0.2em;
    color: #8a7370;
  }

  .sig { color: #9c8983; }

  /* ── 手机：只留八个元素，重新摆位 ───────────── */
  @media (max-width: 780px) {
    .mark { top: 33%; font-size: 23vw; }

    .el { filter: drop-shadow(0 3vw 5vw rgba(118, 94, 90, 0.24)); }

    .paleflower2, .paleflower, .nautilus2, .nightflower, .star,
    .lilypad2, .begonia, .orchid, .moon2, .nautilus3,
    .moonlet, .planet {
      display: none;
    }

    .caladium { top: 4%; right: -24%; width: 44vw; }
    .moon { top: 30%; left: 2%; width: 25vw; }
    .blueflower { top: 47%; left: 5%; width: 21vw; }
    .uranus { top: 49%; right: 6%; width: 13vw; }
    .nautilus { top: 51%; left: 57%; width: 16vw; }
    .dagger { top: 16%; left: 35%; width: 32vw; }
    .lilypad { top: 70%; left: 34%; width: 30vw; }
    .lotus { top: 63%; left: -10%; width: 57vw; }
    .cherub { top: 68%; left: 55%; width: 38vw; }

    .topbar { top: 22px; flex-direction: column; align-items: flex-start; gap: 6px; }
    .bottombar { bottom: 26px; flex-direction: column; align-items: flex-start; gap: 10px; }
    .feelings { font-size: 13px; gap: 12px 16px; }
  }

  /* ── 第一屏之下 ───────────────────────────── */
  .block { margin-top: 120px; }

  .block-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 18px;
  }

  .more:hover { color: var(--accent); }

  .latest { display: block; margin-top: 36px; }

  .latest img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .latest-meta {
    display: flex;
    align-items: baseline;
    gap: 20px;
    flex-wrap: wrap;
    margin-top: 20px;
  }

  .latest-meta h2 {
    margin: 0;
    font-family: var(--serif-cjk);
    font-size: 21px;
    font-weight: 400;
    letter-spacing: 0.08em;
  }

  .place { margin: 0; font-size: 13px; color: var(--ink-soft); letter-spacing: 0.08em; }
  .count { margin: 0; margin-left: auto; }
  .latest:hover h2 { color: var(--accent); }

  .essay-list { list-style: none; margin: 0; padding: 0; }
  .essay-list li { border-bottom: 1px solid var(--rule); }

  .essay-list a {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: 24px;
    align-items: baseline;
    padding-block: 26px;
  }

  .essay-list h3 {
    margin: 0;
    font-family: var(--serif-cjk);
    font-size: 19px;
    font-weight: 400;
    letter-spacing: 0.06em;
  }

  .essay-list .summary {
    grid-column: 2;
    margin: 8px 0 0;
    font-family: var(--serif-cjk);
    font-size: 14px;
    font-weight: 300;
    line-height: 1.9;
    color: var(--ink-soft);
    max-width: 44em;
  }

  .essay-list a:hover h3 { color: var(--accent); }

  @media (max-width: 640px) {
    .block { margin-top: 80px; }
    .essay-list a { grid-template-columns: 1fr; gap: 6px; }
    .essay-list .summary { grid-column: 1; }
  }
</style>
