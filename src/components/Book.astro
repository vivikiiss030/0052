---
// 「预约」：英文版直接去 IG 私信；中文版弹出一张微信卡片。
// variant="nav" 是导航里的一个词，"cta" 是一个大按钮 —— 一张拼贴：
// 牛皮纸信封 + 一张旧便笺 + 揉皱的红纸心 + 一小段红胶带（Vicky 找的素材，抠了底），
// 字写在便笺上，跟着便笺一起歪。
import { Image } from 'astro:assets';
import { T, ui } from '../lib/site.js';
import note from '../assets/collage/envelope-note.png';
const { lang = 'en', variant = 'nav' } = Astro.props;
const { book } = T[lang];
const u = ui[lang];
const ig = lang === 'en' ? book.cta : null;
// 便笺上写的字（note / noteDetail，在 site.js 里改）
const label = book.cta.note ?? book.cta.label;
const detail = book.cta.noteDetail ?? book.cta.detail;
const Tag = ig ? 'a' : 'button';
const attrs = ig
  ? { href: ig.href, target: '_blank', rel: 'me noopener' }
  : { type: 'button', 'data-sheet-open': true };
---

{variant === 'nav' ? (
  <Tag class="book book-nav" {...attrs}>{u.book}</Tag>
) : (
  <Tag class="book book-cta" {...attrs}>
    <Image src={note} alt="" width={498} densities={[1, 2]} format="webp" quality={85} class="note-img" />
    <span class="note-text">
      <span class="note-label">{label}</span>
      <span class="note-handle">{detail}</span>
    </span>
  </Tag>
)}

<style>
  .book { font: inherit; color: inherit; background: none; border: 0; padding: 0; cursor: pointer; }
  .book-nav { border-bottom: 1px solid rgba(94, 75, 71, 0.4); padding-bottom: 2px; transition: color 0.3s, border-color 0.3s; }
  .book-nav:hover { color: var(--accent); border-bottom-color: var(--accent); }

  /* ── 拼贴信封 ─────────────────────────────────────── */
  .book-cta {
    position: relative;
    display: inline-block;
    width: min(78vw, 320px);
    aspect-ratio: 498 / 499;
    color: #3a2a1d;
    text-align: center;
    transform: rotate(2deg);
    transition: transform 0.5s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .book-cta :global(.note-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 12px 16px rgba(96, 60, 48, 0.22));
  }

  /* 字写在便笺上：便笺中心约在图的 (48%, 63%)，自己往左歪了约 7°（加上整体的 2°） */
  .note-text {
    position: absolute;
    left: 48%;
    top: 63%;
    width: 72%;
    transform: translate(-50%, -50%) rotate(-7.5deg);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }

  .note-label {
    font-family: var(--didot);
    font-style: italic;
    font-size: clamp(17px, 1.55vw, 21px);
    line-height: 1.2;
    color: #4a2a1e;
  }
  .note-label:lang(zh) { font-family: 'PingFang SC', var(--cjk); font-style: normal; font-weight: 500; letter-spacing: 0.14em; }

  .note-handle {
    font-family: var(--sans);
    font-size: 11px;
    letter-spacing: 0.22em;
    color: #8e2a22;
  }
  .note-handle:lang(zh) { letter-spacing: 0.12em; font-size: 12px; }

  .book-cta:hover,
  .book-cta:focus-visible { transform: rotate(0deg) translateY(-5px) scale(1.02); }
  .book-cta:focus-visible { outline: 1px solid var(--accent); outline-offset: 6px; }
</style>
