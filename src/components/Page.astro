---
// 四个内容页共用的外壳：顶上一条丝缎（和首页连着），左上角回首页，
// 中间是这一页的内容，最底下「预约」+「下一页」。
import { Image, Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import LangToggle from './LangToggle.astro';
import Book from './Book.astro';
import TarotCard from './TarotCard.astro';
import WeChatSheet from './WeChatSheet.astro';
import satin from '../assets/collage/satin.jpg';
// 每页一组 zen 拼贴（Vicky 找的素材，抠了底）
import zPink from '../assets/zen/buddha-pink.png';
import kidGrass from '../assets/zen/kid-grass.png';
import kidRed from '../assets/zen/kid-red.png';
import zFan from '../assets/zen/fan.png';
import zBird from '../assets/zen/hummingbird.png';
import zMoon from '../assets/collage/moon-sepia.png';
import zOrchidPale from '../assets/zen/orchid-pale.png';
import zLeafPale from '../assets/collage/pale-leaf.png';
import zStarGold from '../assets/zen/star-gold.png';
import zEyes from '../assets/zen/buddha-eyes.png';
import zHand from '../assets/zen/hand-spiral.png';
import zLotusBuddha from '../assets/zen/buddha-lotus.png';
import zOrchid from '../assets/zen/orchid-pink.png';
import zLily from '../assets/zen/lily-pale.png';
import zFrog from '../assets/zen/frog.png';
import { T, layouts, W, H, order, pageMeta, ui, url, hl } from '../lib/site.js';

const { lang = 'en', page } = Astro.props;
const { site, nameStory, about, how, readings, readingsNote, book } = T[lang];
const pm = pageMeta[lang];
const u = ui[lang];
const me = pm[page];
const idx = order.indexOf(page);
const nextKey = order[idx + 1];
const prevKey = idx > 0 ? order[idx - 1] : null;
const prev = prevKey ? { href: url(lang, prevKey), label: pm[prevKey].title } : { href: `${url(lang)}#space`, label: 'The Open Space' };
const next = nextKey ? { href: url(lang, nextKey), label: pm[nextKey].title } : { href: url(lang), label: u.backToStart };
const otherLang = lang === 'en' ? 'zh' : 'en';
---

<Base bare wide sheen nofoot lang={lang} alt={`/${page}/`} title={`${me.title} · The Open Space ${site.cjk}`} description={site.tagline}>
  <header class="strip">
    <Picture src={satin} formats={['avif', 'webp']} widths={[800, 1400, 2000]} sizes="100vw" alt="" loading="eager" class="strip-bg" />
    <div class="strip-bar">
      <a class="back" href={url(lang)}><span class="back-arrow" aria-hidden="true">←</span> {u.home}</a>
      <nav class="pnav" aria-label="Pages">
        {order.map((k) => (
          <a href={url(lang, k)} aria-current={k === page ? 'page' : undefined}>{pm[k].nav}</a>
        ))}
        <span class="lt-wrap"><LangToggle lang={lang} href={url(otherLang, page)} /></span>
        <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mmenu" data-open={lang === 'en' ? 'Close' : '收起'} data-closed={lang === 'en' ? 'Menu' : '目录'}>{lang === 'en' ? 'Menu' : '目录'}</button>
      </nav>
    </div>
    <div class="strip-title">
      <p class="strip-n">{me.n}</p>
      <h1 class="strip-h">{me.title}</h1>
    </div>
  </header>

  <!-- 手机上的小目录：点右上角「Menu / 目录」从顶上滑下来 -->
  <div class="mmenu" id="mmenu" aria-hidden="true">
    <ol class="mmenu-list">
      {order.map((k) => (
        <li><a href={url(lang, k)} tabindex="-1" aria-current={k === page ? 'page' : undefined}><span class="mm-n">{pm[k].n}</span>{pm[k].title}</a></li>
      ))}
    </ol>
  </div>
  <div class="mmenu-veil" aria-hidden="true"></div>

  <div class="below">
    {page === 'about' && (
    <section class="wrap block" id="content">
      <Image src={zPink} alt="" width={420} format="webp" quality={82} class="zen z-about-buddha" />
      <Image src={zFrog} alt="" width={300} format="webp" quality={84} class="zen z-about-frog" />
      <div class="two">
        <div class="about-l">
          <h2 class="cjk-title about-title">{about.title}</h2>
          <!-- 小时候的照片：剪下来、带白边，像贴在本子上 -->
          <div class="kids">
            <Image src={kidGrass} alt={lang === 'en' ? 'Vicky as a little girl, running on the grass' : '小时候的 Vicky，在草地上跑'} width={420} densities={[1, 2]} format="webp" quality={84} class="kid kid-a" />
            <Image src={kidRed} alt={lang === 'en' ? 'Vicky as a toddler, laughing in a red coat' : '小时候的 Vicky，穿红棉袄大笑'} width={340} densities={[1, 2]} format="webp" quality={84} class="kid kid-b" />
            <span class="kids-cap">mini vicky</span>
          </div>
          <!-- 一句主张，带一对大引号 -->
          <blockquote class="about-quote"><p>{lang === 'zh' ? about.body.split('，').map((t, j, arr) => <>{t}{j < arr.length - 1 && <>，<br /></>}</>) : about.body}</p></blockquote>
        </div>
        <div class="about-r">
          <ul class="tags">
            {about.tags.map((t) => <li>{t}</li>)}
          </ul>
          <div class="prose-t about-story">{about.story.map((t) => <p set:html={hl(t)} />)}</div>
          <p class="motto">{about.motto}</p>
        </div>
      </div>
    </section>
    )}

    {page === 'guide' && (
    <section class="wrap block" id="content">
      <Image src={zFan} alt="" width={380} format="webp" quality={82} class="zen z-guide-fan" />
      <Image src={zEyes} alt="" width={320} format="webp" quality={82} class="zen z-guide-eyes" />
      <Image src={zHand} alt="" width={240} format="webp" quality={82} class="zen z-guide-hand" />
      <h2 class="stance how-title">{how.title[0]}<br /><i>{how.title[1]}</i></h2>
      <ol class="rules">
        {how.items.map((it, i) => (
          <li>
            <span class="rules-n">{String(i + 1).padStart(2, '0')}</span>
            <h3>{it.t}</h3>
            {it.b.map((t) => <p set:html={hl(t)} />)}
          </li>
        ))}
      </ol>
    </section>
    )}

    {page === 'readings' && (
    <section class="wrap block" id="content">
      <Image src={zOrchid} alt="" width={320} format="webp" quality={82} class="zen z-read-orchid" />
      <ul class="svcs">
        {readings.map((r, i) => (
          <li class="svc">
            {i === 0 && <Image src={zLotusBuddha} alt="" width={440} format="webp" quality={82} class="zen z-read-buddha" />}
            {i === 1 && <Image src={zLily} alt="" width={320} format="webp" quality={82} class="zen z-read-lily" />}
            <!-- 一圈手绘花枝：四边是带叶子的花茎，四个角是马蹄莲 -->
            <span class="vine" aria-hidden="true"><i class="v-t"></i><i class="v-b"></i><i class="v-l"></i><i class="v-r"></i><i class="c c-tl"></i><i class="c c-tr"></i><i class="c c-bl"></i><i class="c c-br"></i></span>
            <button class="svc-head" type="button" aria-expanded="false" aria-controls={`svc-${i}`} data-open={r.toggle[1]} data-closed={r.toggle[0]}>
              <span class="rn">{r.n}</span>
              <span class="svc-title">
                <h3>{r.name}</h3>
                <span class="svc-note">{r.note}</span>
              </span>
              <span class="rmeta">
                <span class="rlen label">{r.len}</span>
                <span class="rprice">{r.price.replace(/\s*起$/, '')}{/起$/.test(r.price) && <span class="rprice-from"> 起</span>}</span>
              </span>
              <span class="svc-toggle">
                <span class="svc-toggle-t">{r.toggle[0]}</span>
                <span class="plus" aria-hidden="true"></span>
              </span>
            </button>
            <div class="svc-body" id={`svc-${i}`}>
              <div class="svc-inner">
                {r.spreads && (
                  <ul class="spreads">
                    {r.spreads.map((sp) => (
                      <li class="spread">
                        <svg class="sv" viewBox={layouts[sp.lay].vb.join(' ')} width={Math.round(layouts[sp.lay].vb[2] * Math.min(1.15, 92 / layouts[sp.lay].vb[3]))} height={Math.round(layouts[sp.lay].vb[3] * Math.min(1.15, 92 / layouts[sp.lay].vb[3]))} aria-hidden="true">
                          {layouts[sp.lay].cards.map(([x, y, side], j) => {
                            const w = side ? H : W, h = side ? W : H;
                            return (
                              <g style={`--j:${j}`}>
                                <!-- 牌背：蓝底八角星（横放的牌转 90°） -->
                                <g transform={side ? `rotate(90 ${x} ${y})` : undefined}>
                                  <rect class="sv-edge" x={x - W / 2} y={y - H / 2} width={W} height={H} rx="0.8" />
                                  <image href="/card-back.jpg" x={x - W / 2 + 0.7} y={y - H / 2 + 0.7} width={W - 1.4} height={H - 1.4} preserveAspectRatio="xMidYMid slice" />
                                </g>
                              </g>
                            );
                          })}
                        </svg>
                        <span class="sp-main">
                          <span class="sp-name">
                            {sp.name}
                          </span>
                          <span class="sp-pos">{sp.pos}</span>
                          <span class="sp-for">{sp.for}</span>
                        </span>
                        <span class="sp-side">
                          <span class="sp-k">{sp.kl ?? sp.k}<small>{lang === 'en' ? ' cards' : ' 张'}</small></span>
                          {sp.price && <span class="sp-price">{sp.price}</span>}
                          <span class="sp-tag">{sp.tag}</span>
                        </span>
                      </li>
                    ))}
                  </ul>
                )}
                {r.points && (
                  <div class="healing">
                    <ul class="points">
                      {r.points.map((p) => <li>{p}</li>)}
                    </ul>
                    <p class="healing-after">{r.after}</p>
                  </div>
                )}
              </div>
            </div>
          </li>
        ))}
      </ul>
      <p class="menu-note">{readingsNote}</p>
    </section>
    )}

    <!-- 最底下：预约 + 下一页 -->
    {page === 'readings' && (
      <section class="wrap book-block">
        <!-- 信封旁边的一小撮拼贴：蜂鸟衔信飞来，旧月亮挂在右上，兰花和叶子垫在下面 -->
        <Image src={zMoon} alt="" width={320} format="webp" quality={82} class="zen zb-moon" />
        <Image src={zBird} alt="" width={340} format="webp" quality={84} class="zen zb-bird" />
        <Image src={zOrchidPale} alt="" width={320} format="webp" quality={82} class="zen zb-orchid" />
        <Image src={zLeafPale} alt="" width={280} format="webp" quality={82} class="zen zb-leaf" />
        <Image src={zStarGold} alt="" width={90} format="webp" quality={85} class="zen zb-star" />
        <div class="end-book">
          <h2 class="stance end-title">{book.title}</h2>
          <p class="prose-t end-body">{book.body}</p>
          <Book lang={lang} variant="cta" />
        </div>
      </section>
    )}

    <!-- 最底下：左边一张「返回上一张」，右边一张「翻开下一张」。鼠标移上去（手机上点一下）翻开，再点就进去 -->
    <section class="wrap endbar">
      <a class="next is-prev" href={prev.href} data-flip data-k={prevKey ? order.indexOf(prevKey) : 3}>
        <span class="next-k label">{lang === 'en' ? 'Back to the last card' : '返回上一张'}</span>
        <span class="flip">
          <span class="flip-in">
            <span class="flip-back" aria-hidden="true"></span>
            {prevKey ? (
              <span class="flip-front is-card">
                <TarotCard k={order.indexOf(prevKey)} title={pm[prevKey].title} class="is-mini" />
              </span>
            ) : (
              <span class="flip-front is-home">
                <img src="/home-thumb.jpg" alt="" loading="lazy" />
              </span>
            )}
          </span>
        </span>
      </a>
      <a class="next" href={next.href} data-flip data-k={nextKey ? order.indexOf(nextKey) : 3}>
        <span class="next-k label">{lang === 'en' ? (nextKey ? 'Draw the next card' : 'Back to the start') : (nextKey ? '翻开下一张' : '回到首页')}</span>
        <span class="flip">
          <span class="flip-in">
            <span class="flip-back" aria-hidden="true"></span>
            {nextKey ? (
              <span class="flip-front is-card">
                <TarotCard k={order.indexOf(nextKey)} title={pm[nextKey].title} class="is-mini" />
              </span>
            ) : (
              <span class="flip-front is-home">
                <img src="/home-thumb.jpg" alt="" loading="lazy" />
              </span>
            )}
          </span>
        </span>
      </a>
    </section>
  </div>

  {lang === 'zh' && <WeChatSheet />}
</Base>

<script>
  // 下一页：电脑上鼠标移上去就翻开；手机上第一下翻开，第二下进去。进去时翻开的牌朝你放大。
  document.querySelectorAll('a[data-flip]').forEach((a) => {
    const touch = window.matchMedia('(hover: none)').matches;
    a.addEventListener('click', (e) => {
      if (e.metaKey || e.ctrlKey || e.shiftKey) return;
      if (touch && !a.classList.contains('is-flipped')) { e.preventDefault(); a.classList.add('is-flipped'); return; }
      const card = a.querySelector('.flip');
      if (!card || window.matchMedia('(prefers-reduced-motion: reduce)').matches || !Element.prototype.animate) return;
      e.preventDefault();
      a.classList.add('is-flipped');
      const r = card.getBoundingClientRect();
      const fly = card.cloneNode(true);
      fly.classList.add('next-fly');
      Object.assign(fly.style, { left: `${r.left}px`, top: `${r.top}px`, width: `${r.width}px`, height: `${r.height}px`, transform: 'none' });
      fly.querySelector('.flip-in').style.transform = 'rotateY(180deg)';
      fly.querySelector('.flip-in').style.transition = 'none';
      const veil = document.createElement('div');
      veil.className = 'next-veil';
      document.body.append(veil, fly);
      card.style.visibility = 'hidden';
      const S = Math.max(innerWidth / r.width, innerHeight / r.height) * 1.2;
      const dx = innerWidth / 2 - (r.left + r.width / 2), dy = innerHeight / 2 - (r.top + r.height / 2);
      fly.animate([{ transform: 'none', opacity: 1 }, { transform: `translate(${dx}px, ${dy}px) scale(${S})`, opacity: 0 }], { duration: 900, easing: 'cubic-bezier(0.7, 0, 0.2, 1)', fill: 'forwards' });
      veil.animate([{ opacity: 0 }, { opacity: 0, offset: 0.3 }, { opacity: 1 }], { duration: 900, fill: 'forwards' });
      setTimeout(() => { try { sessionStorage.setItem('portal', '1'); } catch (_) {} location.href = a.href; }, 870);
    });
    a.addEventListener('mouseleave', () => a.classList.remove('is-flipped'));
  });
  addEventListener('pageshow', () => {
    document.querySelectorAll('.next-veil, .next-fly').forEach((o) => o.remove());
    document.querySelectorAll('.next .flip').forEach((c) => (c.style.visibility = ''));
    document.querySelectorAll('.next.is-flipped').forEach((a) => a.classList.remove('is-flipped'));
  });

  // 解读项目：点标题展开 / 收起
  document.querySelectorAll('.svc-head').forEach((btn) => {
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') !== 'true';
      btn.setAttribute('aria-expanded', String(open));
      btn.closest('.svc')?.classList.toggle('is-open', open);
      const t = btn.querySelector('.svc-toggle-t');
      if (t) t.textContent = btn.getAttribute(open ? 'data-open' : 'data-closed') || '';
    });
  });

  // 手机目录：打开 / 关上（点遮罩、按 Esc、点链接都会关）
  {
    const btn = document.querySelector('.menu-btn');
    const menu = document.getElementById('mmenu');
    const veil = document.querySelector('.mmenu-veil');
    const links = menu ? [...menu.querySelectorAll('a')] : [];
    const set = (open) => {
      if (!btn || !menu) return;
      btn.setAttribute('aria-expanded', String(open));
      btn.textContent = btn.getAttribute(open ? 'data-open' : 'data-closed') || '';
      menu.setAttribute('aria-hidden', String(!open));
      document.documentElement.classList.toggle('menu-open', open);
      links.forEach((a) => a.setAttribute('tabindex', open ? '0' : '-1'));
    };
    btn?.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
    veil?.addEventListener('click', () => set(false));
    links.forEach((a) => a.addEventListener('click', () => set(false)));
    addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
  }

  // 内容进入视口时浮起
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const blocks = document.querySelectorAll('.block');
  if (reduce || !('IntersectionObserver' in window)) {
    blocks.forEach((b) => b.classList.add('in'));
  } else {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
    }, { rootMargin: '0px 0px -8% 0px' });
    blocks.forEach((b) => io.observe(b));
  }
</script>

<style>
  @property --amp { syntax: '<number>'; inherits: true; initial-value: 0; }

  /* ── 顶上一条丝缎 ───────────────────────────────────── */
  .strip {
    position: relative;
    height: clamp(250px, 40vh, 380px);
    overflow: hidden;
    background: #eadad4;
  }

  /* ── 从首页点牌进来：页面从米色里浮出来（接着首页那张放大淡出的牌）。
     html.portal-enter 由 Base.astro 头部的小脚本加上 ── */
  :global(html.portal-enter) .strip {
    animation: fade-in 0.7s ease-out both;
  }
  :global(html.portal-enter) .strip-bar,
  :global(html.portal-enter) .strip-title {
    animation: rise-in 0.8s 0.2s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  :global(html.portal-enter) .below {
    animation: rise-in 0.9s 0.3s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  @keyframes fade-in {
    from { opacity: 0; }
  }
  @keyframes rise-in {
    from { opacity: 0; transform: translateY(28px); }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html.portal-enter) .strip,
    :global(html.portal-enter) .strip-bar,
    :global(html.portal-enter) .strip-title,
    :global(html.portal-enter) .below { animation: none; }
  }

  .strip-bg, .strip-bg :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .strip-bar {
    position: absolute;
    top: 28px;
    left: clamp(20px, 3.4vw, 48px);
    right: clamp(20px, 3.4vw, 48px);
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    z-index: 2;
    font-family: var(--hero-serif);
    font-size: clamp(14px, 1.15vw, 17px);
    letter-spacing: 0.05em;
    color: #5e4b47;
  }

  .back { display: inline-flex; align-items: baseline; gap: 10px; font-style: italic; }
  .back-arrow { font-style: normal; transition: transform 0.4s cubic-bezier(0.22, 0.61, 0.36, 1); }
  .back:hover { color: var(--accent); }
  .back:hover .back-arrow { transform: translateX(-5px); }

  .pnav { display: flex; align-items: baseline; gap: clamp(14px, 2.2vw, 32px); }
  .lt-wrap { padding-left: clamp(14px, 2.2vw, 32px); border-left: 1px solid rgba(78, 57, 51, 0.3); }
  .pnav a { border-bottom: 1px solid transparent; padding-bottom: 2px; transition: color 0.3s, border-color 0.3s; }
  .pnav a:hover { color: var(--accent); }
  .pnav a[aria-current='page'] { color: var(--ink); border-bottom-color: rgba(78, 57, 51, 0.5); }

  .strip-title {
    position: absolute;
    left: clamp(20px, 6vw, 96px);
    right: clamp(20px, 6vw, 96px);
    bottom: clamp(60px, 9vh, 96px);
    z-index: 2;
  }

  .strip-n {
    margin: 0 0 10px;
    font-family: var(--didot);
    font-style: italic;
    font-size: clamp(15px, 1.4vw, 19px);
    letter-spacing: 0.2em;
    color: #8a6a5e;
  }

  .strip-h {
    margin: 0;
    font-family: var(--didot);
    font-weight: 450;
    font-size: clamp(46px, 7.4vw, 112px);
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: #4e3933;
  }

  .strip-h.is-italic { font-style: italic; font-weight: 400; }
  .strip-h:lang(zh) { font-family: 'PingFang SC', var(--cjk); font-weight: 600; letter-spacing: 0.08em; }

  /* ── 最底下：预约 + 下一页 ─────────────────────────────── */
  .endbar {
    margin-bottom: clamp(48px, 7vw, 90px);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
    flex-wrap: wrap;
    margin-top: clamp(64px, 9vw, 120px);
    padding-top: 28px;
    border-top: 1px solid var(--rule);
  }

  .end-book { display: flex; flex-direction: column; align-items: flex-start; gap: 14px; max-width: 34em; }
  .end-title { margin: 0; }
  .end-body { margin: 0 0 6px; }

  /* ── 下一页：扣着的牌，翻开 ── */
  .next {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    margin-left: auto;
    text-align: center;
    perspective: 900px;
    -webkit-tap-highlight-color: transparent;
  }
  .next-k { color: var(--accent); }
  .flip {
    display: block;
    width: clamp(116px, 10vw, 142px);
    aspect-ratio: 7 / 12;
    transform: rotate(6deg);
    transition: transform 0.6s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .flip-in {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 0.75s cubic-bezier(0.3, 1.3, 0.5, 1);
  }
  .flip-back, .flip-front {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    border-radius: 4px;
