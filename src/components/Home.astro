<Base bare wide sheen lang={lang} title={`The Open Space ${site.cjk}`} description={site.tagline}>
  <section class="hero">
    <Picture
      src={satin}
      formats={['avif', 'webp']}
      widths={[800, 1400, 2000]}
      sizes="100vw"
      alt=""
      loading="eager"
      class="ground"
    />

    <div class="stage">
      <div class="mark-wrap">
        <h1 class="mark">
          <!-- 店名本身就是入口：点一下滑到下面「名字的来历」 -->
          <a class="mark-link" href="#name">
            <span class="ml" style="--i:0">The </span>
            <span class="ml ml-open" style="--i:1">Open </span>
            <span class="ml" style="--i:2">Space </span>
            <span class="mark-sub" style="--i:3"><span class="cjk-name">{site.cjk}</span> <span class="vicky">with Vicky</span></span>
            <!-- 鼠标移上去：一圈柔光 + 星星一颗颗亮起来 -->
            <span class="halo" aria-hidden="true"></span>
            {[
              [6, 10, 0.0, 22], [88, 4, 0.6, 28], [100, 36, 1.3, 16], [-2, 44, 0.9, 18],
              [80, 56, 0.3, 24], [12, 72, 1.6, 14], [94, 80, 1.0, 20], [48, -6, 1.9, 16],
              [28, 28, 2.3, 12], [66, 20, 2.7, 13], [56, 98, 0.5, 18], [-8, 90, 2.1, 13],
              [38, 52, 1.1, 10], [72, 40, 2.0, 11], [20, 100, 2.9, 15], [104, 64, 1.7, 12],
            ].map(([x, y, d, z]) => (
              <span class="tw" aria-hidden="true" style={`left:${x}%;top:${y}%;--d:${d}s;--z:${Math.round(z * 0.6)}px`}>✦</span>
            ))}
          </a>
          <span class="mark-hint" aria-hidden="true">{site.hint}</span>
        </h1>
      </div>
      {
        pieces.map((p, i) => (
          <Image
            src={p.src}
            alt={p.alt}
            format="webp"
            quality={80}
            class={`el ${p.k}`}
            loading="eager"
            data-d={p.d}
            data-ph={p.ph}
            style={`--i:${i}`}
          />
        ))
      }
    </div>

    <div class="topbar">
      <p class="intro">{site.intro}</p>
      <nav aria-label="Sections">
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
    </div>

    <div class="bottombar">
      <span class="spacer"></span>
      <p class="intro intro-m">{site.intro}</p>
    </div>
  </section>

  <div class="below">
    <!-- 名字的来历 -->
    <section class="wrap block" id="name">
      <p class="kicker label">{nameStory.kicker}</p>
      <hr class="rule" />
      <div class="two">
        <h2 class={`cjk-title ${lang === 'en' ? 'where' : ''}`}>{nameStory.title}</h2>
        <div class="prose-t">
          {nameStory.body.map((t) => (
            <p>{t}</p>
          ))}
        </div>
      </div>
    </section>

    <!-- 关于我 -->
    <section class="wrap block" id="about">
      <p class="kicker label">{about.kicker}</p>
      <hr class="rule" />
      <div class="two">
        <h2 class="cjk-title about-title">{about.title}</h2>
        <div class="about-r">
          <ul class="tags">
            {about.tags.map((t) => <li>{t}</li>)}
          </ul>
          <p class="prose-t">{about.body}</p>
          <p class="motto">{about.motto}</p>
