---
import { Image, Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import LangSeal from './LangSeal.astro';
import Book from './Book.astro';
import WeChatSheet from './WeChatSheet.astro';
import { T, url, pageMeta, doors } from '../lib/site.js';

const { lang = 'en' } = Astro.props;

import satin from '../assets/collage/satin.jpg';
import caladium from '../assets/collage/caladium.png';
import paleflower from '../assets/collage/paleflower.png';
import paleflower2 from '../assets/collage/paleflower2.png';
import uranus from '../assets/collage/uranus.png';
import nautilus from '../assets/collage/nautilus.png';
import star from '../assets/collage/star.png';
import moon from '../assets/collage/moon.png';
import moon2 from '../assets/collage/moon2.png';
import blueflower from '../assets/collage/blueflower.png';
import nightflower from '../assets/collage/nightflower.png';
import dagger from '../assets/collage/dagger.png';
import lilypad from '../assets/collage/lilypad.png';
import lilypad2 from '../assets/collage/lilypad2.png';
import lotus from '../assets/collage/lotus.png';
import begonia from '../assets/collage/begonia.png';
import starfish from '../assets/collage/starfish.png';
import orchid from '../assets/collage/orchid.png';
import cherub from '../assets/collage/cherub.png';
import planet from '../assets/collage/planet.png';
import moonlet from '../assets/collage/moonlet.png';
import nautilus2 from '../assets/collage/nautilus2.png';
import butterflyGreen from '../assets/collage/butterfly-green.png';

// 首屏的拼贴元素。位置在下面的 CSS 里，这里只定义层次：
// depth 决定视差幅度（越「近」动得越多），ph 是漂浮的相位差
const pieces = [

  { k: 'caladium', src: caladium, alt: '粉脉彩叶芋', d: 1.0, ph: 0.0 },
  { k: 'paleflower2', src: paleflower2, alt: '淡蓝色花', d: 0.35, ph: 1.7 },
  { k: 'paleflower', src: paleflower, alt: '浅蓝色花', d: 0.55, ph: 0.4 },
  { k: 'uranus', src: uranus, alt: '天王星', d: 0.3, ph: 2.9 },
  { k: 'nautilus2', src: nautilus2, alt: '鹦鹉螺壳', d: 0.3, ph: 1.1 },
  { k: 'star', src: star, alt: '金色星芒', d: 0.85, ph: 2.2 },
  { k: 'moon', src: moon, alt: '金色月牙', d: 0.7, ph: 0.8 },
  { k: 'blueflower', src: blueflower, alt: '蓝色花', d: 0.55, ph: 3.4 },
  { k: 'nightflower', src: nightflower, alt: '深蓝色花', d: 0.5, ph: 1.5 },
  { k: 'nautilus', src: nautilus, alt: '鹦鹉螺壳', d: 0.4, ph: 2.6 },
  { k: 'dagger', src: dagger, alt: '匕首', d: 0.95, ph: 0.3 },
  { k: 'lilypad', src: lilypad, alt: '荷叶', d: 0.8, ph: 1.9 },
  { k: 'lilypad2', src: lilypad2, alt: '荷叶', d: 0.6, ph: 3.1 },
  { k: 'lotus', src: lotus, alt: '粉色睡莲', d: 1.0, ph: 0.6 },
  { k: 'begonia', src: begonia, alt: '螺旋秋海棠叶', d: 0.6, ph: 2.4 },
  { k: 'starfish', src: starfish, alt: '海星', d: 0.6, ph: 1.3 },
  { k: 'orchid', src: orchid, alt: '绿色兰花', d: 0.5, ph: 0.9 },
  { k: 'cherub', src: cherub, alt: '金色小天使', d: 0.9, ph: 2.0 },
  { k: 'planet', src: planet, alt: '蓝色星球', d: 0.3, ph: 3.6 },
  { k: 'moon2', src: moon2, alt: '金色月牙', d: 0.35, ph: 1.2 },
  { k: 'moonlet', src: moonlet, alt: '月亮', d: 0.25, ph: 2.8 },
  { k: 'butterflyGreen', src: butterflyGreen, alt: '绿色凤蝶', d: 0.75, ph: 2.3 },
];

const { site, nameStory } = T[lang];
const myDoors = doors[lang];
const pm = pageMeta[lang];
// 首页右上角：三个内容页 + 预约（「这个空间」从店名进）
const nav = ['about', 'guide', 'readings'].map((k) => ({ href: url(lang, k), label: pm[k].nav }));
---

<Base bare wide sheen lang={lang} alt="/" title={`The Open Space ${site.cjk}`} description={site.tagline}>
  <section class="hero">
    <Picture
      src={satin}
      formats={['avif', 'webp']}
      widths={[800, 1400, 2000]}
      sizes="100vw"
      alt=""
      loading="eager"
      class="ground"
    />

    <div class="stage">
      <div class="mark-wrap">
        <h1 class="mark">
          <!-- 店名本身就是入口：点一下滑到下面「这个空间」 -->
          <a class="mark-link" href="#space">
            <span class="ml" style="--i:0">The </span>
            <span class="ml ml-open" style="--i:1">Open </span>
            <span class="ml" style="--i:2">Space </span>
            <span class="mark-sub" style="--i:3"><span class="cjk-name">{site.cjk}</span> <span class="vicky">with Vicky</span></span>
            <!-- 鼠标移上去：一圈柔光 + 星星一颗颗亮起来 -->
            <span class="halo" aria-hidden="true"></span>
            {[
              [6, 10, 0.0, 22], [88, 4, 0.6, 28], [100, 36, 1.3, 16], [-2, 44, 0.9, 18],
              [80, 56, 0.3, 24], [12, 72, 1.6, 14], [94, 80, 1.0, 20], [48, -6, 1.9, 16],
              [28, 28, 2.3, 12], [66, 20, 2.7, 13], [56, 98, 0.5, 18], [-8, 90, 2.1, 13],
              [38, 52, 1.1, 10], [72, 40, 2.0, 11], [20, 100, 2.9, 15], [104, 64, 1.7, 12],
            ].map(([x, y, d, z]) => (
              <span class="tw" aria-hidden="true" style={`left:${x}%;top:${y}%;--d:${d}s;--z:${Math.round(z * 0.6)}px`}>✦</span>
            ))}
          </a>
          <span class="mark-hint" aria-hidden="true">{site.hint}</span>
        </h1>
      </div>
      {
        pieces.map((p, i) => (
          <Image
            src={p.src}
            alt={p.alt}
            format="webp"
            quality={80}
            class={`el ${p.k}`}
            loading="eager"
            data-d={p.d}
            data-ph={p.ph}
            style={`--i:${i}`}
          />
        ))
      }
    </div>

    <div class="topbar">
      <p class="intro">{site.intro}</p>
      <nav aria-label="Sections">
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        <Book lang={lang} variant="nav" />
      </nav>
    </div>

    <div class="bottombar">
      <span class="spacer"></span>
      <p class="intro intro-m">{site.intro}</p>
    </div>
  </section>

  <!-- 往下拉：一块升起来的面板，只讲「这里是什么地方」，然后是三扇门 -->
  <div class="below">
    <section class="wrap block" id="space">
      <p class="kicker label">The Open Space · 自留地</p>
      <hr class="rule" />
      <div class="two">
        <h2 class={`space-title ${lang === 'en' ? 'is-en' : ''}`}>{lang === 'en' ? 'What is this place?' : '自留地'}</h2>
        <div class="prose-t">
          {nameStory.body.map((t) => <p>{t}</p>)}
        </div>
      </div>
    </section>

    <section class="wrap block doors" aria-label={lang === 'en' ? 'Pages' : '页面'}>
      <ul class="door-list">
        {myDoors.map((d, i) => (
          <li>
            <a class="door" href={url(lang, d.key)}>
              <span class="door-n">{['I', 'II', 'III'][i]}</span>
              <span class="door-t">{pageMeta[lang][d.key].title}</span>
              <span class="door-b">{d.line}</span>
              <span class="door-go" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="door-book">
        <Book lang={lang} variant="cta" />
      </div>
    </section>
  </div>


  {lang === 'zh' && <WeChatSheet />}
  <LangSeal lang={lang} href={url(lang === 'en' ? 'zh' : 'en')} />
</Base>

<script>
  // 滚过首屏以后给 html 加个标记（左下角徽章用它垫底色）
  const markPast = () => document.documentElement.classList.toggle('past-hero', scrollY > innerHeight * 0.75);
  addEventListener('scroll', markPast, { passive: true });
  markPast();

  // 下方区块进入视口时浮起
  {
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const blocks = document.querySelectorAll('.block');
    if (still || !('IntersectionObserver' in window)) blocks.forEach((b) => b.classList.add('in'));
    else {
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -10% 0px' });
      blocks.forEach((b) => io.observe(b));
    }
  }

  // 丝缎的动感：滚动视差 + 极慢的漂浮。
  // 两者都只改 transform，合成一个 rAF 循环，不触发重排。
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const stage = document.querySelector('.stage');
  const mark = document.querySelector('.mark');
  const markWrap = document.querySelector('.mark-wrap');
  const ground = document.querySelector('.ground');

  if (stage && !reduce) {
    const els = [...stage.querySelectorAll('.el')].map((el) => ({
      el,
      d: parseFloat(el.dataset.d || '0.5'),
      ph: parseFloat(el.dataset.ph || '0'),
      // 被涟漪推开之后的偏移、速度、以及一点点转动和缩放
      ox: 0, oy: 0, vx: 0, vy: 0, rw: 0, rv: 0, pop: 0, cool: 0,
      cx: 0, cy: 0, hw: 0,
    }));

    // 元素在屏幕上的中心。第一屏是 sticky 的，钉住的时候它的顶就是屏幕的顶，
    // 所以用 offsetLeft/offsetTop 就够了，不用每帧去问浏览器要位置（那会很卡）。
    const measure = () => {
      for (const o of els) {
        o.cx = o.el.offsetLeft + o.el.offsetWidth / 2;
        o.cy = o.el.offsetTop + o.el.offsetHeight / 2;
        o.hw = Math.max(o.el.offsetWidth, o.el.offsetHeight) * 0.5;
      }
    };
    measure();
    window.addEventListener('resize', measure);
    window.addEventListener('load', measure);

    // ── 涟漪碰到元素 ─────────────────────────────────
    // Base.astro 里每落下一圈涟漪就发一个事件。这里记下来，
    // 每帧算这一圈现在扩到多大，扩到谁身上，就把谁往外推一下。
    const waves = [];

    window.addEventListener('sheen:ripple', (e) => {
      const { x, y, reach, life } = e.detail;
      if (waves.length > 14) waves.shift();
      waves.push({ x, y, reach, life, t: 0, hit: new Set() });
    });

    let sy = 0;
    let ticking = false;
    const onScroll = () => {
      sy = window.scrollY;
      if (!ticking) { ticking = true; requestAnimationFrame(() => { ticking = false; }); }
    };
    window.addEventListener('scroll', onScroll, { passive: true });

    const hero = document.querySelector('.hero');

    let prev = performance.now();

    const loop = (now) => {
      const t = now * 0.001;
      const dt = Math.min((now - prev) / 1000, 0.05);
      prev = now;
      // 第一屏滚出视野之后就不再计算
      const heroH = hero ? hero.offsetHeight : window.innerHeight;
      const active = sy < heroH + 240;
      if (active) {
        // 第一屏被钉住，用「滚过了多少」当进度，位移才不会飞出去
        const prog = Math.min(sy / heroH, 1);
        // 缓入缓出，让退后的过程不是线性的，更像呼气
        const ease = prog * prog * (3 - 2 * prog);

        // 先让每一圈涟漪长大，看它这一帧扫过了谁
        const heroTop = hero ? Math.max(0, heroH - sy) : 0;   // 第一屏还剩多少在屏幕上
        for (let i = waves.length - 1; i >= 0; i--) {
          const wv = waves[i];
          wv.t += dt;
          const wp = wv.t / wv.life;
          if (wp >= 1) { waves.splice(i, 1); continue; }
          const wr = 8 + wv.reach * (1 - Math.pow(1 - wp, 2.4));
          const strength = Math.pow(1 - wp, 1.4);
          if (strength < 0.08) continue;

          for (let j = 0; j < els.length; j++) {
            const o = els[j];
            if (wv.hit.has(j) || o.cool > 0) continue;   // 刚被碰过就先歇一下，免得一串圈把它顶飞
            // 元素中心在屏幕上的位置：sticky 的时候等于 offset，滚出去之后跟着上移
            const ex = o.cx;
            const ey = o.cy - (heroH - heroTop);
            const dx = ex - wv.x;
            const dy = ey - wv.y;
            const dist = Math.hypot(dx, dy) || 0.001;
            // 圈边扫到元素的轮廓范围内，就算「碰到」
            if (Math.abs(dist - wr) > o.hw * 0.72 + 26) continue;
            wv.hit.add(j);
            o.cool = 0.36;
            const push = (36 + 26 * o.d) * strength;
            o.vx += (dx / dist) * push;
            o.vy += (dy / dist) * push;
            o.rv += (dx > 0 ? 1 : -1) * 11 * strength * o.d;
            o.pop = Math.max(o.pop, 0.018 * strength);
          }
        }

        for (const o of els) {
          if (o.cool > 0) o.cool -= dt;
          // 漂浮：周期约 20 秒，幅度 8–24px
          const amp = 8 + o.d * 16;
          const fx = Math.sin(t * 0.3 + o.ph) * amp;
          const fy = Math.cos(t * 0.23 + o.ph) * amp * 0.75;
          // 视差：越「近」的元素随滚动上移越多
          const py = -prog * 220 * o.d;
          const px = Math.sin(o.ph) * prog * 26 * o.d;

          // 被推开之后往回弹：弹簧 + 阻尼，晃两下就停
          o.vx += (-o.ox * 26 - o.vx * 7.4) * dt;
          o.vy += (-o.oy * 26 - o.vy * 7.4) * dt;
          o.ox += o.vx * dt;
          o.oy += o.vy * dt;
          o.rv += (-o.rw * 20 - o.rv * 6.2) * dt;
          o.rw += o.rv * dt;
          o.pop *= Math.pow(0.3, dt);

          o.el.style.setProperty('--tx', (fx + px + o.ox).toFixed(2) + 'px');
          o.el.style.setProperty('--ty', (fy + py + o.oy).toFixed(2) + 'px');
          o.el.style.setProperty('--rw', o.rw.toFixed(2) + 'deg');
          // 一起往后退一点，越近的退得越多；被碰到的瞬间还会鼓一下
          o.el.style.setProperty('--sc', (1 - ease * 0.09 * o.d + o.pop).toFixed(4));
        }

        if (markWrap) {
          // 呼吸：周期约 10 秒，幅度 1.7% —— 静止时数字自己也在起伏
          const breath = Math.sin(t * 0.62) * 0.017;
          markWrap.style.setProperty('--msc', (1 - ease * 0.24 + breath).toFixed(4));
          // 透明度也跟着呼吸走一点，起伏才看得见而不只是「大小在变」
          markWrap.style.setProperty('--mop', (1 - ease * 0.72 + (breath - 0.017) * 1.6).toFixed(3));
        }
        if (mark) {
          // 除了随滚动上移，再叠一层 5px 的缓慢浮动
          const mb = Math.sin(t * 0.62 + 1.1) * 5;
          mark.style.setProperty('--mty', (-prog * 70 + mb).toFixed(2) + 'px');
        }

        if (ground) {
          // 丝缎随滚动推近，并叠一层周期约 31 秒、幅度 1.3% 的极慢呼吸。
          // 底数 1.022 是为了让呼吸缩到最小时仍然 > 1，不会露出边。
          const gb = Math.sin(t * 0.2) * 0.013;
          ground.style.setProperty('--gsc', (1.022 + ease * 0.11 + gb).toFixed(4));
        }
      }
      requestAnimationFrame(loop);
    };
    requestAnimationFrame(loop);
  }

</script>

<style>
  @property --amp { syntax: '<number>'; inherits: true; initial-value: 0; }

  /* ── 第一屏：丝缎为地的拼贴 ───────────────── */
  .hero {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
    background: #eadad4;
  }

  .ground {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(var(--gsc, 1));
    transform-origin: 50% 50%;
    will-change: transform;
  }

  .stage {
    position: absolute;
    inset: 0;
  }

  .mark-wrap {
    position: absolute;
    inset: 0;
    z-index: 2;
    transform: scale(var(--msc, 1));
    transform-origin: 50% 46%;
    opacity: var(--mop, 1);
    will-change: transform, opacity;
  }

  .mark {
    position: absolute;
    left: 0;
    right: 0;
    top: 19%;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    pointer-events: none;
    font-family: var(--didot);
    font-size: clamp(64px, min(9.6vw, 15.5vh), 168px);
    font-weight: 450;
    font-variation-settings: 'opsz' 96;
    line-height: 0.84;
    letter-spacing: -0.025em;
    color: #4e3933;
    z-index: 2;
    transform: translate3d(0, var(--mty, 0px), 0);
    will-change: transform;
    scale: 1;
    transition: color 0.55s ease, scale 0.55s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  /* Bodoni 的发丝线在大字号下几乎看不见 —— 描一圈极细的同色边，
     只把细线托起来一点，粗笔画看不出变化 */
  .ml {
    display: block;
    white-space: nowrap;
    -webkit-text-stroke: 0.35px currentColor;
  }

  /* 中间压着的花体 Open */
  .ml-open {
    position: relative;
    z-index: 2;
    margin: 0 0 0.06em 0.55em;
    font-family: 'Ballet', cursive;
    font-weight: 400;
    font-variation-settings: normal;
    line-height: 0.55;
    letter-spacing: 0;
    -webkit-text-stroke: 0;
  }

  /* 下面：苹方的「自留地」，金色手写 with Vicky 斜着压在上面 */
  .mark-sub {
    position: relative;
    display: block;
    margin-top: 0.5em;
    font-size: clamp(30px, min(3.9vw, 6.4vh), 66px);
    line-height: 1;
  }

  .cjk-name {
    font-family: 'PingFang SC', -apple-system, 'Noto Sans SC Subset', 'Microsoft YaHei', sans-serif;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: #5a423c;
  }

  .vicky {
    position: absolute;
    left: 50%;
    top: 58%;
    font-family: 'Monsieur La Doulaise', cursive;
    font-size: 1.55em;
    line-height: 1;
    letter-spacing: 0;
    white-space: nowrap;
    color: #c4923c;
    text-shadow: 0 1px 1px rgba(110, 70, 30, 0.18), 0 2px 14px rgba(255, 246, 230, 0.6);
    transform: translate(-22%, -50%) rotate(-7deg);
    pointer-events: none;
  }

  /* 整个店名是一个链接。外层 h1 铺满整行，不接点击；只有字本身能点 */
  .mark-link {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    color: inherit;
    pointer-events: auto;
    cursor: pointer;
  }

  /* ── 店名的悬停：梦幻一点，而且每一行各自呼吸 ──────────
     --amp 是「醒来的程度」：0 静止，1 完全醒着。注册成可以过渡的属性，
     移入移出都是慢慢淡入淡出，不会一下子跳 */
  @media (hover: hover) {
    .mark-link:hover { --amp: 1; color: #57403a; }
  }

  .mark-link { --amp: 0; transition: --amp 1.1s ease, color 0.8s ease; }

  .mark-link .ml,
  .mark-link .mark-sub {
    animation: line-breathe 4.6s ease-in-out infinite;
    animation-delay: calc(var(--i, 0) * -1.15s);
    text-shadow:
      0 0 calc(var(--amp) * 8px) rgba(255, 253, 246, calc(var(--amp) * 0.75)),
      0 0 calc(var(--amp) * 26px) rgba(236, 216, 172, calc(var(--amp) * 0.4));
  }

  /* 每一行错开相位：一行吸气时下一行刚开始，像一层一层浮起来 */
  @keyframes line-breathe {
    0%, 100% { transform: translateY(0) scale(1); letter-spacing: inherit; }
    50% {
      transform: translateY(calc(var(--amp) * -5px)) scale(calc(1 + var(--amp) * 0.028));
    }
  }

  .ml-open { animation-name: open-breathe !important; }

  @keyframes open-breathe {
    0%, 100% { transform: translateX(0) rotate(0deg) scale(1); }
    50% { transform: translateX(calc(var(--amp) * 6px)) rotate(calc(var(--amp) * -2.5deg)) scale(calc(1 + var(--amp) * 0.05)); }
  }

  .vicky { transition: filter 1s ease; }
  .mark-link:hover .vicky { filter: brightness(1.08) drop-shadow(0 0 8px rgba(255, 244, 214, 0.6)); }

  /* 柔光：一团粉金色的雾，从字后面亮起来 */
  .halo {
    position: absolute;
    inset: -18% -26%;
    z-index: -1;
    border-radius: 50%;
    background:
      radial-gradient(closest-side at 45% 42%, rgba(255, 253, 245, 0.8), rgba(250, 240, 220, 0.4) 46%, rgba(250, 240, 220, 0) 76%),
      radial-gradient(closest-side at 68% 74%, rgba(232, 210, 160, 0.35), rgba(232, 210, 160, 0) 72%);
    filter: blur(24px);
    opacity: calc(var(--amp) * 0.7);
