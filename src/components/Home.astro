const W = 12, H = 19;
const layouts = {
  three: { vb: [0, 0, 42, 19], cards: [[6, 9.5], [21, 9.5], [36, 9.5]] },
  cross: { vb: [0, 0, 42, 63], cards: [[21, 9.5], [6, 31.5], [21, 31.5], [36, 31.5], [21, 53.5]] },
