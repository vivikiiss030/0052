      </div>
    </section>

    <!-- 占卜服务须知 -->
    <section class="wrap block" id="how">
      <p class="kicker label">{how.kicker}</p>
      <hr class="rule" />
      <h2 class="stance how-title">{how.title[0]}<br /><i>{how.title[1]}</i></h2>
      <ol class="rules">
        {how.items.map((it, i) => (
          <li>
            <span class="rules-n">{String(i + 1).padStart(2, '0')}</span>
            <h3>{it.t}</h3>
            {it.b.map((t) => <p>{t}</p>)}
          </li>
        ))}
      </ol>
    </section>

    <!-- 解读项目：点开看详情 -->
    <section class="wrap block" id="readings">
      <p class="kicker label">{readingsKicker}</p>
      <hr class="rule" />
      <ul class="svcs">
        {readings.map((r, i) => (
          <li class="svc">
            <button class="svc-head" type="button" aria-expanded="false" aria-controls={`svc-${i}`} data-open={r.toggle[1]} data-closed={r.toggle[0]}>
              <span class="rn">{r.n}</span>
              <span class="svc-title">
                <h3>{r.name}</h3>
                <span class="svc-note">{r.note}</span>
              </span>
              <span class="rmeta">
                <span class="rlen label">{r.len}</span>
                <span class="rprice">{r.price}</span>
              </span>
              <span class="svc-toggle">
                <span class="svc-toggle-t">{r.toggle[0]}</span>
                <span class="plus" aria-hidden="true"></span>
              </span>
            </button>
            <div class="svc-body" id={`svc-${i}`}>
              <div class="svc-inner">
                {r.spreads && (
                  <ul class="spreads">
                    {r.spreads.map((sp) => (
                      <li class="spread">
                        <svg class="sv" viewBox={layouts[sp.lay].vb.join(' ')} width={Math.round(layouts[sp.lay].vb[2] * Math.min(1.15, 92 / layouts[sp.lay].vb[3]))} height={Math.round(layouts[sp.lay].vb[3] * Math.min(1.15, 92 / layouts[sp.lay].vb[3]))} aria-hidden="true">
                          {layouts[sp.lay].cards.map(([x, y, side], j) => {
                            const w = side ? H : W, h = side ? W : H;
                            return (
                              <g style={`--j:${j}`}>
                                <rect x={x - w / 2 + 0.6} y={y - h / 2 + 0.6} width={w - 1.2} height={h - 1.2} rx="1.4" />
                                <rect class="sv-in" x={x - w / 2 + 2.2} y={y - h / 2 + 2.2} width={w - 4.4} height={h - 4.4} rx="0.6" />
                              </g>
                            );
                          })}
                        </svg>
                        <span class="sp-main">
                          <span class="sp-name">
                            {sp.name}
                            {sp.zh && <span class="sp-zh">{sp.zh}</span>}
                          </span>
                          <span class="sp-pos">{sp.pos}</span>
                          <span class="sp-for">{sp.for}</span>
                        </span>
                        <span class="sp-side">
                          <span class="sp-k">{sp.kl ?? sp.k}<small>{lang === 'en' ? ' cards' : ' 张'}</small></span>
                          <span class="sp-tag">{sp.tag}</span>
                        </span>
                      </li>
                    ))}
                  </ul>
                )}
                {r.points && (
                  <div class="healing">
                    <ul class="points">
                      {r.points.map((p) => <li>{p}</li>)}
                    </ul>
                    <p class="healing-after">{r.after}</p>
                  </div>
                )}
              </div>
            </div>
          </li>
        ))}
      </ul>
      <p class="menu-note">{readingsNote}</p>
    </section>

    <!-- 反馈 -->
    {showSays && (
    <section class="wrap block" id="says">
      <p class="kicker label">{saysKicker}</p>
      <hr class="rule" />
      <ul class="says">
        {says.map((s) => (
          <li>
            <blockquote>{s.quote}</blockquote>
            <p class="who label">{s.who}</p>
          </li>
        ))}
      </ul>
    </section>
    )}

    <!-- 感悟 -->
    {showNotes && (
    <section class="wrap block" id="notes">
      <p class="kicker label">{notesKicker}</p>
      <hr class="rule" />
      <ul class="notes">
        {notes.map((o) => (
          <li>
            <h3>{o.t}</h3>
            <p>{o.b}</p>
          </li>
        ))}
      </ul>
    </section>
    )}

    <!-- 预约 -->
    <section class="wrap block book" id="book">
      <p class="kicker label">{book.kicker}</p>
      <hr class="rule" />
      <h2 class="stance">{book.title}</h2>
      <p class="prose-t">{book.body}</p>
      {
        book.cta.type === 'link' ? (
          <a class="cta" href={book.cta.href} rel="me noopener">
            <span>{book.cta.label}</span>
            <span class="handle">{book.cta.detail}</span>
          </a>
        ) : (
          <button class="cta" type="button" data-copy={book.cta.value} data-done={book.cta.done}>
            <span class="cta-label">{book.cta.label}</span>
            <span class="handle">{book.cta.detail}</span>
          </button>
        )
      }
    </section>
  </div>

  <!-- 左下角的语言切换：一直在，滚到哪儿都能按 -->
  <nav class="lang" aria-label="Language">
    <!-- 日月徽章，上面一圈 English、下面一圈 中文：当前语言是实色，另一个是虚的。
         整枚都能点，移上去徽章整个翻一圈 -->
    <a class={`seal-wrap ${lang === 'en' ? 'on-en' : 'on-zh'}`} href={other.href} hreflang={lang === 'en' ? 'zh-Hans' : 'en'} aria-label={other.label}>
      <svg class="ring" viewBox="0 0 100 100" aria-hidden="true">
        <defs>
          <path id="arc-top" d="M 13 50 A 37 37 0 0 1 87 50" />
          <path id="arc-bot" d="M 6.5 50 A 43.5 43.5 0 0 0 93.5 50" />
        </defs>
        <text class="ring-en"><textPath href="#arc-top" startOffset="50%" text-anchor="middle">ENGLISH</textPath></text>
        <text class="ring-zh"><textPath href="#arc-bot" startOffset="50%" text-anchor="middle">中文</textPath></text>
        <circle class="ring-dot" cx="7" cy="44" r="1.1" />
        <circle class="ring-dot" cx="93" cy="44" r="1.1" />
      </svg>
      <span class="seal">
        <span class="seal-in">
          <span class="seal-face seal-front"><Image src={medallion} alt="" width={112} /></span>
        </span>
      </span>
    </a>
  </nav>
</Base>

<script>
  // 滚过首屏以后给 html 加个标记（左下角徽章用它垫底色）
  const markPast = () => document.documentElement.classList.toggle('past-hero', scrollY > innerHeight * 0.75);
  addEventListener('scroll', markPast, { passive: true });
  markPast();

  // 解读项目：点标题展开 / 收起
  document.querySelectorAll('.svc-head').forEach((btn) => {
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') !== 'true';
      btn.setAttribute('aria-expanded', String(open));
      btn.closest('.svc')?.classList.toggle('is-open', open);
      const t = btn.querySelector('.svc-toggle-t');
      if (t) t.textContent = btn.getAttribute(open ? 'data-open' : 'data-closed') || '';
    });
  });

  // 中文版的「复制微信号」按钮
  document.querySelectorAll('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const v = btn.getAttribute('data-copy') || '';
      try { await navigator.clipboard.writeText(v); } catch {}
      const label = btn.querySelector('.cta-label');
      if (!label) return;
      const before = label.textContent;
      label.textContent = btn.getAttribute('data-done') || before;
      setTimeout(() => { label.textContent = before; }, 2400);
    });
  });

  // 丝缎的动感：滚动视差 + 极慢的漂浮。
  // 两者都只改 transform，合成一个 rAF 循环，不触发重排。
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const stage = document.querySelector('.stage');
  const mark = document.querySelector('.mark');
  const markWrap = document.querySelector('.mark-wrap');
  const ground = document.querySelector('.ground');

  if (stage && !reduce) {
    const els = [...stage.querySelectorAll('.el')].map((el) => ({
      el,
      d: parseFloat(el.dataset.d || '0.5'),
      ph: parseFloat(el.dataset.ph || '0'),
      // 被涟漪推开之后的偏移、速度、以及一点点转动和缩放
      ox: 0, oy: 0, vx: 0, vy: 0, rw: 0, rv: 0, pop: 0, cool: 0,
      cx: 0, cy: 0, hw: 0,
    }));

    // 元素在屏幕上的中心。第一屏是 sticky 的，钉住的时候它的顶就是屏幕的顶，
    // 所以用 offsetLeft/offsetTop 就够了，不用每帧去问浏览器要位置（那会很卡）。
    const measure = () => {
      for (const o of els) {
        o.cx = o.el.offsetLeft + o.el.offsetWidth / 2;
        o.cy = o.el.offsetTop + o.el.offsetHeight / 2;
        o.hw = Math.max(o.el.offsetWidth, o.el.offsetHeight) * 0.5;
      }
    };
    measure();
    window.addEventListener('resize', measure);
    window.addEventListener('load', measure);

    // ── 涟漪碰到元素 ─────────────────────────────────
    // Base.astro 里每落下一圈涟漪就发一个事件。这里记下来，
    // 每帧算这一圈现在扩到多大，扩到谁身上，就把谁往外推一下。
    const waves = [];

    window.addEventListener('sheen:ripple', (e) => {
      const { x, y, reach, life } = e.detail;
      if (waves.length > 14) waves.shift();
      waves.push({ x, y, reach, life, t: 0, hit: new Set() });
    });

    let sy = 0;
    let ticking = false;
    const onScroll = () => {
      sy = window.scrollY;
      if (!ticking) { ticking = true; requestAnimationFrame(() => { ticking = false; }); }
    };
    window.addEventListener('scroll', onScroll, { passive: true });

    const hero = document.querySelector('.hero');

    let prev = performance.now();

    const loop = (now) => {
      const t = now * 0.001;
      const dt = Math.min((now - prev) / 1000, 0.05);
      prev = now;
      // 第一屏滚出视野之后就不再计算
      const heroH = hero ? hero.offsetHeight : window.innerHeight;
      const active = sy < heroH + 240;
      if (active) {
        // 第一屏被钉住，用「滚过了多少」当进度，位移才不会飞出去
        const prog = Math.min(sy / heroH, 1);
        // 缓入缓出，让退后的过程不是线性的，更像呼气
        const ease = prog * prog * (3 - 2 * prog);

        // 先让每一圈涟漪长大，看它这一帧扫过了谁
        const heroTop = hero ? Math.max(0, heroH - sy) : 0;   // 第一屏还剩多少在屏幕上
        for (let i = waves.length - 1; i >= 0; i--) {
          const wv = waves[i];
          wv.t += dt;
          const wp = wv.t / wv.life;
          if (wp >= 1) { waves.splice(i, 1); continue; }
          const wr = 8 + wv.reach * (1 - Math.pow(1 - wp, 2.4));
          const strength = Math.pow(1 - wp, 1.4);
          if (strength < 0.08) continue;

          for (let j = 0; j < els.length; j++) {
            const o = els[j];
            if (wv.hit.has(j) || o.cool > 0) continue;   // 刚被碰过就先歇一下，免得一串圈把它顶飞
            // 元素中心在屏幕上的位置：sticky 的时候等于 offset，滚出去之后跟着上移
            const ex = o.cx;
            const ey = o.cy - (heroH - heroTop);
            const dx = ex - wv.x;
            const dy = ey - wv.y;
            const dist = Math.hypot(dx, dy) || 0.001;
            // 圈边扫到元素的轮廓范围内，就算「碰到」
            if (Math.abs(dist - wr) > o.hw * 0.72 + 26) continue;
            wv.hit.add(j);
            o.cool = 0.36;
            const push = (36 + 26 * o.d) * strength;
            o.vx += (dx / dist) * push;
            o.vy += (dy / dist) * push;
            o.rv += (dx > 0 ? 1 : -1) * 11 * strength * o.d;
            o.pop = Math.max(o.pop, 0.018 * strength);
          }
        }

        for (const o of els) {
          if (o.cool > 0) o.cool -= dt;
          // 漂浮：周期约 20 秒，幅度 8–24px
          const amp = 8 + o.d * 16;
          const fx = Math.sin(t * 0.3 + o.ph) * amp;
          const fy = Math.cos(t * 0.23 + o.ph) * amp * 0.75;
          // 视差：越「近」的元素随滚动上移越多
          const py = -prog * 220 * o.d;
          const px = Math.sin(o.ph) * prog * 26 * o.d;

          // 被推开之后往回弹：弹簧 + 阻尼，晃两下就停
          o.vx += (-o.ox * 26 - o.vx * 7.4) * dt;
          o.vy += (-o.oy * 26 - o.vy * 7.4) * dt;
          o.ox += o.vx * dt;
          o.oy += o.vy * dt;
          o.rv += (-o.rw * 20 - o.rv * 6.2) * dt;
          o.rw += o.rv * dt;
          o.pop *= Math.pow(0.3, dt);

          o.el.style.setProperty('--tx', (fx + px + o.ox).toFixed(2) + 'px');
          o.el.style.setProperty('--ty', (fy + py + o.oy).toFixed(2) + 'px');
          o.el.style.setProperty('--rw', o.rw.toFixed(2) + 'deg');
          // 一起往后退一点，越近的退得越多；被碰到的瞬间还会鼓一下
          o.el.style.setProperty('--sc', (1 - ease * 0.09 * o.d + o.pop).toFixed(4));
        }

        if (markWrap) {
          // 呼吸：周期约 10 秒，幅度 1.7% —— 静止时数字自己也在起伏
          const breath = Math.sin(t * 0.62) * 0.017;
          markWrap.style.setProperty('--msc', (1 - ease * 0.24 + breath).toFixed(4));
          // 透明度也跟着呼吸走一点，起伏才看得见而不只是「大小在变」
          markWrap.style.setProperty('--mop', (1 - ease * 0.72 + (breath - 0.017) * 1.6).toFixed(3));
        }
        if (mark) {
          // 除了随滚动上移，再叠一层 5px 的缓慢浮动
          const mb = Math.sin(t * 0.62 + 1.1) * 5;
          mark.style.setProperty('--mty', (-prog * 70 + mb).toFixed(2) + 'px');
        }

        if (ground) {
          // 丝缎随滚动推近，并叠一层周期约 31 秒、幅度 1.3% 的极慢呼吸。
          // 底数 1.022 是为了让呼吸缩到最小时仍然 > 1，不会露出边。
          const gb = Math.sin(t * 0.2) * 0.013;
          ground.style.setProperty('--gsc', (1.022 + ease * 0.11 + gb).toFixed(4));
        }
      }
      requestAnimationFrame(loop);
    };
    requestAnimationFrame(loop);
  }

  // 下方区块进入视口时浮起
  const blocks = document.querySelectorAll('.block');
  if (blocks.length) {
    if (reduce || !('IntersectionObserver' in window)) {
      blocks.forEach((b) => b.classList.add('in'));
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
          });
        },
        { rootMargin: '0px 0px -12% 0px' }
      );
      blocks.forEach((b) => io.observe(b));
    }
  }
</script>

<style>
  @property --amp { syntax: '<number>'; inherits: true; initial-value: 0; }

  /* ── 第一屏：丝缎为地的拼贴 ───────────────── */
  .hero {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
    background: #eadad4;
  }

  .ground {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(var(--gsc, 1));
    transform-origin: 50% 50%;
    will-change: transform;
  }

  .stage {
    position: absolute;
    inset: 0;
  }

  .mark-wrap {
    position: absolute;
    inset: 0;
    z-index: 2;
    transform: scale(var(--msc, 1));
    transform-origin: 50% 46%;
    opacity: var(--mop, 1);
    will-change: transform, opacity;
  }

  .mark {
    position: absolute;
    left: 0;
    right: 0;
    top: 19%;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    pointer-events: none;
    font-family: var(--didot);
    font-size: clamp(64px, min(9.6vw, 15.5vh), 168px);
    font-weight: 450;
    font-variation-settings: 'opsz' 96;
    line-height: 0.84;
    letter-spacing: -0.025em;
    color: #4e3933;
    z-index: 2;
    transform: translate3d(0, var(--mty, 0px), 0);
    will-change: transform;
    scale: 1;
    transition: color 0.55s ease, scale 0.55s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  /* Bodoni 的发丝线在大字号下几乎看不见 —— 描一圈极细的同色边，
     只把细线托起来一点，粗笔画看不出变化 */
  .ml {
    display: block;
    white-space: nowrap;
    -webkit-text-stroke: 0.35px currentColor;
  }

  /* 中间压着的花体 Open */
  .ml-open {
    position: relative;
    z-index: 2;
    margin: 0 0 0.06em 0.55em;
    font-family: 'Ballet', cursive;
    font-weight: 400;
    font-variation-settings: normal;
    line-height: 0.55;
    letter-spacing: 0;
    -webkit-text-stroke: 0;
  }

  /* 下面：苹方的「自留地」，金色手写 with Vicky 斜着压在上面 */
  .mark-sub {
    position: relative;
    display: block;
    margin-top: 0.5em;
    font-size: clamp(30px, min(3.9vw, 6.4vh), 66px);
    line-height: 1;
  }

  .cjk-name {
    font-family: 'PingFang SC', -apple-system, 'Noto Sans SC Subset', 'Microsoft YaHei', sans-serif;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: #5a423c;
  }

  .vicky {
    position: absolute;
    left: 50%;
    top: 58%;
    font-family: 'Monsieur La Doulaise', cursive;
    font-size: 1.55em;
    line-height: 1;
    letter-spacing: 0;
    white-space: nowrap;
    color: #c4923c;
    text-shadow: 0 1px 1px rgba(110, 70, 30, 0.18), 0 2px 14px rgba(255, 246, 230, 0.6);
    transform: translate(-22%, -50%) rotate(-7deg);
    pointer-events: none;
  }

  /* 整个店名是一个链接。外层 h1 铺满整行，不接点击；只有字本身能点 */
  .mark-link {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    color: inherit;
    pointer-events: auto;
    cursor: pointer;
  }

  /* ── 店名的悬停：梦幻一点，而且每一行各自呼吸 ──────────
     --amp 是「醒来的程度」：0 静止，1 完全醒着。注册成可以过渡的属性，
     移入移出都是慢慢淡入淡出，不会一下子跳 */
  @media (hover: hover) {
    .mark-link:hover { --amp: 1; color: #57403a; }
  }

  .mark-link { --amp: 0; transition: --amp 1.1s ease, color 0.8s ease; }

  .mark-link .ml,
  .mark-link .mark-sub {
    animation: line-breathe 4.6s ease-in-out infinite;
    animation-delay: calc(var(--i, 0) * -1.15s);
    text-shadow:
      0 0 calc(var(--amp) * 8px) rgba(255, 253, 246, calc(var(--amp) * 0.75)),
      0 0 calc(var(--amp) * 26px) rgba(236, 216, 172, calc(var(--amp) * 0.4));
  }

  /* 每一行错开相位：一行吸气时下一行刚开始，像一层一层浮起来 */
  @keyframes line-breathe {
    0%, 100% { transform: translateY(0) scale(1); letter-spacing: inherit; }
    50% {
      transform: translateY(calc(var(--amp) * -5px)) scale(calc(1 + var(--amp) * 0.028));
    }
  }

  .ml-open { animation-name: open-breathe !important; }

  @keyframes open-breathe {
    0%, 100% { transform: translateX(0) rotate(0deg) scale(1); }
    50% { transform: translateX(calc(var(--amp) * 6px)) rotate(calc(var(--amp) * -2.5deg)) scale(calc(1 + var(--amp) * 0.05)); }
  }

  .vicky { transition: filter 1s ease; }
  .mark-link:hover .vicky { filter: brightness(1.08) drop-shadow(0 0 8px rgba(255, 244, 214, 0.6)); }

  /* 柔光：一团粉金色的雾，从字后面亮起来 */
  .halo {
    position: absolute;
    inset: -18% -26%;
    z-index: -1;
    border-radius: 50%;
    background:
      radial-gradient(closest-side at 45% 42%, rgba(255, 253, 245, 0.8), rgba(250, 240, 220, 0.4) 46%, rgba(250, 240, 220, 0) 76%),
      radial-gradient(closest-side at 68% 74%, rgba(232, 210, 160, 0.35), rgba(232, 210, 160, 0) 72%);
    filter: blur(24px);
    opacity: calc(var(--amp) * 0.7);
    transform: scale(calc(0.85 + var(--amp) * 0.15));
    pointer-events: none;
    animation: halo-drift 7s ease-in-out infinite;
  }

  @keyframes halo-drift {
    0%, 100% { translate: 0 0; }
    50% { translate: 2% -3%; }
  }

  /* 星星：平时看不见，醒来以后一颗颗错开闪 */
  .tw {
    position: absolute;
    z-index: 3;
    font-size: var(--z);
    line-height: 1;
    color: #fffdf6;
    text-shadow: 0 0 4px rgba(255, 255, 255, 0.9), 0 0 12px rgba(236, 214, 160, 0.8);
    pointer-events: none;
    opacity: 0;
    -webkit-text-stroke: 0;
    letter-spacing: 0;
    animation: twinkle 2.6s ease-in-out infinite;
    animation-delay: var(--d);
  }

  @keyframes twinkle {
    0%, 100% { opacity: 0; transform: scale(0.3) rotate(0deg); }
    45% { opacity: calc(var(--amp) * 0.75); transform: scale(0.85) rotate(45deg); }
    70% { opacity: calc(var(--amp) * 0.3); transform: scale(0.6) rotate(80deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .mark-link .ml, .mark-link .mark-sub, .tw, .halo { animation: none; }
  }

  .mark-link:focus-visible { outline: 1px solid var(--accent); outline-offset: 14px; }

  /* 数字下面那行小字：桌面端不需要 —— 鼠标移上去会变色变大，已经说清楚了。
     触屏没有 hover，这个入口就完全没人知道，所以在手机上让它
     进来之后轻声说一句再消失：淡入、停三秒、淡出，之后画面回到干净。 */
  .mark-hint {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2.2em;
    font-family: var(--hero-serif);
    font-style: italic;
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.12em;
    line-height: 1;
    color: #8a7370;
    opacity: 0;
    pointer-events: none;
  }

  @media (hover: none) and (prefers-reduced-motion: no-preference) {
    .mark-hint {
      animation: whisper 6.4s cubic-bezier(0.4, 0, 0.2, 1) 1.6s forwards;
    }
  }

  @keyframes whisper {
    0% { opacity: 0; transform: translateY(7px); }
    14% { opacity: 1; transform: none; }
    62% { opacity: 1; transform: none; }
    100% { opacity: 0; transform: translateY(-5px); }
  }

  /* 所有拼贴元素共用：真实投影，跟着裁剪的轮廓走 */
  .el {
    position: absolute;
    height: auto;
    filter: drop-shadow(0 1.4vmin 2.4vmin rgba(118, 94, 90, 0.26));
    transform: translate3d(var(--tx, 0px), var(--ty, 0px), 0)
      rotate(calc(var(--rot, 0deg) + var(--rw, 0deg))) scale(var(--sc, 1));
    will-change: transform;
  }

  /* 进场：轻轻浮上来，错开时间 */
  @media (prefers-reduced-motion: no-preference) {
    .el,
    .mark {
      opacity: 0;
      animation: rise 1.1s cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
      animation-delay: calc(var(--i, 0) * 45ms);
    }
  }

  @keyframes rise {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  /* 右上一堆，切出画面 */
  .caladium { top: 6%; right: -4%; width: 29.6vmin; --rot: 13deg; z-index: 4; }
  .paleflower2 { top: 17%; left: 19%; width: 9.3vmin; --rot: 12deg; z-index: 3; }
  .paleflower { top: 18%; right: 11%; width: 12.8vmin; --rot: -8deg; z-index: 5; }
  .uranus { top: 27%; right: 6%; width: 7.4vmin; z-index: 4; }
  .nautilus2 { top: 39%; right: 3%; width: 5.6vmin; --rot: -24deg; z-index: 4; }

  /* 左上，月牙搭在第一个 0 的肩上 */
  .star { top: 10%; left: 14%; width: 12.2vmin; --rot: -10deg; z-index: 3; }
  .moon { top: 24%; left: 25%; width: 14.4vmin; --rot: -19deg; z-index: 5; }
  .blueflower { top: 33%; left: 12%; width: 9.9vmin; --rot: 16deg; z-index: 4; }
  .nightflower { top: 45%; left: 4%; width: 8.0vmin; --rot: -14deg; z-index: 3; }

  /* 鹦鹉螺嵌进 5 里 */
  .nautilus { top: 75%; left: 45%; width: 8.0vmin; --rot: 18deg; z-index: 6; }

  /* 左下，压住数字下缘的一堆 */
  .dagger { top: 19%; left: 68%; width: 26.4vmin; --rot: 104deg; z-index: 5; }
  .lilypad { top: 60%; left: 19%; width: 20.0vmin; --rot: 9deg; z-index: 4; }
  .lotus { top: 52%; left: 7%; width: 28.0vmin; --rot: -6deg; z-index: 5; }
  .lilypad2 { top: 70%; left: 84%; width: 13.8vmin; --rot: -11deg; z-index: 3; }
  .starfish { top: 70%; left: 2%; width: 12.0vmin; --rot: 20deg; z-index: 4; }
  .begonia { top: 75%; left: 28%; width: 13.6vmin; --rot: -16deg; z-index: 3; }

  /* 右下，小天使守着 2 */
  .cherub { top: 60%; left: 74%; width: 20.0vmin; --rot: -13deg; z-index: 5; }
  .planet { top: 63%; left: 87%; width: 6.4vmin; z-index: 4; }
  .moon2 { top: 43%; left: 86%; width: 7.4vmin; --rot: 26deg; z-index: 3; }
  .orchid { top: 76%; left: 60%; width: 10.4vmin; --rot: 10deg; z-index: 4; }
  .moonlet { top: 84%; left: 66%; width: 4.8vmin; z-index: 3; }

  /* 蝴蝶：一只停在叶尖，一只从剑尖那头飞出去 */
  .butterflyGreen { top: 10%; left: 71%; width: 13.2vmin; --rot: -16deg; z-index: 5; }

  /* 上下两条 */
  .topbar,
  .bottombar {
    position: absolute;
    left: clamp(20px, 3.4vw, 48px);
    right: clamp(20px, 3.4vw, 48px);
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    z-index: 8;
  }

  .topbar { top: 30px; }
  .bottombar { bottom: 40px; align-items: flex-end; }

  .topbar nav {
    display: flex;
    gap: clamp(16px, 2.4vw, 34px);
    font-family: var(--hero-serif);
    font-size: clamp(14px, 1.15vw, 17px);
    letter-spacing: 0.06em;
    color: #5e4b47;
  }

  .topbar nav a:hover { color: var(--accent); }

  /* 底栏：一句话说清这是什么。从 IG 点进来的人只看这一眼 */
  .tagline {
    margin: 0;
    font-family: var(--hero-serif);
    font-size: clamp(12px, 1.05vw, 15px);
    font-style: italic;
    letter-spacing: 0.08em;
    color: #5e4b47;
  }

  /* 左上角：这里是干什么的 */
  .intro {
    margin: 0;
    font-family: var(--hero-serif);
    font-size: clamp(14px, 1.15vw, 17px);
    font-style: italic;
    letter-spacing: 0.04em;
    color: #5e4b47;
  }

  .intro-m { display: none; }

  /* 点店名 / 导航跳下来时，标题上方留一点空，不要贴着屏幕顶 */
  .below section[id] { scroll-margin-top: 48px; }

  .intro:lang(zh),
  .mark-hint:lang(zh) {
    font-style: normal;
    letter-spacing: 0.14em;
  }

  .tagline { text-align: right; }
  .tagline:lang(zh) {
    font-family: var(--cjk);
    font-style: normal;
    letter-spacing: 0.16em;
  }

  /* 下方区块：进入视口时浮起 */
  .block {
    opacity: 0;
    transform: translateY(26px);
    transition: opacity 0.9s cubic-bezier(0.22, 0.61, 0.36, 1),
      transform 0.9s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .block.in { opacity: 1; transform: none; }

  @media (prefers-reduced-motion: reduce) {
    .block { opacity: 1; transform: none; transition: none; }
  }

  /* ── 手机：只留八个元素，重新摆位 ───────────── */
  @media (max-width: 780px) {
    .mark { top: 23%; font-size: 21vw; }
    .mark-sub { font-size: 9.6vw; }

    .el { filter: drop-shadow(0 3vw 5vw rgba(118, 94, 90, 0.24)); }

    .paleflower2, .paleflower, .nightflower, .star, .nautilus2,
    .lilypad2, .begonia, .orchid, .moon2,
    .moonlet, .planet {
      display: none;
    }

    .butterflyGreen { top: 9%; left: 56%; width: 25vw; }

    .caladium { top: 4%; right: -24%; width: 44vw; }
    .moon { top: 37%; left: -6%; width: 22vw; }
    .blueflower { top: 51%; left: 3%; width: 19vw; }
    .uranus { top: 49%; right: 6%; width: 13vw; }
    .nautilus { top: 36%; left: 79%; width: 14vw; }
    .dagger { top: 0%; left: -3%; width: 25vw; }
    /* 底下这一堆往上收一点、小一点 —— 给最下面那排感觉词留出干净的丝缎，
       不然在窄屏上字会压在莲花和小天使身上，看不清 */
    .lilypad { top: 69%; left: 34%; width: 25vw; }
    .lotus { top: 63%; left: -12%; width: 48vw; }
    .cherub { top: 67%; left: 60%; width: 31vw; }

    .topbar { top: 20px; flex-direction: column-reverse; align-items: flex-start; gap: 8px; }
    /* 手机：左上角让给导航（剑也在那儿），这句话挪到右下角，
       顶替底栏那行 tagline —— 位置一样醒目，不和拼贴打架 */
    .topbar .intro, .tagline { display: none; }
    .intro-m { display: block; font-size: 13px; line-height: 1.5; text-align: right; max-width: 16.5em; }
    .intro-m:lang(zh) { letter-spacing: 0.06em; }
    .bottombar { bottom: 26px; }

    .tagline { font-size: 12px; line-height: 1.7; text-align: right; }
  }

  /* ── 第一屏之下：一块从下方升起、盖住第一屏的面板 ── */
  .below {
    position: relative;
    z-index: 5;
    background: var(--ground);
    border-radius: 30px 30px 0 0;
    box-shadow: 0 -26px 64px rgba(96, 74, 72, 0.18);
    padding-top: 76px;
    padding-bottom: 40px;
  }

  .block { margin-top: 96px; }
  .block:first-child { margin-top: 0; }

  .block-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 18px;
  }

  .more:hover { color: var(--accent); }

  .latest { display: block; margin-top: 36px; }

  .latest img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .latest-meta {
    display: flex;
    align-items: baseline;
    gap: 20px;
    flex-wrap: wrap;
    margin-top: 20px;
  }

  .latest-meta h2 {
    margin: 0;
    font-family: var(--cjk);
    font-size: 21px;
    font-weight: 400;
    letter-spacing: 0.08em;
  }

  .place { margin: 0; font-size: 13px; color: var(--ink-soft); letter-spacing: 0.08em; }
  .count { margin: 0; margin-left: auto; }
  .latest:hover h2 { color: var(--accent); }

  .essay-list { list-style: none; margin: 0; padding: 0; }
  .essay-list li { border-bottom: 1px solid var(--rule); }

  .essay-list a {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: 24px;
    align-items: baseline;
    padding-block: 26px;
  }

  .essay-list h3 {
    margin: 0;
    font-family: var(--cjk);
    font-size: 19px;
    font-weight: 400;
    letter-spacing: 0.06em;
  }

  .essay-list .summary {
    grid-column: 2;
    margin: 8px 0 0;
    font-family: var(--cjk);
    font-size: 14px;
    font-weight: 300;
    line-height: 1.9;
    color: var(--ink-soft);
    max-width: 44em;
  }

  .essay-list a:hover h3 { color: var(--accent); }

  @media (max-width: 640px) {
    .block { margin-top: 80px; }
    .essay-list a { grid-template-columns: 1fr; gap: 6px; }
    .essay-list .summary { grid-column: 1; }
  }

  /* ── 下方各节 ─────────────────────────────────────────
     英文正文用 Karla（宋体的西文很难看），行长控制在 34em 以内。
     每一节都是：小标 → 细线 → 内容，节奏统一。 */
  .kicker {
    margin: 0 0 14px;
    color: var(--accent);
  }

  .two {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr);
    gap: clamp(22px, 5vw, 80px);
    align-items: start;
    padding-top: clamp(18px, 2.4vw, 32px);
  }

  .cjk-title {
    margin: 0;
    font-family: var(--cjk);
    font-size: clamp(34px, 5.6vw, 76px);
    font-weight: 400;
    letter-spacing: 0.1em;
    line-height: 1.2;
    color: var(--ink);
  }

  .stance {
    margin: 0;
    font-family: var(--didot);
    font-size: clamp(23px, 3vw, 40px);
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: 0.005em;
    color: var(--ink);
    text-wrap: balance;
  }

  .prose-t {
    max-width: 34em;
    font-family: var(--sans);
    font-size: clamp(15px, 1.15vw, 17px);
    line-height: 1.85;
    color: var(--ink-soft);
  }

  .prose-t p { margin: 0 0 1.25em; }
  .prose-t p:last-child { margin-bottom: 0; }

  /* ── 关于我 ─────────────────────────────────────────── */
  .about-title { font-family: var(--didot); letter-spacing: -0.01em; }

  .cjk-title.where {
    font-family: var(--didot);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1.05;
  }

  .tags {
    list-style: none;
    margin: 0 0 22px;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 4px;
  }

  /* 标签：不加框，直接列出来，中间用小星星隔开 */
  .tags li {
    display: inline-flex;
    align-items: center;
    font-family: var(--hero-serif);
    font-size: clamp(15px, 1.3vw, 18px);
    font-style: italic;
    letter-spacing: 0.03em;
    color: var(--ink);
  }

  .tags li + li::before {
    content: '✦';
    margin: 0 14px 0 4px;
    font-size: 9px;
    font-style: normal;
    color: #c4923c;
  }

  .motto {
    margin: 26px 0 0;
    font-family: var(--didot);
    font-style: italic;
    font-size: clamp(22px, 2.4vw, 32px);
    line-height: 1.35;
    color: #7a5246;
  }

  /* ── 占卜服务须知：四条，两列 ─────────────────────────── */
  .how-title { padding-top: clamp(18px, 2.4vw, 32px); max-width: 22em; }

  .rules {
    list-style: none;
    margin: clamp(26px, 3.4vw, 46px) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(26px, 3.6vw, 52px) clamp(28px, 5vw, 80px);
  }

  .rules li { position: relative; padding-top: 18px; border-top: 1px solid var(--rule); }

  .rules-n {
    display: block;
    margin-bottom: 10px;
    font-family: var(--sans);
    font-size: 11px;
    letter-spacing: 0.24em;
    color: var(--accent);
  }

  .rules h3 {
    margin: 0 0 12px;
    font-family: var(--didot);
    font-size: clamp(20px, 1.9vw, 25px);
    font-weight: 500;
    letter-spacing: 0;
    color: var(--ink);
  }

  .rules p {
    margin: 0 0 0.9em;
    font-family: var(--sans);
    font-size: 14.5px;
    line-height: 1.85;
    color: var(--ink-soft);
  }

  .rules p:last-child { margin-bottom: 0; }

  /* ── 解读项目：可以展开的两张卡 ──────────────────────── */
  .svcs { list-style: none; margin: clamp(18px, 2.4vw, 30px) 0 0; padding: 0; display: grid; gap: 16px; }

  .svc {
    border: 1px solid rgba(78, 57, 51, 0.16);
    border-radius: 22px;
    background: linear-gradient(180deg, rgba(255, 252, 247, 0.78), rgba(250, 243, 236, 0.55));
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.6) inset, 0 18px 40px -28px rgba(96, 60, 48, 0.35);
    transition: box-shadow 0.4s ease, border-color 0.4s ease;
    overflow: hidden;
  }

  .svc:hover, .svc.is-open { border-color: rgba(78, 57, 51, 0.28); box-shadow: 0 1px 0 rgba(255,255,255,.6) inset, 0 26px 50px -30px rgba(96, 60, 48, 0.45); }

  .svc-head {
    all: unset;
    box-sizing: border-box;
    width: 100%;
    cursor: pointer;
    display: grid;
    grid-template-columns: clamp(42px, 5vw, 76px) minmax(0, 1fr) auto;
    grid-template-areas: 'n title meta' 'n toggle toggle';
    gap: 14px clamp(14px, 2.6vw, 40px);
    align-items: baseline;
    padding: clamp(22px, 2.6vw, 34px) clamp(20px, 2.8vw, 40px);
  }

  .svc-head:focus-visible { outline: 1px solid var(--accent); outline-offset: -6px; border-radius: 22px; }

  .svc-head .rn { grid-area: n; font-family: var(--didot); color: #c9b6a6; }
  .svc-title { grid-area: title; }
  .svc-head .rmeta { grid-area: meta; }

  .svc-head h3 {
    margin: 0;
    font-family: var(--didot);
    font-size: clamp(24px, 2.6vw, 36px);
    font-weight: 450;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .svc-note {
    display: block;
    margin-top: 8px;
    max-width: 36em;
    font-family: var(--sans);
    font-size: 14.5px;
    line-height: 1.75;
    color: var(--ink-soft);
  }

  .rmeta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 7px;
    text-align: right;
    white-space: nowrap;
  }

  .rprice {
    font-family: var(--didot);
    font-style: italic;
    font-size: clamp(17px, 1.6vw, 21px);
    color: var(--accent);
  }

  .svc-toggle {
    grid-area: toggle;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    justify-self: start;
    font-family: var(--hero-serif);
    font-style: italic;
    font-size: 15px;
    letter-spacing: 0.03em;
    color: #7a5246;
  }

  .svc-toggle-t { border-bottom: 1px solid rgba(122, 82, 70, 0.35); padding-bottom: 1px; }

  /* 加号 → 减号 */
  .plus {
    position: relative;
    width: 26px;
    height: 26px;
    border: 1px solid rgba(122, 82, 70, 0.45);
    border-radius: 50%;
    transition: transform 0.5s cubic-bezier(0.22, 0.61, 0.36, 1), background 0.3s;
  }

  .plus::before, .plus::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 10px;
    height: 1px;
    background: currentColor;
