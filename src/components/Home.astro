---
import { Image, Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import LangToggle from './LangToggle.astro';
import Book from './Book.astro';
import TarotCard from './TarotCard.astro';
import WeChatSheet from './WeChatSheet.astro';
import { T, url, pageMeta, doors, hl } from '../lib/site.js';

const { lang = 'en' } = Astro.props;

import satin from '../assets/collage/satin.jpg';
import caladium from '../assets/collage/caladium.png';
import paleflower2 from '../assets/collage/paleflower2.png';
import nautilus from '../assets/collage/nautilus.png';
import star from '../assets/collage/star.png';
import moon from '../assets/collage/moon.png';
import moon2 from '../assets/collage/moon2.png';
import blueflower from '../assets/collage/blueflower.png';
import nightflower from '../assets/collage/nightflower.png';
import dagger from '../assets/collage/dagger.png';
import lilypad from '../assets/collage/lilypad.png';
import lilypad2 from '../assets/collage/lilypad2.png';
import lotus from '../assets/collage/lotus.png';
import begonia from '../assets/collage/begonia.png';
import starfish from '../assets/collage/starfish.png';
import cherub from '../assets/collage/cherub.png';
import planet from '../assets/collage/planet.png';
import moonlet from '../assets/collage/moonlet.png';
import nautilus2 from '../assets/collage/nautilus2.png';
import butterflyGreen from '../assets/collage/butterfly-green.png';
// 三张塔罗牌牌面上的画
// 下拉页上零星的拼贴：一页旧信、一只瓢虫、一朵蓝花、一颗海星
import ladybug from '../assets/collage/ladybug.png';
// 信封两边的拼贴
import zLetter from '../assets/zen/letter-big.png';
import zSun from '../assets/zen/sunflower.png';
import zStars2 from '../assets/zen/stars-gold2.png';
// zen 拼贴（Vicky 找的素材，抠了底）
import zBuddha from '../assets/zen/buddha-white.png';
import zLily from '../assets/zen/lily-pink.png';
import zOrchid from '../assets/zen/orchid-green.png';
import zPearl from '../assets/zen/pearl.png';
import zHand from '../assets/zen/hand-spiral.png';

// 首屏的拼贴元素。位置在下面的 CSS 里，这里只定义层次：
// depth 决定视差幅度（越「近」动得越多），ph 是漂浮的相位差
const pieces = [

  { k: 'caladium', src: caladium, alt: '粉脉彩叶芋', d: 1.0, ph: 0.0 },
  { k: 'paleflower2', src: paleflower2, alt: '淡蓝色花', d: 0.35, ph: 1.7 },
  { k: 'nautilus2', src: nautilus2, alt: '鹦鹉螺壳', d: 0.3, ph: 1.1 },
  { k: 'star', src: star, alt: '金色星芒', d: 0.85, ph: 2.2 },
  { k: 'moon', src: moon, alt: '金色月牙', d: 0.7, ph: 0.8 },
  { k: 'blueflower', src: blueflower, alt: '蓝色花', d: 0.55, ph: 3.4 },
  { k: 'nightflower', src: nightflower, alt: '深蓝色花', d: 0.5, ph: 1.5 },
  { k: 'nautilus', src: nautilus, alt: '鹦鹉螺壳', d: 0.4, ph: 2.6 },
  { k: 'dagger', src: dagger, alt: '匕首', d: 0.95, ph: 0.3 },
  { k: 'lilypad', src: lilypad, alt: '荷叶', d: 0.8, ph: 1.9 },
  { k: 'lilypad2', src: lilypad2, alt: '荷叶', d: 0.6, ph: 3.1 },
  { k: 'lotus', src: lotus, alt: '粉色睡莲', d: 1.0, ph: 0.6 },
  { k: 'begonia', src: begonia, alt: '螺旋秋海棠叶', d: 0.6, ph: 2.4 },
  { k: 'starfish', src: starfish, alt: '海星', d: 0.6, ph: 1.3 },
  { k: 'cherub', src: cherub, alt: '金色小天使', d: 0.9, ph: 2.0 },
  { k: 'planet', src: planet, alt: '蓝色星球', d: 0.3, ph: 3.6 },
  { k: 'moon2', src: moon2, alt: '金色月牙', d: 0.35, ph: 1.2 },
  { k: 'moonlet', src: moonlet, alt: '月亮', d: 0.25, ph: 2.8 },
  { k: 'butterflyGreen', src: butterflyGreen, alt: '绿色凤蝶', d: 0.75, ph: 2.3 },
];

const { site, nameStory } = T[lang];
const myDoors = doors[lang];
const pm = pageMeta[lang];
// 首页右上角：三个内容页 + 预约（「这个空间」从店名进）
const nav = ['about', 'guide', 'readings'].map((k) => ({ href: url(lang, k), label: pm[k].nav }));
---

<Base bare wide sheen lang={lang} alt="/" title={`The Open Space ${site.cjk}`} description={site.tagline}>
  <section class="hero">
    <Picture
      src={satin}
      formats={['avif', 'webp']}
      widths={[800, 1400, 2000]}
      sizes="100vw"
      alt=""
      loading="eager"
      class="ground"
    />

    <div class="stage">
      <div class="mark-wrap">
        <h1 class="mark">
          <!-- 店名本身就是入口：点一下滑到下面「这个空间」 -->
          <a class="mark-link" href="#space">
            <span class="ml" style="--i:0">The </span>
            <span class="ml ml-open" style="--i:1">Open </span>
            <span class="ml" style="--i:2">Space </span>
            <span class="mark-sub" style="--i:3"><span class="cjk-name">{site.cjk}</span> <span class="vicky">with Vicky</span></span>
            <!-- 鼠标移上去：一圈柔光 + 星星一颗颗亮起来 -->
            <span class="halo" aria-hidden="true"></span>
            {[
              [6, 10, 0.0, 22], [88, 4, 0.6, 28], [100, 36, 1.3, 16], [-2, 44, 0.9, 18],
              [80, 56, 0.3, 24], [12, 72, 1.6, 14], [94, 80, 1.0, 20], [48, -6, 1.9, 16],
              [28, 28, 2.3, 12], [66, 20, 2.7, 13], [56, 98, 0.5, 18], [-8, 90, 2.1, 13],
              [38, 52, 1.1, 10], [72, 40, 2.0, 11], [20, 100, 2.9, 15], [104, 64, 1.7, 12],
            ].map(([x, y, d, z]) => (
              <span class="tw" aria-hidden="true" style={`left:${x}%;top:${y}%;--d:${d}s;--z:${Math.round(z * 0.6)}px`}>✦</span>
            ))}
          </a>
          <span class="mark-hint" aria-hidden="true">{site.hint}</span>
        </h1>
      </div>
      {
        pieces.map((p, i) => (
          <Image
            src={p.src}
            alt={p.alt}
            format="webp"
            quality={80}
            class={`el ${p.k}`}
            loading="eager"
            data-d={p.d}
            data-ph={p.ph}
            style={`--i:${i}`}
          />
        ))
      }
    </div>

    <div class="topbar">
      <p class="intro">{site.intro}</p>
      <nav aria-label="Sections">
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        <span class="lt-wrap"><LangToggle lang={lang} href={url(lang === 'en' ? 'zh' : 'en')} /></span>
      </nav>
    </div>

    <div class="bottombar">
      <span class="spacer"></span>
      <p class="intro intro-m">{site.intro}</p>
    </div>
  </section>

  <!-- 往下拉：一块升起来的面板，只讲「这里是什么地方」，然后是三扇门 -->
  <div class="below">
    <!-- 零星的拼贴：和首屏是一路的，但只放几样，压在角落里 -->
    <Image src={zBuddha} alt="" width={480} format="webp" quality={82} class="bits bit-buddha" aria-hidden="true" />
    <Image src={zLily} alt="" width={340} format="webp" quality={82} class="bits bit-lily" aria-hidden="true" />
    <Image src={zHand} alt="" width={260} format="webp" quality={82} class="bits bit-hand" aria-hidden="true" />
    <section class="wrap block" id="space">
      <p class="kicker label">The Open Space · 自留地</p>
      <hr class="rule" />
      <div class="two">
        <h2 class={`space-title ${lang === 'en' ? 'is-en' : ''}`}>{lang === 'en' ? 'What is this place?' : '自留地'}</h2>
        <div class="prose-t">
          {nameStory.body.map((t) => <p set:html={hl(t)} />)}
        </div>
      </div>
    </section>

    <section class="wrap block doors" aria-label={lang === 'en' ? 'Pages' : '页面'}>
      <ul class="door-list">
        <Image src={zOrchid} alt="" width={300} format="webp" quality={82} class="bits bit-orchid" aria-hidden="true" />
        {myDoors.map((d, i) => (
          <li style={`--k:${i}`}>
            <a class="door" href={url(lang, d.key)} data-portal>
              <!-- 发牌：先扣着叠成一摞（星星牌背），滚到这里时铺开，再一张张翻过来 -->
              <span class="deal">
                <span class="deal-in">
                  <TarotCard k={i} title={pageMeta[lang][d.key].title} />
                  <span class="deal-back" aria-hidden="true"></span>
                </span>
              </span>
              {i === 0 && <Image src={ladybug} alt="" width={80} format="webp" quality={85} class="bits bit-ladybug" aria-hidden="true" />}
              <span class="door-b">{d.line}</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="door-book">
        <Image src={zPearl} alt="" width={140} format="webp" quality={85} class="bits bit-pearl" aria-hidden="true" />
        <Image src={zLetter} alt="" width={420} format="webp" quality={82} class="bits bit-letter" aria-hidden="true" />
        <Image src={zSun} alt="" width={320} format="webp" quality={84} class="bits bit-sun" aria-hidden="true" />
        <Image src={zStars2} alt="" width={120} format="webp" quality={84} class="bits bit-stars2" aria-hidden="true" />
        <Book lang={lang} variant="cta" />
      </div>
    </section>
  </div>



  {lang === 'zh' && <WeChatSheet />}
</Base>

<script>
  // ── 拉一下，下拉页就自己滑上来；在下拉页顶上往回拉一下，就弹回首屏 ──
  {
    const below = document.querySelector('.below');
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const root = document.documentElement;
    let busy = false;
    let quietUntil = 0;

    // 停在这里：下拉页的上沿正好到屏幕顶，首屏被盖住
    const target = () => Math.max(0, Math.round(below.getBoundingClientRect().top + scrollY));

    // 往上滑：带一点点回弹（冲过头一丁点再落回去）
    const easeUp = (t) => {
      const c = 0.9;
      return 1 + (c + 1) * Math.pow(t - 1, 3) + c * Math.pow(t - 1, 2);
    };
    const easeBack = (t) => 1 - Math.pow(1 - t, 4);

    const glide = (to) => {
      if (busy) return;
      const from = scrollY;
      if (Math.abs(to - from) < 2) return;
      if (still) { scrollTo(0, to); return; }
      busy = true;
      root.style.scrollBehavior = 'auto';
      const down = to > from;
      const t0 = performance.now();
      const dur = down ? 950 : 800;
      const step = (now) => {
        const t = Math.min((now - t0) / dur, 1);
        scrollTo(0, from + (to - from) * (down ? easeUp(t) : easeBack(t)));
        if (t < 1) requestAnimationFrame(step);
        else {
          busy = false;
          root.style.scrollBehavior = '';
          quietUntil = performance.now() + 650;   // 吃掉触控板的惯性，不要接着又滚
        }
      };
      requestAnimationFrame(step);
    };

    // 在首屏里往下 → 滑到下拉页；在下拉页最顶上往上 → 回首屏
    const decide = (dir) => {
      const T = target();
      const y = scrollY;
      if (dir > 0 && y < T - 4) { glide(T); return true; }
      if (dir < 0 && y > 4 && y <= T + 6) { glide(0); return true; }
      return false;
    };

    addEventListener('wheel', (e) => {
      if (e.ctrlKey) return;                         // 双指缩放不管
      if (busy || performance.now() < quietUntil) {
        if (scrollY <= target() + 6) { e.preventDefault(); return; }
      }
      if (Math.abs(e.deltaY) < 2) return;
      if (decide(Math.sign(e.deltaY))) e.preventDefault();
    }, { passive: false });

    // 手机：手指一划就决定方向
    let sy = 0, handled = false;
    addEventListener('touchstart', (e) => { sy = e.touches[0].clientY; handled = false; }, { passive: true });
    addEventListener('touchmove', (e) => {
      const T = target();
      const dy = sy - e.touches[0].clientY;          // >0：手指往上划，页面往下走
      const inZone = scrollY < T - 4 || (dy < 0 && scrollY <= T + 6);
      if (!inZone) return;
      if (busy) { e.preventDefault(); return; }
      if (!handled && Math.abs(dy) > 14) handled = decide(Math.sign(dy));
      if (handled) e.preventDefault();
    }, { passive: false });

    // 点店名（#space）也用同一个滑法
    document.querySelectorAll('a[href="#space"]').forEach((a) => a.addEventListener('click', (e) => {
      e.preventDefault();
      glide(target());
    }));

    // 从内容页点「这个空间」带着 #space 进来：直接停在下拉页
    if (location.hash === '#space') requestAnimationFrame(() => scrollTo(0, target()));
  }

  // ── 发牌：三张牌先扣着叠在一起，滚到它们时铺开、再一张张翻过来 ──
  {
    const doorsEl = document.querySelector('.doors');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (doorsEl && !reduce && 'IntersectionObserver' in window) {
      doorsEl.classList.add('will-deal');
      const io = new IntersectionObserver((es) => {
        if (es.some((e) => e.isIntersecting)) {
          setTimeout(() => doorsEl.classList.add('is-dealt'), 120);
          io.disconnect();
        }
      }, { threshold: 0.45 });
      io.observe(doorsEl.querySelector('.door-list'));
    }
  }

  // ── 点一张牌：牌被抽起来，然后朝你放大、冲出屏幕，背景淡成米色，接着进内容页 ──
  // 内容页从米色里浮出来（见 Page.astro 的 portal-enter）。动画在页面里自己做，不依赖浏览器支持。
  {
    // 提前把三个内容页抓下来，点的时候基本不用等
    document.querySelectorAll('a[data-portal]').forEach((a) => {
      const l = document.createElement('link');
      l.rel = 'prefetch';
      l.href = a.href;
      document.head.appendChild(l);
    });

    document.querySelectorAll('a[data-portal]').forEach((a) => {
      a.addEventListener('click', (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
        const card = a.querySelector('.card');
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!card || reduce || !Element.prototype.animate) return;
        e.preventDefault();

        const r = card.getBoundingClientRect();
        const W = innerWidth, H = innerHeight;
        const DUR = 1000;
        const ease = 'cubic-bezier(0.7, 0, 0.2, 1)';
        const lift = 18;

        // 一层米色，慢慢盖住整个页面（内容页也是从这个米色里出来）
        const veil = document.createElement('div');
        veil.className = 'portal-veil';
        // 一张一模一样的牌，摆在原来的位置上
        const face = card.cloneNode(true);
        face.classList.add('portal-face');
        const cs = getComputedStyle(card);
        Object.assign(face.style, { left: `${r.left}px`, top: `${r.top}px`, width: `${r.width}px`, height: `${r.height}px`, padding: cs.padding });
        face.style.setProperty('--k', cs.getPropertyValue('--k') || '1');
        document.body.append(veil, face);
        card.style.visibility = 'hidden';

        // 放大到比屏幕还大一点，同时移到屏幕中间
        const S = Math.max(W / r.width, H / r.height) * 1.25;
        const dx = W / 2 - (r.left + r.width / 2);
        const dy = H / 2 - (r.top + r.height / 2);
        face.animate([
          { transform: 'translate(0, 0) scale(1)', opacity: 1, offset: 0 },
          { transform: `translate(0, ${-lift}px) scale(1.06)`, opacity: 1, offset: 0.22, easing: ease },
          { transform: `translate(${dx}px, ${dy}px) scale(${S})`, opacity: 0, offset: 1 },
        ], { duration: DUR, fill: 'forwards' });

        veil.animate([{ opacity: 0 }, { opacity: 0 }, { opacity: 1 }], { duration: DUR, easing: 'ease-in', fill: 'forwards' });

        setTimeout(() => {
          try { sessionStorage.setItem('portal', '1'); } catch (_) {}
          location.href = a.href;
        }, DUR - 30);
      });
    });

    // 按返回键回来（页面从缓存里恢复）：把一切还原
    addEventListener('pageshow', () => {
      document.querySelectorAll('.portal-face, .portal-veil').forEach((o) => o.remove());
      document.querySelectorAll('.card').forEach((c) => (c.style.visibility = ''));
    });
  }

  // 滚过首屏以后给 html 加个标记（左下角徽章用它垫底色）
  const markPast = () => document.documentElement.classList.toggle('past-hero', scrollY > innerHeight * 0.75);
  addEventListener('scroll', markPast, { passive: true });
  markPast();

  // 下方区块进入视口时浮起
  {
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const blocks = document.querySelectorAll('.block');
    if (still || !('IntersectionObserver' in window)) blocks.forEach((b) => b.classList.add('in'));
    else {
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -10% 0px' });
      blocks.forEach((b) => io.observe(b));
    }
  }

  // 丝缎的动感：滚动视差 + 极慢的漂浮。
  // 两者都只改 transform，合成一个 rAF 循环，不触发重排。
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const stage = document.querySelector('.stage');
  const mark = document.querySelector('.mark');
  const markWrap = document.querySelector('.mark-wrap');
  const ground = document.querySelector('.ground');

  if (stage && !reduce) {
    const els = [...stage.querySelectorAll('.el')].map((el) => ({
      el,
      d: parseFloat(el.dataset.d || '0.5'),
      ph: parseFloat(el.dataset.ph || '0'),
      // 被涟漪推开之后的偏移、速度、以及一点点转动和缩放
      ox: 0, oy: 0, vx: 0, vy: 0, rw: 0, rv: 0, pop: 0, cool: 0,
      cx: 0, cy: 0, hw: 0,
    }));

    // 元素在屏幕上的中心。第一屏是 sticky 的，钉住的时候它的顶就是屏幕的顶，
    // 所以用 offsetLeft/offsetTop 就够了，不用每帧去问浏览器要位置（那会很卡）。
    const measure = () => {
      for (const o of els) {
        o.cx = o.el.offsetLeft + o.el.offsetWidth / 2;
        o.cy = o.el.offsetTop + o.el.offsetHeight / 2;
        o.hw = Math.max(o.el.offsetWidth, o.el.offsetHeight) * 0.5;
      }
    };
    measure();
    window.addEventListener('resize', measure);
    window.addEventListener('load', measure);

    // ── 涟漪碰到元素 ─────────────────────────────────
    // Base.astro 里每落下一圈涟漪就发一个事件。这里记下来，
    // 每帧算这一圈现在扩到多大，扩到谁身上，就把谁往外推一下。
    const waves = [];

    window.addEventListener('sheen:ripple', (e) => {
      const { x, y, reach, life } = e.detail;
      if (waves.length > 14) waves.shift();
      waves.push({ x, y, reach, life, t: 0, hit: new Set() });
    });

    let sy = 0;
    let ticking = false;
    const onScroll = () => {
      sy = window.scrollY;
      if (!ticking) { ticking = true; requestAnimationFrame(() => { ticking = false; }); }
    };
    window.addEventListener('scroll', onScroll, { passive: true });

    const hero = document.querySelector('.hero');

    let prev = performance.now();

    const loop = (now) => {
      const t = now * 0.001;
      const dt = Math.min((now - prev) / 1000, 0.05);
      prev = now;
      // 第一屏滚出视野之后就不再计算
      const heroH = hero ? hero.offsetHeight : window.innerHeight;
      const active = sy < heroH + 240;
      if (active) {
        // 第一屏被钉住，用「滚过了多少」当进度，位移才不会飞出去
        const prog = Math.min(sy / heroH, 1);
        // 缓入缓出，让退后的过程不是线性的，更像呼气
        const ease = prog * prog * (3 - 2 * prog);

        // 先让每一圈涟漪长大，看它这一帧扫过了谁
        const heroTop = hero ? Math.max(0, heroH - sy) : 0;   // 第一屏还剩多少在屏幕上
        for (let i = waves.length - 1; i >= 0; i--) {
          const wv = waves[i];
          wv.t += dt;
          const wp = wv.t / wv.life;
          if (wp >= 1) { waves.splice(i, 1); continue; }
          const wr = 8 + wv.reach * (1 - Math.pow(1 - wp, 2.4));
          const strength = Math.pow(1 - wp, 1.4);
          if (strength < 0.08) continue;

          for (let j = 0; j < els.length; j++) {
            const o = els[j];
            if (wv.hit.has(j) || o.cool > 0) continue;   // 刚被碰过就先歇一下，免得一串圈把它顶飞
            // 元素中心在屏幕上的位置：sticky 的时候等于 offset，滚出去之后跟着上移
            const ex = o.cx;
            const ey = o.cy - (heroH - heroTop);
            const dx = ex - wv.x;
            const dy = ey - wv.y;
            const dist = Math.hypot(dx, dy) || 0.001;
            // 圈边扫到元素的轮廓范围内，就算「碰到」
            if (Math.abs(dist - wr) > o.hw * 0.72 + 26) continue;
            wv.hit.add(j);
            o.cool = 0.36;
            const push = (36 + 26 * o.d) * strength;
            o.vx += (dx / dist) * push;
            o.vy += (dy / dist) * push;
            o.rv += (dx > 0 ? 1 : -1) * 11 * strength * o.d;
            o.pop = Math.max(o.pop, 0.018 * strength);
          }
        }

        for (const o of els) {
          if (o.cool > 0) o.cool -= dt;
          // 漂浮：周期约 20 秒，幅度 8–24px
          const amp = 8 + o.d * 16;
          const fx = Math.sin(t * 0.3 + o.ph) * amp;
          const fy = Math.cos(t * 0.23 + o.ph) * amp * 0.75;
          // 视差：越「近」的元素随滚动上移越多
          const py = -prog * 220 * o.d;
          const px = Math.sin(o.ph) * prog * 26 * o.d;

          // 被推开之后往回弹：弹簧 + 阻尼，晃两下就停
          o.vx += (-o.ox * 26 - o.vx * 7.4) * dt;
          o.vy += (-o.oy * 26 - o.vy * 7.4) * dt;
          o.ox += o.vx * dt;
          o.oy += o.vy * dt;
          o.rv += (-o.rw * 20 - o.rv * 6.2) * dt;
          o.rw += o.rv * dt;
          o.pop *= Math.pow(0.3, dt);

          o.el.style.setProperty('--tx', (fx + px + o.ox).toFixed(2) + 'px');
          o.el.style.setProperty('--ty', (fy + py + o.oy).toFixed(2) + 'px');
          o.el.style.setProperty('--rw', o.rw.toFixed(2) + 'deg');
          // 一起往后退一点，越近的退得越多；被碰到的瞬间还会鼓一下
          o.el.style.setProperty('--sc', (1 - ease * 0.09 * o.d + o.pop).toFixed(4));
        }

        if (markWrap) {
          // 呼吸：周期约 10 秒，幅度 1.7% —— 静止时数字自己也在起伏
          const breath = Math.sin(t * 0.62) * 0.017;
          markWrap.style.setProperty('--msc', (1 - ease * 0.24 + breath).toFixed(4));
          // 透明度也跟着呼吸走一点，起伏才看得见而不只是「大小在变」
          markWrap.style.setProperty('--mop', (1 - ease * 0.72 + (breath - 0.017) * 1.6).toFixed(3));
        }
        if (mark) {
          // 除了随滚动上移，再叠一层 5px 的缓慢浮动
          const mb = Math.sin(t * 0.62 + 1.1) * 5;
          mark.style.setProperty('--mty', (-prog * 70 + mb).toFixed(2) + 'px');
        }

        if (ground) {
          // 丝缎随滚动推近，并叠一层周期约 31 秒、幅度 1.3% 的极慢呼吸。
          // 底数 1.022 是为了让呼吸缩到最小时仍然 > 1，不会露出边。
          const gb = Math.sin(t * 0.2) * 0.013;
          ground.style.setProperty('--gsc', (1.022 + ease * 0.11 + gb).toFixed(4));
        }
      }
      requestAnimationFrame(loop);
    };
    requestAnimationFrame(loop);
  }

